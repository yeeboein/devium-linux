# Keep only the 2 newest versions of each package in the cache (saves GBs over time).
[Trigger]
Operation = Upgrade
Operation = Install
Operation = Remove
Type = Package
Target = *

[Action]
Description = Cleaning old packages from the cache...
When = PostTransaction
Exec = /bin/sh -c 'command -v paccache >/dev/null && paccache -rqk2; exit 0'
