// Devium fastfetch for narrow windows: the same DEVIUM logo on top, the info underneath (picked automatically by /usr/local/bin/fastfetch).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/devium/fastfetch-logo.txt",
    "color": { "1": "38;2;184;206;228", "2": "38;2;150;178;208", "3": "38;2;122;146;176" },
    "position": "top",
    "padding": { "top": 1, "left": 1, "right": 0 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;150;178;208", "title": "38;2;180;184;224", "separator": "38;2;92;104;120" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS", "format": "{pretty-name}" },
    { "type": "command", "key": "Ver", "text": "sed -n 's/^DEVIUM_VERSION=//p' /etc/devium-release | sed 's/^beta/Beta/; s/^/Devium /'" },
    { "type": "kernel", "key": "Kernel", "format": "{release}" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Apps" },
    { "type": "de", "key": "Desktop" },
    { "type": "cpu", "key": "CPU", "format": "{name}" },
    { "type": "gpu", "key": "GPU", "format": "{name}" },
    { "type": "memory", "key": "RAM", "format": "{used} / {total}" },
    { "type": "disk", "key": "Disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery", "key": "Battery", "format": "{capacity}" },
    "break",
    "colors"
  ]
}
