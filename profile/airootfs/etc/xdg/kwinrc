# Light on old laptops: no blur/translucency, fast animations.
[Plugins]
blurEnabled=false
contrastEnabled=false
slidingpopupsEnabled=false
wobblywindowsEnabled=false

[Compositing]
LatencyPolicy=Low

[Windows]
BorderlessMaximizedWindows=false

# Devium: pastel macOS-style window buttons on the left
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__Devium
ButtonsOnLeft=XIA
ButtonsOnRight=
