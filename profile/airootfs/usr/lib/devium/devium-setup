#!/usr/bin/env bash
# Devium system setup.
#
#   devium-setup --live              while the ISO is built (pacman hook, inside the new system)
#   devium-setup --package           from the "devium-desktop" package's install script
#                                    (files are already in place): system settings + services
#   devium-setup --finish            after the installer made users and the bootloader:
#                                    boot menu branding, boot animation, user defaults
#   devium-setup --installed <dir>   copy Devium's files from a repo checkout, then --package
#                                    (Devium Updater uses this with DEVIUM_REFRESH=1)
#   devium-setup --os-release        (re)write /etc/os-release only
set -uo pipefail

say() { printf '==> devium-setup: %s\n' "$*"; }

write_os_release() {
    local version="rolling"
    [[ -r /etc/devium-release ]] && version="$(sed -n 's/^DEVIUM_VERSION=//p' /etc/devium-release)"
    rm -f /etc/os-release
    cat > /etc/os-release <<EOF
NAME="Devium"
PRETTY_NAME="Devium"
ID=devium
ID_LIKE=arch
BUILD_ID=${version:-rolling}
VERSION_ID=${version:-rolling}
ANSI_COLOR="38;2;150;178;208"
HOME_URL="https://github.com/yeeboein/devium-linux"
DOCUMENTATION_URL="https://wiki.archlinux.org/"
SUPPORT_URL="https://github.com/yeeboein/devium-linux/issues"
BUG_REPORT_URL="https://github.com/yeeboein/devium-linux/issues"
LOGO=devium
EOF
}

brand_bootloader() {
    # Boot menu entries created by archinstall say "Arch Linux": rename them to Devium.
    local f
    for f in /boot/loader/entries/*.conf /efi/loader/entries/*.conf; do
        [[ -f $f ]] && sed -i 's/Arch Linux/Devium/g' "$f"
    done
    if [[ -f /etc/default/grub ]]; then
        if grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub; then
            sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Devium"/' /etc/default/grub
        else
            echo 'GRUB_DISTRIBUTOR="Devium"' >> /etc/default/grub
        fi
    fi
    # Animated boot screen: plymouth hook + "quiet splash".
    if [[ -f /etc/mkinitcpio.conf ]] && ! grep -q '^HOOKS=.*plymouth' /etc/mkinitcpio.conf; then
        sed -i -E '/^HOOKS=/ { /plymouth/! s/(udev|systemd)/\1 plymouth/ }' /etc/mkinitcpio.conf
    fi
    for f in /boot/loader/entries/*.conf /efi/loader/entries/*.conf; do
        [[ -f $f ]] || continue
        grep -q '^options.*splash' "$f" || sed -i '/^options/ s/$/ quiet splash/' "$f"
    done
    if [[ -f /etc/default/grub ]] && ! grep -q 'GRUB_CMDLINE_LINUX_DEFAULT=.*splash' /etc/default/grub; then
        sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/GRUB_CMDLINE_LINUX_DEFAULT="\1 splash"/' /etc/default/grub
    fi
    command -v plymouth >/dev/null && mkinitcpio -P >/dev/null 2>&1
    [[ -f /boot/grub/grub.cfg ]] && grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
}

enable_services() {
    local s
    for s in sddm.service NetworkManager.service bluetooth.service cups.socket \
             tlp.service ufw.service systemd-timesyncd.service fstrim.timer \
             vboxservice.service vmtoolsd.service vmware-vmblock-fuse.service \
             qemu-guest-agent.service spice-vdagentd.socket \
             hv_fcopy_daemon.service hv_kvp_daemon.service hv_vss_daemon.service; do
        [[ -e /usr/lib/systemd/system/$s ]] && systemctl enable "$s" >/dev/null 2>&1 && say "enabled $s"
    done
    # TLP and power-profiles-daemon fight over the same settings: TLP wins.
    systemctl mask power-profiles-daemon.service >/dev/null 2>&1 || true
    systemctl mask systemd-rfkill.service systemd-rfkill.socket >/dev/null 2>&1 || true
    # Daily "updates available" check for every user.
    systemctl --global enable devium-update-check.timer >/dev/null 2>&1 || true
}

setup_firewall() {
    [[ -f /etc/ufw/ufw.conf ]] && sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
}

setup_flathub() {
    command -v flatpak >/dev/null || return 0
    flatpak remote-add --system --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 \
        && say "added Flathub" || say "could not add Flathub now (it is added again on first update)"
}

setup_archpill_source() {
    # ArchPill is copied into /opt/archpill by build.sh; installed systems clone it.
    if [[ ! -f /opt/archpill/install.sh ]]; then
        rm -rf /opt/archpill
        git clone --depth 1 https://github.com/yeeboein/archpill.git /opt/archpill >/dev/null 2>&1 \
            && say "downloaded ArchPill" || say "could not download ArchPill"
    fi
    [[ -d /opt/archpill ]] && chmod -R a+rX /opt/archpill
}

setup_pacman() {
    sed -i 's/^#Color/Color/; s/^#ParallelDownloads.*/ParallelDownloads = 5/' /etc/pacman.conf
    grep -q ILoveCandy /etc/pacman.conf || sed -i '/^Color/a ILoveCandy' /etc/pacman.conf
}

live_user() {
    if ! id devium >/dev/null 2>&1; then
        # /etc/skel already contains Devium's files (airootfs is copied before packages).
        useradd -m -c "Devium Live" -G wheel -s /usr/bin/zsh devium
        echo 'devium:devium' | chpasswd
        for g in audio video storage network lp sys input; do
            getent group "$g" >/dev/null && usermod -aG "$g" devium
        done
        say "created live user 'devium' (password: devium)"
    fi
    mkdir -p /home/devium/Desktop
    install -m 755 /usr/share/applications/devium-install.desktop /home/devium/Desktop/ 2>/dev/null || true
    chown -R devium:devium /home/devium
}


apply_overrides() {
    # Files other packages also own (bash's skel, shadow's useradd defaults...) are shipped
    # under /usr/share/devium/overrides and copied into place here.
    local o=/usr/share/devium/overrides
    [[ -d $o ]] && cp -a "$o"/. /
}

set_hostname() {
    # archinstall's default computer name is "archlinux": use "devium" instead.
    if [[ ! -s /etc/hostname || $(cat /etc/hostname) == archlinux ]]; then
        echo devium > /etc/hostname
        sed -i 's/\barchlinux\b/devium/g' /etc/hosts 2>/dev/null
    fi
}

strip_live_repo() {
    # The [devium] repo only exists on the live ISO; don't leave it in an installed system.
    if [[ ! -d /opt/devium-repo ]] && grep -q '^\[devium\]' /etc/pacman.conf; then
        sed -i '/^\[devium\]/,/^Server = file:\/\/\/opt\/devium-repo/d' /etc/pacman.conf
    fi
}

package_setup() {
    strip_live_repo
    apply_overrides
    write_os_release
    set_hostname
    setup_pacman
    enable_services
    systemctl enable devium-firstboot.service >/dev/null 2>&1
    setup_firewall
    setup_flathub
    setup_archpill_source
    systemctl set-default graphical.target >/dev/null 2>&1
}

finish_setup() {
    strip_live_repo
    set_hostname
    brand_bootloader
    for home in /home/*; do
        [[ -d $home ]] || continue
        owner="$(stat -c %U "$home")"
        [[ $owner == root || $owner == UNKNOWN ]] && continue
        cp -rn /etc/skel/. "$home"/ && chown -R "$owner:" "$home"
        # zsh by default (users can pick fish or bash in the Setup wizard)
        if [[ -x /usr/bin/zsh && ! -f $home/.config/devium/shell-chosen ]]; then
            chsh -s /usr/bin/zsh "$owner" >/dev/null 2>&1
        fi
    done
    mkdir -p /var/lib/devium && touch /var/lib/devium/finished
}

case "${1:-}" in
    --os-release)
        write_os_release
        ;;
    --live)
        write_os_release
        setup_pacman
        enable_services
        setup_firewall
        setup_flathub
        setup_archpill_source
        live_user
        # The installer copies Devium onto the new system from this local repo (no download).
        if [[ -d /opt/devium-repo ]] && ! grep -q '^\[devium\]' /etc/pacman.conf; then
            printf '\n[devium]\nSigLevel = Optional TrustAll\nServer = file:///opt/devium-repo\n' >> /etc/pacman.conf
        fi
        systemctl set-default graphical.target >/dev/null 2>&1
        ;;
    --package)
        package_setup
        say "done"
        ;;
    --finish)
        finish_setup
        say "done"
        ;;
    --installed)
        src="${2:?usage: devium-setup --installed <repo dir>}"
        root="$src/profile/airootfs"
        [[ -d $root ]] || { echo "no airootfs in $src"; exit 1; }
        say "copying Devium files"
        # Everything except files that only make sense on the live ISO.
        tar -C "$root" \
            --exclude=./etc/shadow --exclude=./etc/passwd --exclude=./etc/hostname \
            --exclude=./etc/localtime --exclude=./etc/locale.conf \
            --exclude=./etc/mkinitcpio.conf.d --exclude=./etc/sudoers.d \
            --exclude=./etc/polkit-1/rules.d/49-devium-live.rules \
            --exclude=./etc/sddm.conf.d/20-devium-live-autologin.conf \
            --exclude=./etc/systemd/journald.conf.d/volatile-storage.conf --exclude=./etc/systemd/logind.conf.d \
            --exclude=./etc/systemd/system/etc-pacman.d-gnupg.mount --exclude=./etc/systemd/system/pacman-init.service \
            --exclude=./etc/systemd/system/multi-user.target.wants --exclude=./root \
            --exclude=./etc/pacman.d/hooks/zz-devium-live-setup.hook \
            --exclude=./etc/pacman.d/hooks/zzzz99-remove-custom-hooks-from-airootfs.hook \
            --exclude=./etc/pacman.d/hooks/uncomment-mirrors.hook \
            --exclude=./usr/share/applications/devium-install.desktop \
            --exclude=./usr/share/applications/devium-about-live.desktop \
            -cf - . | tar -C / --no-same-owner -xf -
        chmod 755 /usr/local/bin/devium-* /usr/local/bin/support /usr/lib/devium/devium-* 2>/dev/null
        package_setup
        [[ -n ${DEVIUM_REFRESH:-} ]] && { say "done"; exit 0; }
        finish_setup
        say "done"
        ;;
    *)
        sed -n '2,12p' "$0"
        exit 1
        ;;
esac
exit 0
