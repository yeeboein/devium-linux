#!/usr/bin/env python3
"""Shown a minute after Devium Configure finishes: "We recommend a restart to get everything moving!"."""
import subprocess
import sys

sys.path.insert(0, "/usr/lib/devium")
from PyQt6.QtWidgets import QApplication, QMessageBox

import devium_ui as ui

app = QApplication(sys.argv)
app.setApplicationName("Devium Configure")
app.setDesktopFileName("devium-setup-wizard")
ui.style_app(app)
box = QMessageBox()
box.setWindowTitle("Restart recommended")
box.setWindowIcon(ui.app_icon())
box.setIcon(QMessageBox.Icon.Information)
box.setText("<b>We recommend a restart to get everything moving!</b>")
box.setInformativeText("New apps, your shell, the dock and ArchPill all start fresh after a restart.")
restart = box.addButton("Restart now", QMessageBox.ButtonRole.AcceptRole)
box.addButton("Ignore", QMessageBox.ButtonRole.RejectRole)
box.exec()
if box.clickedButton() is restart:
    # Restart through KDE so it saves the desktop (dock, pinned apps) first; plain reboot as a fallback
    subprocess.Popen(["sh", "-c", "qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logoutAndReboot "
                      "|| qdbus6 org.kde.ksmserver /KSMServer logout 0 1 2 || systemctl reboot"])
