#!/usr/bin/env bash
# Privileged actions for the Devium apps. Run through pkexec (asks for your password once).
#
#   devium-helper update            snapshot (if Timeshift is set up), then update everything
#   devium-helper clean             remove old package cache and unused Flatpak runtimes
#   devium-helper install PKG...    install packages from the Arch repos
#   devium-helper firewall on|off
#   devium-helper snapshot
#   devium-helper setup PLAN.json   apply the Devium Setup wizard's choices
#   devium-helper install-local FILE.pkg.tar.zst...   install packages built from the AUR
#   devium-helper refresh TAG       update Devium's own files to release TAG (Devium Updater)
#   devium-helper brave-origin      install or update Brave Origin (official build from Brave)
#   devium-helper cancel            stop a running Devium Setup install cleanly
set -uo pipefail
export LC_ALL=C.UTF-8 TERM=dumb

[[ $EUID -eq 0 ]] || { echo "devium-helper must run as root (use pkexec)"; exit 1; }

step() { printf '\n### %s\n' "$*"; }

# pacman allows one install at a time (/var/lib/pacman/db.lck). Wait for a real one to finish;
# remove a leftover lock when no pacman is running (e.g. after an interrupted install).
pacman_unlock() {
    local i
    for i in $(seq 1 60); do
        [[ -e /var/lib/pacman/db.lck ]] || return 0
        if ! pgrep -x pacman >/dev/null; then
            echo "Removing a leftover package manager lock."
            rm -f /var/lib/pacman/db.lck
            return 0
        fi
        (( i == 1 )) && echo "Another install is running - waiting for it to finish..."
        sleep 1
    done
    echo "Another install is still running. Try again when it has finished."
    return 1
}

snapshot() {
    if command -v timeshift >/dev/null && [[ -s /etc/timeshift/timeshift.json ]] \
       && grep -q '"backup_device_uuid" *: *"[^"]' /etc/timeshift/timeshift.json; then
        step "Creating a restore point (Timeshift)"
        timeshift --create --scripted --comments "${1:-Devium restore point}" --tags O \
            || echo "Snapshot failed - continuing."
    else
        echo "(Timeshift is not set up yet, skipping restore point. Set it up in Devium Welcome > System.)"
    fi
}


brave_origin() {
    # Official Brave Origin build: brave-origin-<version>-linux-amd64.zip on Brave's GitHub releases.
    step "Looking for the latest Brave Origin"
    local url
    url="$(curl -fsSL "https://api.github.com/repos/brave/brave-browser/releases?per_page=30" | python3 -c '
import json, re, sys
for r in json.load(sys.stdin):
    if r.get("prerelease") or r.get("draft"):
        continue
    for a in r.get("assets", []):
        if re.fullmatch(r"brave-origin-[0-9.]+-linux-amd64\.zip", a["name"]):
            print(a["browser_download_url"]); sys.exit(0)
')" || true
    [[ $url == https://github.com/brave/brave-browser/releases/download/* ]] || { echo "Could not find Brave Origin's download."; return 1; }
    local ver="${url##*/brave-origin-}"; ver="${ver%-linux-amd64.zip}"
    if [[ -f /opt/brave-origin/.version && $(cat /opt/brave-origin/.version) == "$ver" ]]; then
        echo "Brave Origin $ver is already up to date."; return 0
    fi
    step "Downloading Brave Origin $ver"
    local tmp; tmp="$(mktemp -d)"
    curl -fL --retry 3 -o "$tmp/brave-origin.zip" "$url" || { rm -rf "$tmp"; return 1; }
    mkdir -p "$tmp/x" && unzip -q "$tmp/brave-origin.zip" -d "$tmp/x" || { rm -rf "$tmp"; return 1; }
    # the zip may contain a top-level folder
    local top="$tmp/x"; [[ $(ls -A "$top" | wc -l) == 1 && -d $top/$(ls -A "$top") ]] && top="$top/$(ls -A "$top")"
    rm -rf /opt/brave-origin && mv "$top" /opt/brave-origin && rm -rf "$tmp"
    echo "$ver" > /opt/brave-origin/.version
    [[ -f /opt/brave-origin/chrome-sandbox ]] && chown root:root /opt/brave-origin/chrome-sandbox && chmod 4755 /opt/brave-origin/chrome-sandbox
    local bin
    for b in brave-origin brave brave-browser; do [[ -x /opt/brave-origin/$b ]] && { bin=/opt/brave-origin/$b; break; }; done
    [[ -n $bin ]] || { echo "Brave Origin was downloaded but its program wasn't found."; return 1; }
    ln -sf "$bin" /usr/local/bin/brave-origin
    local icon=/opt/brave-origin/product_logo_128.png; [[ -f $icon ]] || icon=brave-browser
    cat > /usr/share/applications/brave-origin.desktop <<DESK
[Desktop Entry]
Type=Application
Name=Brave Origin
GenericName=Web Browser
Comment=Brave without Rewards, Wallet, VPN or AI
Exec=/usr/local/bin/brave-origin %U
Icon=$icon
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=brave-origin
DESK
    echo "Brave Origin $ver installed."
}

case "${1:-}" in
    update)
        snapshot "Before update $(date '+%Y-%m-%d %H:%M')"
        pacman_unlock || exit 1
        step "Updating the keyring"
        pacman -Sy --needed --noconfirm archlinux-keyring || exit 1
        step "Updating system packages"
        pacman -Su --noconfirm || exit 1
        if command -v flatpak >/dev/null; then
            flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null
            step "Updating Flatpak apps"
            flatpak update --system -y --noninteractive || echo "Flatpak update had problems."
        fi
        [[ -d /opt/brave-origin ]] && { brave_origin || echo "Brave Origin update had problems."; }
        step "Done"
        ;;
    clean)
        step "Removing old package versions"
        paccache -rk1
        paccache -ruk0
        if command -v flatpak >/dev/null; then
            step "Removing unused Flatpak runtimes"
            flatpak uninstall --system --unused -y --noninteractive
        fi
        step "Done"
        ;;
    install)
        shift
        (( $# )) || { echo "nothing to install"; exit 1; }
        for p in "$@"; do
            [[ $p =~ ^[a-z0-9@._+-]+$ ]] || { echo "bad package name: $p"; exit 1; }
        done
        pacman_unlock || exit 1
        step "Installing: $*"
        pacman -Sy --needed --noconfirm "$@"
        ;;
    firewall)
        case "${2:-}" in
            on)  ufw --force enable && systemctl enable --now ufw ;;
            off) ufw disable && systemctl disable --now ufw ;;
            *) echo "usage: devium-helper firewall on|off"; exit 1 ;;
        esac
        ;;
    snapshot)
        snapshot "Manual restore point $(date '+%Y-%m-%d %H:%M')"
        ;;
    setup)
        plan="${2:?usage: devium-helper setup PLAN.json}"
        [[ -f $plan ]] || { echo "no plan: $plan"; exit 1; }
        # Read the plan with Python and turn it into safe, validated shell variables.
        eval "$(python3 - "$plan" <<'PY'
import json, re, shlex, sys
p = json.load(open(sys.argv[1]))
ok_pkg = re.compile(r"^[a-z0-9@._+-]+$")
ok_app = re.compile(r"^[A-Za-z0-9._-]+$")
ok_svc = {"docker.socket", "ollama.service"}
ok_grp = {"docker"}
ok_shell = {"/usr/bin/zsh", "/usr/bin/fish", "/bin/bash"}
def arr(name, items, rx):
    items = [i for i in items if rx.match(i)]
    print(f"{name}=(" + " ".join(shlex.quote(i) for i in items) + ")")
arr("PKGS", p.get("pacman", []), ok_pkg)
arr("APPS", p.get("flatpak", []), ok_app)
print("SVCS=(" + " ".join(s for s in p.get("services", []) if s in ok_svc) + ")")
print("GRPS=(" + " ".join(g for g in p.get("groups", []) if g in ok_grp) + ")")
user = p.get("user", "")
print("SETUP_USER=" + shlex.quote(user if re.match(r"^[a-z_][a-z0-9_-]*$", user) else ""))
sh = p.get("shell", "")
print("SETUP_SHELL=" + shlex.quote(sh if sh in ok_shell else ""))
PY
)"
        fail=0
        if (( ${#PKGS[@]} )); then
            pacman_unlock || exit 1
            step "Installing ${#PKGS[@]} packages"
            pacman -Sy --needed --noconfirm "${PKGS[@]}" || fail=1
        fi
        if (( ${#APPS[@]} )); then
            flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null
            step "Installing ${#APPS[@]} apps from Flathub"
            for app in "${APPS[@]}"; do
                flatpak install --system -y --noninteractive flathub "$app" || { echo "Could not install $app"; fail=1; }
            done
        fi
        for svc in "${SVCS[@]}"; do
            step "Enabling $svc"
            systemctl enable --now "$svc" || fail=1
        done
        if [[ -n $SETUP_USER ]]; then
            for g in "${GRPS[@]}"; do usermod -aG "$g" "$SETUP_USER"; done
            if [[ -n $SETUP_SHELL && -x $SETUP_SHELL ]]; then
                step "Setting your shell to $SETUP_SHELL"
                chsh -s "$SETUP_SHELL" "$SETUP_USER"
            fi
        fi
        step "Done"
        exit $fail
        ;;
    refresh)
        tag="${2:?usage: devium-helper refresh TAG}"
        [[ $tag =~ ^[A-Za-z0-9._-]+$ ]] || { echo "bad tag"; exit 1; }
        source /etc/devium-release 2>/dev/null
        repo="${DEVIUM_REPO:-https://github.com/yeeboein/devium-linux}"
        step "Downloading Devium $tag"
        rm -rf /tmp/devium-refresh
        git clone --depth 1 -b "$tag" "$repo" /tmp/devium-refresh || exit 1
        step "Updating Devium's apps, look and settings"
        DEVIUM_REFRESH=1 bash /tmp/devium-refresh/profile/airootfs/usr/lib/devium/devium-setup --installed /tmp/devium-refresh || exit 1
        sed -i "s/^DEVIUM_VERSION=.*/DEVIUM_VERSION=${tag#v}/" /etc/devium-release 2>/dev/null \
            || echo "DEVIUM_VERSION=${tag#v}" >> /etc/devium-release
        rm -rf /tmp/devium-refresh
        step "Done"
        ;;
    brave-origin)
        brave_origin
        ;;
    cancel)
        # SIGINT lets pacman and flatpak stop cleanly (pacman removes its lock file)
        pkill -INT -x pacman 2>/dev/null
        pkill -INT -f '^flatpak install' 2>/dev/null
        pkill -TERM -f 'devium-helper (setup|brave-origin|install-local)' 2>/dev/null
        exit 0
        ;;
    install-local)
        shift
        for f in "$@"; do
            [[ $f == /tmp/devium-aur/*.pkg.tar.zst && $f != *..* && -f $f ]] || { echo "refusing: $f"; exit 1; }
        done
        step "Installing $(basename -a "$@" | tr '\n' ' ')"
        pacman_unlock || exit 1
        pacman -U --needed --noconfirm "$@"
        ;;
    *)
        sed -n '2,9p' "$0"; exit 1 ;;
esac
