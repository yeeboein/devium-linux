#!/usr/bin/env python3
"""devium-wallpaper - choose the home (desktop) and lock screen pictures separately.

  devium-wallpaper status                 what's set now (JSON)
  devium-wallpaper home PICTURE|default   the desktop picture
  devium-wallpaper lock PICTURE|default   the lock screen picture
  devium-wallpaper login PICTURE|default  the login screen picture (asks for your password)
  devium-wallpaper gui                    a small window to pick both (System Settings > Appearance >
                                          Lock Screen Wallpaper opens this)

"default" puts Devium's own pictures back. Your chosen pictures are copied to ~/.local/share/devium/wallpapers,
so moving or deleting the original doesn't break anything. Works on KDE Plasma, Xfce and Hyprland (on Xfce the
lock screen is the login screen, so `lock` and `login` do the same there).
"""
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "devium")
STATE = os.path.join(CONFIG, "wallpapers.json")
STORE = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share")), "devium", "wallpapers")
HOME_DEFAULT = "/usr/share/wallpapers/Devium/contents/images/1920x1080.jpg"
HOME_DEFAULT_DIR = "/usr/share/wallpapers/Devium/"
LOCK_DEFAULT = "/usr/share/wallpapers/DeviumLock/contents/images/1920x1080.jpg"
LOCK_DEFAULT_DIR = "/usr/share/wallpapers/DeviumLock/"
HELPER = ["pkexec", "/usr/lib/devium/devium-helper"]

KDE = shutil.which("plasmashell") is not None
XFCE = shutil.which("xfwm4") is not None and not KDE
HYPR = (shutil.which("Hyprland") is not None or shutil.which("hyprctl") is not None) and not KDE and not XFCE


def load():
    try:
        return json.load(open(STATE))
    except (OSError, ValueError):
        return {}


def save(state):
    os.makedirs(CONFIG, exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(state, f, indent=1, sort_keys=True)


def run(cmd, **kw):
    try:
        return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, **kw).returncode == 0
    except OSError:
        return False


def keep_copy(kind, src):
    """Check it's a picture and keep our own copy (as a JPEG or PNG), so the original can move or go."""
    try:
        from PIL import Image
        im = Image.open(src)
        im.load()
    except Exception:
        raise SystemExit(f"{src} isn't a picture I can open (try a JPG, PNG or WebP file).")
    if min(im.size) < 400:
        raise SystemExit("That picture is very small and would look blurry. Pick one that's at least 1280 wide.")
    os.makedirs(STORE, exist_ok=True)
    for old in os.listdir(STORE):
        if old.startswith(kind + "."):
            os.remove(os.path.join(STORE, old))
    has_alpha = im.mode in ("RGBA", "LA", "P") and "transparency" in getattr(im, "info", {}) or im.mode in ("RGBA", "LA")
    ext = "png" if has_alpha else "jpg"
    out = os.path.join(STORE, f"{kind}.{ext}")
    if max(im.size) > 3840:
        im.thumbnail((3840, 3840))
    if ext == "jpg":
        im.convert("RGB").save(out, quality=92, optimize=True)
    else:
        im.save(out, optimize=True)
    return out


def set_home(path):
    if KDE:
        if path:
            return run(["plasma-apply-wallpaperimage", path])
        return run(["plasma-apply-wallpaperimage", HOME_DEFAULT])
    if XFCE:
        target = path or HOME_DEFAULT
        props = subprocess.run(["xfconf-query", "-c", "xfce4-desktop", "-l"], capture_output=True, text=True).stdout
        found = [p for p in props.splitlines() if p.endswith("last-image")]
        for prop in found or ["/backdrop/screen0/monitor0/workspace0/last-image"]:
            run(["xfconf-query", "-c", "xfce4-desktop", "-p", prop, "-n", "-t", "string", "-s", target])
        return True
    if HYPR:
        target = path or HOME_DEFAULT
        conf = os.path.join(HOME, ".config/hypr/hyprpaper.conf")
        os.makedirs(os.path.dirname(conf), exist_ok=True)
        with open(conf, "w") as f:
            f.write(f"preload = {target}\nwallpaper = , {target}\nsplash = false\n")
        run(["hyprctl", "hyprpaper", "preload", target])
        run(["hyprctl", "hyprpaper", "wallpaper", f", {target}"])
        return True
    return False


def set_lock(path):
    if KDE:
        target = path or LOCK_DEFAULT_DIR
        cmd = ["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Greeter", "--group", "Wallpaper",
               "--group", "org.kde.image", "--group", "General"]
        ok = run(cmd + ["--key", "Image", ("file://" + path) if path else LOCK_DEFAULT_DIR])
        run(cmd + ["--key", "PreviewImage", ("file://" + path) if path else LOCK_DEFAULT_DIR])
        return ok
    if HYPR:
        conf = os.path.join(HOME, ".config/hypr/hyprlock.conf")
        try:
            text = open(conf).read()
        except OSError:
            return False
        target = path or LOCK_DEFAULT
        new, n = re.subn(r"(background\s*\{[^}]*?\bpath\s*=\s*)[^\n]*", lambda m: m.group(1) + target, text, count=1, flags=re.S)
        if n:
            open(conf, "w").write(new)
        return bool(n)
    return False


def set_login(path):
    """The login screen (SDDM or LightDM) lives in system files, so this goes through the privileged helper."""
    return run(HELPER + ["login-wallpaper", path or "default"])


def gui():
    """A small window: desktop picture and lock screen picture, each with a preview, Choose and Use Devium's."""
    sys.path.insert(0, "/usr/lib/devium")
    from PyQt6.QtCore import QProcess, Qt
    from PyQt6.QtGui import QPixmap
    from PyQt6.QtWidgets import (QApplication, QCheckBox, QFileDialog, QHBoxLayout, QLabel, QPushButton,
                                 QVBoxLayout, QWidget)
    try:
        import devium_ui as ui
    except ImportError:
        ui = None
    app = QApplication(sys.argv)
    app.setApplicationName("Devium Wallpapers")
    app.setDesktopFileName("devium-wallpapers")
    if ui:
        ui.style_app(app)
    win = QWidget()
    win.setWindowTitle("Wallpapers")
    if ui:
        win.setWindowIcon(ui.app_icon())
    lay = QVBoxLayout(win)
    lay.setContentsMargins(22, 18, 22, 18)
    lay.setSpacing(10)
    if ui:
        lay.addWidget(ui.header("Wallpapers", "Pick the picture for your desktop and for your lock screen."))
    note = QLabel("")
    note.setWordWrap(True)
    login_box = QCheckBox("Use the lock screen picture on the login screen too (asks for your password)")
    login_box.setChecked(True)
    login_box.setVisible(not XFCE and (os.path.isdir("/usr/share/sddm/themes/devium") or HYPR))
    thumbs = {}

    def current(kind):
        s = load()
        return s.get(kind) or (HOME_DEFAULT if kind == "home" else LOCK_DEFAULT)

    def show(kind):
        pm = QPixmap(current(kind))
        if pm.isNull():
            thumbs[kind].setText("(no picture)")
        else:
            thumbs[kind].setPixmap(pm.scaled(240, 135, Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                                             Qt.TransformationMode.SmoothTransformation).copy(0, 0, 240, 135))

    def apply(kind, source):
        steps = [kind] + (["login"] if kind == "lock" and login_box.isVisible() and login_box.isChecked() else [])
        note.setText("Working…")

        def step():
            if not steps:
                show(kind)
                note.setText("Done!")
                return
            k = steps.pop(0)
            proc = QProcess(win)
            proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)

            def finished(code, _status, proc=proc):
                out = bytes(proc.readAllStandardOutput()).decode(errors="replace").strip()
                if code != 0:
                    note.setText(out.splitlines()[-1] if out else "That didn't work.")
                    show(kind)
                else:
                    step()
            proc.finished.connect(finished)
            proc.start(sys.executable, [os.path.abspath(__file__), k, source])
        step()

    def choose(kind):
        start = os.path.join(HOME, "Pictures") if os.path.isdir(os.path.join(HOME, "Pictures")) else HOME
        f, _ = QFileDialog.getOpenFileName(win, "Choose a picture", start, "Pictures (*.jpg *.jpeg *.png *.webp *.bmp)")
        if f:
            apply(kind, f)

    def row(kind, title, desc):
        box = QWidget()
        h = QHBoxLayout(box)
        h.setContentsMargins(0, 6, 0, 6)
        h.setSpacing(16)
        thumb = QLabel()
        thumb.setFixedSize(240, 135)
        thumb.setAlignment(Qt.AlignmentFlag.AlignCenter)
        thumb.setStyleSheet("border-radius: 10px; background: rgba(255,255,255,0.06);")
        thumbs[kind] = thumb
        show(kind)
        h.addWidget(thumb)
        v = QVBoxLayout()
        t = QLabel(title)
        t.setObjectName("h2")
        d = QLabel(desc)
        d.setObjectName("subtitle")
        d.setWordWrap(True)
        v.addWidget(t)
        v.addWidget(d)
        b = QHBoxLayout()
        pick = QPushButton("Choose picture…")
        pick.setObjectName("primary")
        pick.clicked.connect(lambda: choose(kind))
        reset = QPushButton("Use Devium's")
        reset.clicked.connect(lambda: apply(kind, "default"))
        b.addWidget(pick)
        b.addWidget(reset)
        b.addStretch(1)
        v.addLayout(b)
        v.addStretch(1)
        h.addLayout(v, 1)
        return box

    lay.addWidget(row("lock", "Lock screen picture",
                      "The picture behind the clock when you lock your computer." if not XFCE
                      else "The picture behind the login and lock screen."))
    lay.addWidget(login_box)
    lay.addWidget(row("home", "Desktop picture", "The wallpaper behind your windows (your home screen)."))
    lay.addWidget(note)
    lay.addStretch(1)
    win.resize(640, 470)
    win.show()
    return app.exec()


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd = a[0]
    if cmd == "gui":
        return gui()
    if cmd == "status":
        s = load()
        print(json.dumps({"home": s.get("home"), "lock": s.get("lock"), "login": s.get("login"),
                          "home_default": HOME_DEFAULT, "lock_default": LOCK_DEFAULT}))
        return 0
    if cmd not in ("home", "lock", "login") or len(a) < 2:
        print(__doc__.strip())
        return 1
    state = load()
    if a[1] == "default":
        copy = None
        if os.path.isdir(STORE):          # forget our stored copy of the old choice
            for old in os.listdir(STORE):
                if old.startswith(cmd + "."):
                    os.remove(os.path.join(STORE, old))
    else:
        src = os.path.expanduser(a[1])
        if not os.path.isfile(src):
            print(f"I can't find {src}")
            return 1
        copy = keep_copy(cmd, src)
    if cmd == "home":
        ok = set_home(copy)
    elif cmd == "lock":
        ok = set_lock(copy)
        if XFCE:       # on Xfce the lock screen is the login screen
            ok = set_login(copy)
    else:
        ok = set_login(copy)
    if not ok and not (KDE or XFCE or HYPR):
        print("I couldn't tell which desktop this is.")
        return 1
    state[cmd] = copy
    if cmd == "lock" and XFCE:
        state["login"] = copy
    save(state)
    print(("Done: " if ok else "Saved, but couldn't apply it: ") + f"{cmd} picture " + ("is Devium's again." if not copy else "set."))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
