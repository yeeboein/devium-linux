from PyQt6.QtCore import QProcess, Qt, QTimer
from PyQt6.QtGui import QFont, QGuiApplication, QIcon
from PyQt6.QtWidgets import (QApplication, QCheckBox, QComboBox, QDialog, QFormLayout, QFrame,
                             QGridLayout, QHBoxLayout, QHeaderView, QLabel, QLineEdit,
                             QListWidget, QListWidgetItem, QMessageBox, QPlainTextEdit,
                             QProgressBar, QPushButton, QScrollArea, QSizePolicy, QSlider, QStackedWidget,
                             QTextEdit, QTreeWidget, QTreeWidgetItem, QVBoxLayout, QWidget)

import devium_ui as ui
