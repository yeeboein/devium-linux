HELPER = "/usr/lib/devium/devium-helper"
WEBHOOK_FILE = "/etc/devium/report-webhook"
REPO = "https://github.com/yeeboein/devium-linux"
KDE = shutil.which("plasmashell") is not None


# ---------------------------------------------------------------------------- small helpers
def run(cmd, timeout=15):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def human(b):
    b = float(b)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if b < 1024 or unit == "TB":
            return f"{b:.0f} {unit}" if unit in ("B", "KB") else f"{b:.1f} {unit}"
        b /= 1024


def meminfo():
    m = {}
    for line in read("/proc/meminfo").splitlines():
        k, v = line.split(":", 1)
        m[k] = int(v.split()[0]) * 1024
    return m


def ram_gb():
    return meminfo().get("MemTotal", 8 << 30) / (1 << 30)


def kwrite(file, group, key, value):
    tool = shutil.which("kwriteconfig6") or shutil.which("kwriteconfig5")
    if tool:
        subprocess.run([tool, "--file", file, "--group", group, "--key", key, str(value)])


def kread(file, group, key, default=""):
    tool = shutil.which("kreadconfig6") or shutil.which("kreadconfig5")
    if not tool:
        return default
    return run([tool, "--file", file, "--group", group, "--key", key, "--default", default]).strip()


def kwin_reconfigure():
    subprocess.run("qdbus6 org.kde.KWin /KWin reconfigure", shell=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def in_terminal(command):
    """Open a terminal window running a command, and keep it open afterwards."""
    keep = f"{command}; echo; read -rp 'Press Enter to close...' _"
    for term, args in (("konsole", ["--hold", "-e", "bash", "-c"]), ("xfce4-terminal", ["--hold", "-x", "bash", "-c"]),
                       ("kitty", ["bash", "-c"]), ("alacritty", ["-e", "bash", "-c"]), ("foot", ["bash", "-c"])):
        if shutil.which(term):
            subprocess.Popen([term] + args + [keep if term not in ("konsole", "xfce4-terminal") else command],
                             start_new_session=True)
            return True
    return False


def label(text, obj=None, wrap=True, rich=False):
    l = QLabel(text)
    if obj:
        l.setObjectName(obj)
    l.setWordWrap(wrap)
    if rich:
        l.setTextFormat(Qt.TextFormat.RichText)
        l.setOpenExternalLinks(False)
        l.linkActivated.connect(lambda url: ui.open_link(url))
    return l


def button(text, slot, primary=False, icon=None):
    b = QPushButton(text)
    if primary:
        b.setObjectName("primary")
    if icon:
        b.setIcon(QIcon.fromTheme(icon))
    b.clicked.connect(slot)
    return b


def card(*widgets):
    f = QFrame()
    f.setObjectName("card")
    f.setStyleSheet("QFrame#card { border: 1px solid palette(mid); border-radius: 12px; background: palette(base); }")
    l = QVBoxLayout(f)
    l.setContentsMargins(16, 12, 16, 12)
    for w in widgets:
        if isinstance(w, QHBoxLayout):
            l.addLayout(w)
        else:
            l.addWidget(w)
    return f


def row(*widgets, stretch=True):
    r = QHBoxLayout()
    for w in widgets:
        r.addWidget(w)
    if stretch:
        r.addStretch(1)
    return r


class Page(QScrollArea):
    """A scrolling page with a title, a short explanation and a column of content."""

    def __init__(self, title, intro):
        super().__init__()
        self.setWidgetResizable(True)
        self.setFrameShape(QFrame.Shape.NoFrame)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        inner = QWidget()
        self.col = QVBoxLayout(inner)
        self.col.setContentsMargins(24, 18, 24, 18)
        self.col.setSpacing(10)
        self.col.addWidget(label(title, "title"))
        self.col.addWidget(label(intro, "subtitle"))
        self.setWidget(inner)
        self.loaded = False

    def add(self, w):
        if isinstance(w, QHBoxLayout):
            self.col.addLayout(w)
        else:
            self.col.addWidget(w)
        return w

    def finish(self):
        self.col.addStretch(1)

    def on_show(self):
        """Called the first time (and every time) the page is opened."""


class RunDialog(QDialog):
    """Run a command (usually the root helper), show what it does, report the result."""

    def __init__(self, parent, title, program, args, done=None):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.resize(640, 380)
        self.done_cb = done
        l = QVBoxLayout(self)
        self.status = label(T("Working..."), "h2")
        l.addWidget(self.status)
        self.bar = QProgressBar()
        self.bar.setRange(0, 0)
        l.addWidget(self.bar)
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setFont(QFont("monospace"))
        l.addWidget(self.log, 1)
        self.close_btn = button(T("Close"), self.accept)
        self.close_btn.setEnabled(False)
        l.addLayout(row(self.close_btn))
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.more)
        self.proc.finished.connect(self.finished)
        self.proc.start(program, args)

    def more(self):
        text = bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        self.log.insertPlainText(text)
        self.log.ensureCursorVisible()
        steps = re.findall(r"^### (.+)$", text, re.M)
        if steps:
            self.status.setText(steps[-1])

    def finished(self, code, _status):
        self.bar.setRange(0, 1)
        self.bar.setValue(1)
        self.status.setText(T("Done") if code == 0 else T("Something went wrong") + f" (code {code})")
        self.close_btn.setEnabled(True)
        if self.done_cb:
            self.done_cb(code)


def root(parent, title, *args, done=None):
    """Run a devium-helper action as root (asks for the password once)."""
    RunDialog(parent, title, "pkexec", [HELPER, *args], done).exec()


# ---------------------------------------------------------------------------- Home (Devium Hub)
class HomePage(Page):
    def __init__(self, win):
        super().__init__(T("Devium Tools"), T("Everything to look after your computer, in one place."))
        self.win = win
        self.status = self.add(label("", rich=True))
        grid = QGridLayout()
        grid.setSpacing(10)
        tiles = [
            ("Devium Setup", "Add or remove apps and the look", "system-software-install",
             lambda: ui.launch("devium-setup-wizard")),
            (T("App Manager"), "Size, RAM and remove apps", "view-list-details",
             lambda: win.go("apps")),
            (T("Updates"), "Install updates with a restore point first (Meta+U)", "system-software-update",
             lambda: win.go("updates")),
            ("Devium Updater", "Get new Devium versions", "devium",
             lambda: ui.launch("devium-updater")),
            (T("Make it faster"), "Safe tweaks for speed and memory", "speedometer", lambda: win.go("speed")),
            (T("Get help"), "Fix problems, commands, and report a bug", "help-browser", lambda: win.go("help")),
            ("Devium Setup again", "Add or remove apps any time", "system-software-install",
             lambda: ui.launch("devium-setup-wizard")),
            ("About Devium", "Version, credits and links", "devium", lambda: ui.launch("devium-about")),
        ]
        for i, (name, desc, icon, act) in enumerate(tiles):
            b = QPushButton(f"  {name}\n  {desc}")
            b.setObjectName("tile")
            b.setIcon(QIcon.fromTheme(icon, ui.app_icon()))
            b.setIconSize(b.iconSize() * 2)
            b.setMinimumHeight(64)
            b.setToolTip(desc)
            b.setSizePolicy(QSizePolicy.Policy.Ignored, QSizePolicy.Policy.Fixed)
            b.clicked.connect(act)
            grid.addWidget(b, i // 2, i % 2)
        self.add(label("Devium Hub", "h2"))
        w = QWidget()
        w.setLayout(grid)
        self.add(w)
        links = label(f"<a href='{REPO}/blob/main/docs/GUIDE.md'>Guide</a> &nbsp;·&nbsp; "
                      f"<a href='{REPO}/releases'>Releases</a> &nbsp;·&nbsp; "
                      f"<a href='{REPO}'>GitHub</a> &nbsp;·&nbsp; "
                      f"<a href='https://wiki.archlinux.org'>Arch Wiki</a>", rich=True)
        invite = read("/etc/devium/discord-invite") or ui.DISCORD
        if invite.startswith("https://discord."):
            links.setText(links.text() + f" &nbsp;·&nbsp; <a href='{invite}'>Discord</a>")
        self.add(links)
        self.finish()

    def on_show(self):
        m = meminfo()
        du = shutil.disk_usage("/")
        used_ram = m["MemTotal"] - m["MemAvailable"]
        self.status.setText(
            f"<b>Devium {ui.devium_version()}</b> &nbsp; · &nbsp; Disk: {human(du.free)} free of {human(du.total)}"
            f" &nbsp; · &nbsp; Memory: {human(used_ram)} used of {human(m['MemTotal'])}")


# ---------------------------------------------------------------------------- App Manager
class AppsPage(Page):
    def __init__(self, win):
        super().__init__(T("App Manager"),
                         "Everything you installed, with how much disk it uses and how much memory it uses on "
                         "average while running (measured in the background every 10 minutes). Devium's own "
                         "system packages are not listed, so you can't break anything here.")
        self.search = QLineEdit()
        self.search.setPlaceholderText(T("Search") + "...")
        self.search.textChanged.connect(self.filter)
        self.add(row(self.search, button(T("Refresh"), self.load, icon="view-refresh"),
                     button("Add apps (Devium Setup)", lambda: ui.launch("devium-setup-wizard"), icon="list-add"),
                     stretch=False))
        self.tree = QTreeWidget()
        self.tree.setHeaderLabels([T("Name"), T("Size"), T("Average RAM"), T("Type")])
        self.tree.setRootIsDecorated(False)
        self.tree.setSortingEnabled(True)
        self.tree.setMinimumHeight(340)
        h = self.tree.header()
        h.setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        self.tree.itemSelectionChanged.connect(self.selected)
        self.add(self.tree)
        self.detail = self.add(label("", "subtitle"))
        self.rm = button(T("Remove"), self.remove, icon="edit-delete")
        self.rm.setEnabled(False)
        self.total = label("", "subtitle")
        self.add(row(self.rm, self.total))

    def on_show(self):
        if not self.loaded:
            self.loaded = True
            QTimer.singleShot(50, self.load)

    def load(self):
        QApplication.setOverrideCursor(Qt.CursorShape.WaitCursor)
        self.tree.clear()
        base = set(read("/usr/share/devium/install-packages.txt").split())
        ram = {}
        try:
            data = json.load(open(os.path.expanduser("~/.local/share/devium/ram-samples.json")))
            ram = {k: t / n for k, (t, n) in data.items() if n}
        except (OSError, ValueError):
            pass
        pkgs = [p for p in run(["pacman", "-Qeq"]).split() if p not in base]
        total = 0
        if pkgs:
            info = run(["pacman", "-Qi", *pkgs], timeout=60)
            files = run(["pacman", "-Ql", *pkgs], timeout=60)
            exes = {}
            for line in files.splitlines():
                pkg, _, path = line.partition(" ")
                if path.startswith(("/usr/bin/", "/opt/")) and not path.endswith("/"):
                    exes.setdefault(pkg, set()).add(os.path.basename(path))
            for block in info.strip().split("\n\n"):
                f = dict(re.findall(r"^([A-Za-z ]+?)\s*: (.*)$", block, re.M))
                name = f.get("Name", "")
                size = self.parse_size(f.get("Installed Size", "0 B"))
                total += size
                r = [ram[e] for e in exes.get(name, ()) if e in ram]
                self.add_row(name, f.get("Description", ""), size, max(r) if r else None, "Package", name)
        for line in run(["flatpak", "list", "--app", "--columns=application,name,size"]).splitlines():
            parts = line.split("\t")
            if len(parts) < 3:
                continue
            app, name, size = parts[0], parts[1], self.parse_size(parts[2].replace("\xa0", " "))
            total += size
            guess = app.split(".")[-1].lower()
            r = [v for k, v in ram.items() if k.lower() == guess]
            self.add_row(name, app, size, r[0] if r else None, "Flatpak", app)
        self.tree.sortByColumn(1, Qt.SortOrder.DescendingOrder)
        self.total.setText(f"{self.tree.topLevelItemCount()} apps, {human(total)} in total")
        QApplication.restoreOverrideCursor()

    @staticmethod
    def parse_size(text):
        m = re.match(r"([\d.,]+)\s*([KMGT]?i?B|bytes)?", text.strip())
        if not m:
            return 0
        n = float(m.group(1).replace(",", "."))
        unit = (m.group(2) or "B")[0].upper()
        return int(n * {"B": 1, "K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}.get(unit, 1))

    def add_row(self, name, desc, size, ram, kind, ident):
        it = QTreeWidgetItem([name, human(size), human(ram) if ram else T("not measured yet"), kind])
        it.setData(1, Qt.ItemDataRole.UserRole, size)
        it.setData(0, Qt.ItemDataRole.UserRole, (kind, ident, desc))
        it.setToolTip(0, desc)
        self.tree.addTopLevelItem(it)

    def filter(self, text):
        text = text.lower()
        for i in range(self.tree.topLevelItemCount()):
            it = self.tree.topLevelItem(i)
            desc = it.data(0, Qt.ItemDataRole.UserRole)[2]
            it.setHidden(bool(text) and text not in it.text(0).lower() and text not in desc.lower())

    def selected(self):
        items = self.tree.selectedItems()
        self.rm.setEnabled(bool(items))
        if items:
            kind, ident, desc = items[0].data(0, Qt.ItemDataRole.UserRole)
            self.detail.setText(f"{ident}: {desc}")

    def remove(self):
        it = self.tree.selectedItems()[0]
        kind, ident, _ = it.data(0, Qt.ItemDataRole.UserRole)
        if QMessageBox.question(self, T("Remove"), f"Remove {it.text(0)} and free {it.text(1)}?") \
                != QMessageBox.StandardButton.Yes:
            return
        args = ["remove", ident] if kind == "Package" else ["remove-flatpak", ident]
        root(self, f"{T('Remove')} {it.text(0)}", *args, done=lambda code: code == 0 and self.load())


# ---------------------------------------------------------------------------- Updates (Safe Updates)
class UpdatesPage(Page):
    def __init__(self, win):
        super().__init__(T("Updates"),
                         "Safe Updates: Devium makes a restore point before every update (when Timeshift is set "
                         "up), remembers the old versions so you can undo, and shows Arch Linux news first - "
                         "sometimes an update needs you to do something by hand.")
        self.news = self.add(label(T("Arch Linux news") + "...", rich=True))
        self.add(row(button(T("Install updates"), lambda: ui.launch("devium-update-manager"), True,
                            "system-software-update"),
                     button(T("Undo last update"), self.undo, icon="edit-undo"),
                     button("Make a restore point", lambda: root(self, "Restore point", "snapshot"),
                            icon="document-save")))
        self.auto = QCheckBox(T("Automatic updates") + " (daily, on mains power, restore point first)")
        self.auto.setChecked(run(["systemctl", "is-enabled", "devium-autoupdate.timer"]).strip() == "enabled")
        self.auto.toggled.connect(self.toggle_auto)
        self.add(card(self.auto, label(
            "Arch Linux has no separate \"security only\" updates: every fix comes with the normal updates. "
            "So automatic updates install everything, quietly, once a day. You can undo the last one here.",
            "subtitle")))
        self.finish()

    def on_show(self):
        if self.loaded:
            return
        self.loaded = True
        self.proc = QProcess(self)
        self.proc.finished.connect(self.got_news)
        self.proc.start("curl", ["-fsL", "--max-time", "15", "https://archlinux.org/feeds/news/"])

    def last_update(self):
        last = 0
        try:
            for line in open("/var/log/pacman.log", errors="replace"):
                if "starting full system upgrade" in line:
                    last = line[1:20]
        except OSError:
            pass
        return str(last) if last else ""

    def got_news(self, code, _s):
        import xml.etree.ElementTree as ET
        from email.utils import parsedate_to_datetime
        raw = bytes(self.proc.readAllStandardOutput())
        if code != 0 or not raw:
            self.news.setText("<b>" + T("Arch Linux news") + "</b><br>Could not load the news (offline?).")
            return
        last = self.last_update()
        html = "<b>" + T("Arch Linux news") + "</b><br>"
        warn = False
        try:
            for item in ET.fromstring(raw).iter("item"):
                title = item.findtext("title", "")
                link = item.findtext("link", "")
                when = parsedate_to_datetime(item.findtext("pubDate", ""))
                new = last and when.strftime("%Y-%m-%dT%H:%M:%S") > last
                warn |= bool(new)
                colour = "#e8cd96" if new else "palette(text)"
                html += (f"<span style='color:{colour}'>{when:%d %b %Y}{' NEW' if new else ''}</span> "
                         f"<a href='{link}'>{title}</a><br>")
                if html.count("<br>") > 6:
                    break
        except Exception:
            html += "Could not read the news."
        if warn:
            html += ("<br><span style='color:#e8cd96'><b>There is news since your last update. Read it before "
                     "updating: it may need a manual step.</b></span>")
        self.news.setText(html)

    def undo(self):
        log = read("/var/lib/devium/last-update.txt")
        if not log:
            QMessageBox.information(self, T("Undo last update"), "There is no update to undo yet.")
            return
        n = len(log.splitlines())
        if QMessageBox.question(self, T("Undo last update"),
                                f"Put back the old versions of {n} packages from the last update?") \
                == QMessageBox.StandardButton.Yes:
            root(self, T("Undo last update"), "undo-update")

    def toggle_auto(self, on):
        r = subprocess.run(["pkexec", HELPER, "autoupdate", "on" if on else "off"])
        if r.returncode != 0:
            self.auto.blockSignals(True)
            self.auto.setChecked(not on)
            self.auto.blockSignals(False)


# ---------------------------------------------------------------------------- Speed and memory
def apply_lowram_user(on):
    """The desktop side of Low-RAM mode (no password needed)."""
    subprocess.run(["/usr/lib/devium/lowram-user", "on" if on else "off"])


class SpeedPage(Page):
    def __init__(self, win):
        super().__init__(T("Speed and memory"),
                         "See what is using your memory, and make Devium lighter. Every change here is safe and "
                         "can be switched back.")
        self.mem = self.add(label("", rich=True))
        self.top = QPlainTextEdit()
        self.top.setReadOnly(True)
        self.top.setFont(QFont("monospace"))
        self.top.setMaximumHeight(220)
        self.add(self.top)
        self.add(row(button(T("Refresh"), self.on_show, icon="view-refresh"),
                     button("System Monitor", lambda: ui.launch("plasma-systemmonitor"), icon="utilities-system-monitor")))
        self.add(card(label(T("Make it faster"), "h2"),
                      label("Turns on compressed memory (zram), weekly SSD trim, a faster boot and cleans old logs "
                            "and caches.", "subtitle"),
                      row(button(T("Make it faster"), lambda: root(self, T("Make it faster"), "faster"), True,
                                 "speedometer"))))
        gb = ram_gb()
        self.low = QCheckBox(T("Low-RAM mode"))
        self.low.setChecked(os.path.exists("/etc/devium/low-ram"))
        self.low.toggled.connect(self.toggle_low)
        rec = ("Recommended for this computer" if gb <= 4.5 else "Not needed on this computer") + f" ({gb:.0f} GB RAM)"
        self.add(card(self.low, label("Turns off animations, blur and file indexing, stops background app-store "
                                      "checks, and uses compressed memory. " + rec + ".", "subtitle")))
        self.finish()

    def on_show(self):
        m = meminfo()
        used = m["MemTotal"] - m["MemAvailable"]
        pct = used * 100 / m["MemTotal"]
        colour = "#e89ca0" if pct > 90 else "#e8cd96" if pct > 70 else ui.ACCENT
        self.mem.setText(f"<b>Memory:</b> <span style='color:{colour}'>{human(used)} used</span> of "
                         f"{human(m['MemTotal'])} ({pct:.0f}%)")
        self.top.setPlainText(run(["/usr/local/bin/devium-ram"]).strip("\n"))

    def toggle_low(self, on):
        r = subprocess.run(["pkexec", HELPER, "lowram", "on" if on else "off"])
        if r.returncode == 0:
            apply_lowram_user(on)
        else:
            self.low.blockSignals(True)
            self.low.setChecked(not on)
            self.low.blockSignals(False)


# ---------------------------------------------------------------------------- Battery
class BatteryPage(Page):
    def __init__(self, win):
        super().__init__(T("Battery"),
                         "Battery health and a charge limit. Stopping at 80% makes a laptop battery that's "
                         "always plugged in last years longer.")
        self.info = self.add(label("", rich=True))
        self.slider = QSlider(Qt.Orientation.Horizontal)
        self.slider.setRange(50, 100)
        self.slider.setSingleStep(5)
        self.slider.setPageStep(5)
        self.value = label("", wrap=False)
        self.slider.valueChanged.connect(lambda v: self.value.setText(f"{v}%" if v < 100 else "No limit"))
        self.apply = button("Apply", self.set_limit, True)
        self.limit_card = self.add(card(label(T("Charge limit"), "h2"),
                                        row(self.slider, self.value, self.apply, stretch=False),
                                        label("Not every laptop supports this. ThinkPad, ASUS, Dell, Lenovo "
                                              "and Framework usually do.", "subtitle")))
        self.finish()

    def on_show(self):
        bats = sorted(glob.glob("/sys/class/power_supply/BAT*"))
        if not bats:
            self.info.setText("No battery found - this looks like a desktop computer or a virtual machine.")
            self.limit_card.hide()
            return
        html = ""
        writable = False
        for b in bats:
            full = read(f"{b}/energy_full") or read(f"{b}/charge_full")
            design = read(f"{b}/energy_full_design") or read(f"{b}/charge_full_design")
            health = f"{int(full) * 100 / int(design):.0f}%" if full and design and int(design) else "unknown"
            html += (f"<b>{os.path.basename(b)}</b>: {read(b + '/capacity', '?')}% charged, "
                     f"{read(b + '/status', '').lower()} &nbsp;·&nbsp; <b>{T('Battery health')}:</b> {health}")
            cycles = read(f"{b}/cycle_count")
            if cycles and cycles != "0":
                html += f" &nbsp;·&nbsp; {cycles} charge cycles"
            html += "<br>"
            limit = read(f"{b}/charge_control_end_threshold")
            if limit:
                writable = True
                self.slider.setValue(int(limit))
        self.info.setText(html)
        self.limit_card.setEnabled(writable)
        if not writable:
            self.value.setText("Not supported on this laptop")

    def set_limit(self):
        root(self, T("Charge limit"), "charge-limit", str(self.slider.value()))


# ---------------------------------------------------------------------------- Privacy
class PrivacyPage(Page):
    def __init__(self, win):
        super().__init__(T("Privacy"),
                         "Devium collects nothing about you and sends nothing anywhere. A problem report is only "
                         "sent when you press Send, and you see exactly what goes in it.")
        self.boxes = {}
        items = [
            ("firewall", T("Firewall"), "Blocks incoming connections you didn't ask for.",
             lambda: run(["systemctl", "is-active", "ufw"]).strip() == "active"),
            ("mac", "Random Wi-Fi address", "Networks and shops can't track your laptop by its hardware address.",
             lambda: os.path.exists("/etc/NetworkManager/conf.d/90-devium-mac.conf")),
            ("location", "Location services", "Lets apps ask where you are (used for night colour and weather).",
             lambda: run(["systemctl", "is-enabled", "geoclue"]).strip() != "masked"),
        ]
        for key, name, desc, state in items:
            box = QCheckBox(name)
            box.setChecked(state())
            box.toggled.connect(lambda on, k=key, b=box: self.toggle(k, on, b))
            self.add(card(box, label(desc, "subtitle")))
        if KDE:
            self.recent = QCheckBox("Remember recently opened files")
            self.recent.setChecked(kread("kdeglobals", "RecentDocuments", "UseRecent", "true") != "false")
            self.recent.toggled.connect(lambda on: kwrite("kdeglobals", "RecentDocuments", "UseRecent",
                                                          "true" if on else "false"))
            self.add(card(self.recent, row(button("Clear the list now", self.clear_recent))))
            kwrite("PlasmaUserFeedback", "Global", "FeedbackLevel", 0)   # KDE feedback: off
        self.finish()

    def toggle(self, key, on, box):
        if subprocess.run(["pkexec", HELPER, "privacy", key, "on" if on else "off"]).returncode != 0:
            box.blockSignals(True)
            box.setChecked(not on)
            box.blockSignals(False)

    def clear_recent(self):
        for p in glob.glob(os.path.expanduser("~/.local/share/RecentDocuments/*")) + \
                [os.path.expanduser("~/.local/share/recently-used.xbel")]:
            try:
                os.remove(p)
            except OSError:
                pass
        QMessageBox.information(self, T("Privacy"), "Recent files cleared.")


