# ---------------------------------------------------------------------------- Get help + Report a problem
def system_summary():
    m = meminfo()
    gpu = ", ".join(l.split(": ", 1)[-1] for l in run(["lspci"]).splitlines() if " VGA " in l or "3D controller" in l)
    return "\n".join([
        f"Devium {ui.devium_version()} ({ui.edition()})",
        f"Kernel {os.uname().release}",
        f"RAM {human(m['MemTotal'])}, disk free {human(shutil.disk_usage('/').free)}",
        f"CPU {next((l.split(':', 1)[1].strip() for l in read('/proc/cpuinfo').splitlines() if l.startswith('model name')), '?')}",
        f"GPU {gpu or '?'}",
        f"Desktop {os.environ.get('XDG_CURRENT_DESKTOP', '?')} ({os.environ.get('XDG_SESSION_TYPE', '?')})",
        f"Virtual machine: {run(['systemd-detect-virt']).strip() or 'no'}",
    ])


class ReportDialog(QDialog):
    LIMIT_FILE = os.path.expanduser("~/.cache/devium/last-report")

    def __init__(self, parent):
        super().__init__(parent)
        self.setWindowTitle(T("Report a problem"))
        self.resize(620, 560)
        l = QVBoxLayout(self)
        l.addWidget(label("Tell the Devium team what went wrong. Your report goes to the Devium Discord, where "
                          "the team reads it.", "subtitle"))
        f = QFormLayout()
        self.kind = QComboBox()
        self.kind.addItems(["Bug", "Installer", "Devium Setup", "Looks / theme", "Hardware / drivers",
                            "Idea / request", "Other"])
        self.title = QLineEdit()
        self.title.setPlaceholderText("e.g. Wi-Fi stops after sleep")
        self.title.setMaxLength(120)
        self.body = QTextEdit()
        self.body.setPlaceholderText("What happened? What did you expect? Steps to make it happen again.")
        self.contact = QLineEdit()
        self.contact.setPlaceholderText("Optional: your Discord name, so we can reply")
        self.contact.setMaxLength(60)
        f.addRow(T("Type"), self.kind)
        f.addRow("Title", self.title)
        f.addRow("Details", self.body)
        f.addRow("Contact", self.contact)
        l.addLayout(f)
        self.sysinfo = QCheckBox("Add computer details (Devium version, RAM, graphics card - nothing personal)")
        self.sysinfo.setChecked(True)
        self.errors = QCheckBox("Add recent error messages")
        l.addWidget(self.sysinfo)
        l.addWidget(self.errors)
        self.preview = QPlainTextEdit()
        self.preview.setReadOnly(True)
        self.preview.setMaximumHeight(110)
        self.preview.setFont(QFont("monospace"))
        l.addWidget(label("Exactly what will be sent with your report:", "subtitle"))
        l.addWidget(self.preview)
        for w in (self.sysinfo, self.errors):
            w.toggled.connect(self.update_preview)
        self.send_btn = button(T("Send"), self.send, True, "mail-send")
        l.addLayout(row(self.send_btn, button(T("Cancel"), self.reject)))
        self.update_preview()

    def extras(self):
        text = ""
        if self.sysinfo.isChecked():
            text += system_summary()
        if self.errors.isChecked():
            errs = run(["journalctl", "-b", "-p", "err", "-n", "15", "--no-pager", "-o", "cat"])
            # strip anything that looks like an IP or MAC address, or an email
            errs = re.sub(r"\b\d{1,3}(\.\d{1,3}){3}\b", "<ip>", errs)
            errs = re.sub(r"\b([0-9a-f]{2}:){5}[0-9a-f]{2}\b", "<mac>", errs, flags=re.I)
            errs = re.sub(r"\S+@\S+\.\S+", "<email>", errs)
            errs = errs.replace(os.path.expanduser("~"), "~")
            text += "\n\nRecent errors:\n" + (errs.strip() or "(none)")
        return text

    def update_preview(self):
        self.preview.setPlainText(self.extras() or "(nothing extra)")

    def send(self):
        title, body = self.title.text().strip(), self.body.toPlainText().strip()
        if len(title) < 4 or len(body) < 10:
            QMessageBox.information(self, T("Report a problem"), "Please add a title and a few words about it.")
            return
        try:
            if time.time() - os.path.getmtime(self.LIMIT_FILE) < 300:
                QMessageBox.information(self, T("Report a problem"),
                                        "You sent a report a moment ago. Please wait a few minutes.")
                return
        except OSError:
            pass
        url = read(WEBHOOK_FILE)
        if not url.startswith("https://discord.com/api/webhooks/"):
            # No Discord set up in this build: use GitHub instead
            import urllib.parse
            q = urllib.parse.urlencode({"title": f"[{self.kind.currentText()}] {title}",
                                        "body": body + "\n\n```\n" + self.extras() + "\n```"})
            ui.open_link(f"{REPO}/issues/new?{q}", self)
            self.accept()
            return

        def clean(s):   # no pings, no fake mentions
            return s.replace("@", "@​")
        fields = [{"name": "Type", "value": self.kind.currentText(), "inline": True},
                  {"name": "Version", "value": ui.devium_version(), "inline": True}]
        if self.contact.text().strip():
            fields.append({"name": "Contact", "value": clean(self.contact.text().strip()), "inline": True})
        extra = self.extras()
        desc = clean(body)[:3000]
        if extra:
            desc += "\n```\n" + clean(extra)[:900] + "\n```"
        payload = {"username": "Devium Reports", "allowed_mentions": {"parse": []},
                   "embeds": [{"title": clean(f"[{self.kind.currentText()}] {title}")[:250],
                               "description": desc, "color": 0x8FB4D8, "fields": fields,
                               "footer": {"text": "Sent from Devium Tools"}}]}
        req = urllib.request.Request(url, data=json.dumps(payload).encode(), method="POST",
                                     headers={"Content-Type": "application/json", "User-Agent": "DeviumTools/1.0"})
        try:
            urllib.request.urlopen(req, timeout=15)
        except Exception as e:
            QMessageBox.warning(self, T("Report a problem"),
                                f"Could not send the report ({e}). Check your internet, or report it on GitHub.")
            return
        os.makedirs(os.path.dirname(self.LIMIT_FILE), exist_ok=True)
        open(self.LIMIT_FILE, "w").close()
        QMessageBox.information(self, T("Report a problem"), "Thanks! Your report was sent to the Devium team.")
        self.accept()


class HelpPage(Page):
    def __init__(self, win):
        super().__init__(T("Get help"), "Fix common problems yourself, look up commands, or tell the Devium team.")
        self.add(card(label(T("Fix common problems"), "h2"),
                      label("Checks disk space, internet, failed services, the package manager, package keys, "
                            "Flatpak and damaged packages - and repairs what it can.", "subtitle"),
                      row(button(T("Fix common problems"), lambda: in_terminal("support fix"), True, "tools-wizard"))))
        self.add(card(label(T("Open Support"), "h2"),
                      label("Over 100 helpful commands, grouped by topic. In a terminal: support, support <topic> or "
                            "support <word> to search.", "subtitle"),
                      row(button(T("Open Support"), lambda: in_terminal("support | less -R"), icon="utilities-terminal"),
                          button("Guide", lambda: ui.open_link(f"{REPO}/blob/main/docs/GUIDE.md", self),
                                 icon="help-contents"))))
        self.add(card(label(T("Report a problem"), "h2"),
                      label("Something broken, or an idea? Send it to the Devium team.", "subtitle"),
                      row(button(T("Report a problem"), lambda: ReportDialog(self).exec(), True, "tools-report-bug"),
                          button("Ask on Discord", lambda: ui.open_link(ui.DISCORD, self), icon="internet-chat"))))
        self.finish()


# ---------------------------------------------------------------------------- window
PAGES = [
    ("home", T("Home"), "go-home", HomePage),
    ("apps", T("App Manager"), "view-list-details", AppsPage),
    ("updates", T("Updates"), "system-software-update", UpdatesPage),
    ("speed", T("Speed and memory"), "speedometer", SpeedPage),
    ("battery", T("Battery"), "battery", BatteryPage),
    ("privacy", T("Privacy"), "security-high", PrivacyPage),
    ("printers", T("Printers and scanners"), "printer", PrintersPage),
    ("developer", T("Developer"), "code-context", DeveloperPage),
    ("windows", T("Coming from Windows"), "computer", WindowsPage),
    ("accessibility", T("Accessibility"), "preferences-desktop-accessibility", AccessibilityPage),
    ("language", T("Language"), "preferences-desktop-locale", LanguagePage),
    ("help", T("Get help"), "help-browser", HelpPage),
]


class Tools(QWidget):
    def __init__(self, start="home"):
        super().__init__()
        self.setWindowTitle(T("Devium Tools"))
        self.setWindowIcon(ui.app_icon())
        self.resize(1000, 680)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(8, 8, 8, 8)
        self.nav = QListWidget()
        self.nav.setObjectName("nav")
        self.nav.setFixedWidth(230)
        self.stack = QStackedWidget()
        self.pages = {}
        for key, name, icon, cls in PAGES:
            self.nav.addItem(QListWidgetItem(QIcon.fromTheme(icon), name))
            page = cls(self)
            self.pages[key] = page
            self.stack.addWidget(page)
        self.nav.currentRowChanged.connect(self.show_page)
        lay.addWidget(self.nav)
        lay.addWidget(self.stack, 1)
        if start == "report":
            self.go("help")
            QTimer.singleShot(200, lambda: ReportDialog(self).exec())
        else:
            self.go(start if start in self.pages else "home")

    def go(self, key):
        self.nav.setCurrentRow(list(self.pages).index(key))

    def show_page(self, i):
        self.stack.setCurrentIndex(i)
        self.stack.currentWidget().on_show()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Devium Tools")
    app.setDesktopFileName("devium-tools")
    ui.style_app(app)
    w = Tools(sys.argv[1] if len(sys.argv) > 1 else "home")
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
