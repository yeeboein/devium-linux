# ---------------------------------------------------------------------------- Developer
class GitDialog(QDialog):
    def __init__(self, parent):
        super().__init__(parent)
        self.setWindowTitle(T("Connect Git and GitHub"))
        self.resize(560, 420)
        l = QVBoxLayout(self)
        l.addWidget(label("1. Your name and email go on every commit you make.", "h2"))
        f = QFormLayout()
        self.name = QLineEdit(run(["git", "config", "--global", "user.name"]).strip())
        self.email = QLineEdit(run(["git", "config", "--global", "user.email"]).strip())
        self.email.setPlaceholderText("Use your GitHub email, or the private one from GitHub > Settings > Emails")
        f.addRow(T("Name"), self.name)
        f.addRow("Email", self.email)
        l.addLayout(f)
        l.addWidget(label("2. A key lets you push to GitHub without typing a password.", "h2"))
        self.key_info = label("", "subtitle")
        l.addWidget(self.key_info)
        l.addLayout(row(button("Save and make my key", self.save, True),
                        button("Copy key and open GitHub", self.copy_open, icon="edit-copy")))
        l.addWidget(label("3. On GitHub, paste the key into the box and press \"Add SSH key\". Then:", "h2"))
        self.test_out = label("", "subtitle")
        l.addLayout(row(button("Test the connection", self.test, icon="network-connect")))
        l.addWidget(self.test_out)
        l.addStretch(1)
        l.addLayout(row(button(T("Close"), self.accept)))
        self.key = os.path.expanduser("~/.ssh/id_ed25519")
        self.refresh()

    def refresh(self):
        self.key_info.setText("You already have a key." if os.path.exists(self.key + ".pub")
                              else "You don't have a key yet.")

    def save(self):
        if self.name.text().strip():
            subprocess.run(["git", "config", "--global", "user.name", self.name.text().strip()])
        if self.email.text().strip():
            subprocess.run(["git", "config", "--global", "user.email", self.email.text().strip()])
        subprocess.run(["git", "config", "--global", "init.defaultBranch", "main"])
        if not os.path.exists(self.key):
            os.makedirs(os.path.dirname(self.key), mode=0o700, exist_ok=True)
            subprocess.run(["ssh-keygen", "-t", "ed25519", "-N", "", "-C", self.email.text().strip() or "devium",
                            "-f", self.key], capture_output=True)
        self.refresh()

    def copy_open(self):
        if not os.path.exists(self.key + ".pub"):
            self.save()
        QGuiApplication.clipboard().setText(read(self.key + ".pub"))
        ui.open_link("https://github.com/settings/ssh/new", self)

    def test(self):
        r = subprocess.run(["ssh", "-T", "-o", "StrictHostKeyChecking=accept-new", "-o", "BatchMode=yes",
                            "git@github.com"], capture_output=True, text=True, timeout=20)
        m = re.search(r"Hi (\S+)!", r.stderr + r.stdout)
        self.test_out.setText(f"Connected to GitHub as {m.group(1)}." if m else
                              "Not connected yet. Did you add the key on GitHub?")


class DeveloperPage(Page):
    def __init__(self, win):
        super().__init__(T("Developer"), "Connect to GitHub, and run apps in containers with Docker or Podman.")
        self.add(card(label(T("Connect Git and GitHub"), "h2"),
                      label("Set your name and email, make an SSH key, add it to GitHub and test it - step by step.",
                            "subtitle"),
                      row(button(T("Connect Git and GitHub"), lambda: GitDialog(self).exec(), True, "git"))))
        self.engine = label("", "subtitle")
        self.tree = QTreeWidget()
        self.tree.setHeaderLabels([T("Name"), "Image", "Status"])
        self.tree.setRootIsDecorated(False)
        self.tree.setMaximumHeight(200)
        self.tree.header().setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        user = os.environ.get("USER") or run(["id", "-un"]).strip()
        self.add(card(label(T("Containers"), "h2"), self.engine, self.tree,
                      row(button("Install Docker", lambda: root(self, "Docker", "containers", user, "docker",
                                                                done=lambda c: self.on_show())),
                          button("Install Podman", lambda: root(self, "Podman", "containers", user, "podman",
                                                                done=lambda c: self.on_show())),
                          button("Stop selected", self.stop, icon="media-playback-stop"),
                          button(T("Refresh"), self.on_show, icon="view-refresh"))))
        self.finish()

    def tool(self):
        return "docker" if shutil.which("docker") else "podman" if shutil.which("podman") else None

    def on_show(self):
        self.tree.clear()
        t = self.tool()
        if not t:
            self.engine.setText("No container engine yet. Docker is the most common; Podman needs no background "
                                "service and no root.")
            return
        out = run([t, "ps", "-a", "--format", "{{.Names}}\t{{.Image}}\t{{.Status}}"])
        if not out and t == "docker":
            self.engine.setText("Docker is installed. If nothing shows, log out and in again (to join the docker "
                                "group).")
        else:
            self.engine.setText(f"Using {t}. Containers on this computer:")
        for line in out.splitlines():
            self.tree.addTopLevelItem(QTreeWidgetItem(line.split("\t")))

    def stop(self):
        t = self.tool()
        for it in self.tree.selectedItems():
            subprocess.run([t, "stop", it.text(0)], capture_output=True)
        self.on_show()


# ---------------------------------------------------------------------------- Coming from Windows
WINDOWS_APPS = [
    ("File Explorer", "Dolphin (Files)", "Meta+E"),
    ("Start menu", "App launcher", "Meta"),
    ("Task Manager", "System Monitor", "Ctrl+Esc"),
    ("Control Panel / Settings", "System Settings", ""),
    ("Microsoft Store", "Discover / Devium Setup", ""),
    ("Notepad", "Kate", ""),
    ("Command Prompt / PowerShell", "Konsole (terminal)", "Ctrl+Alt+T"),
    ("Snipping Tool", "Spectacle", "Print / Meta+Shift+S"),
    ("Microsoft Office", "LibreOffice (Devium Setup > Packages)", ""),
    ("Photos", "Gwenview", ""),
    ("Paint", "KolourPaint, or Krita / GIMP", ""),
    ("Windows Update", "Update Manager", "Meta+U"),
    ("Lock the screen (Win+L)", "Lock the screen", "Meta+L"),
    ("Show the desktop (Win+D)", "Peek at the desktop", "Meta+D"),
    ("Close a window (Alt+F4)", "Close a window", "Alt+F4"),
]


class WindowsPage(Page):
    def __init__(self, win):
        super().__init__(T("Coming from Windows"),
                         "Where to find the things you know, the same shortcuts, and a way to copy your files "
                         "over from a Windows drive.")
        t = QTreeWidget()
        t.setHeaderLabels(["On Windows", "On Devium", "Shortcut"])
        t.setRootIsDecorated(False)
        for r in WINDOWS_APPS:
            t.addTopLevelItem(QTreeWidgetItem(list(r)))
        t.header().setSectionResizeMode(QHeaderView.ResizeMode.ResizeToContents)
        t.setMinimumHeight(330)
        self.add(t)
        self.drives = QComboBox()
        self.users = QComboBox()
        self.add(card(label("Copy my files from Windows", "h2"),
                      label("Copies Documents, Pictures, Music, Videos, Desktop and Downloads from a Windows drive "
                            "on this computer into the same folders here (in a \"From Windows\" folder). Nothing "
                            "on Windows is changed.", "subtitle"),
                      row(QLabel("Drive:"), self.drives, button("Look for Windows", self.find_drives)),
                      row(QLabel("User:"), self.users, button("Copy my files", self.copy, True))))
        self.finish()

    def find_drives(self):
        self.drives.clear()
        try:
            data = json.loads(run(["lsblk", "-J", "-p", "-o", "NAME,FSTYPE,SIZE,LABEL,MOUNTPOINT"]))
        except ValueError:
            return
        def walk(devs):
            for d in devs:
                if d.get("fstype") == "ntfs":
                    self.drives.addItem(f"{d['name']}  {d.get('label') or ''}  {d.get('size')}", d)
                walk(d.get("children", []))
        walk(data.get("blockdevices", []))
        if not self.drives.count():
            QMessageBox.information(self, "Windows", "No Windows drive found on this computer.")
            return
        self.drives.currentIndexChanged.connect(self.find_users)
        self.find_users()

    def mountpoint(self):
        d = self.drives.currentData()
        if not d:
            return None
        if d.get("mountpoint"):
            return d["mountpoint"]
        out = run(["udisksctl", "mount", "-b", d["name"], "-o", "ro"], timeout=30)
        m = re.search(r" at (.+?)\.?$", out.strip())
        if m:
            d["mountpoint"] = m.group(1)
            return d["mountpoint"]
        QMessageBox.warning(self, "Windows", "Could not open that drive. If Windows uses Fast Startup or "
                                             "BitLocker, turn it off in Windows first.")
        return None

    def find_users(self):
        self.users.clear()
        mp = self.mountpoint()
        if not mp:
            return
        for u in sorted(glob.glob(os.path.join(mp, "Users", "*"))):
            if os.path.basename(u) not in ("Public", "Default", "Default User", "All Users") and os.path.isdir(u):
                self.users.addItem(os.path.basename(u), u)

    def copy(self):
        src = self.users.currentData()
        if not src:
            return
        parts = []
        for folder in ("Documents", "Pictures", "Music", "Videos", "Desktop", "Downloads"):
            dest = os.path.expanduser(f"~/{folder}/From Windows")
            parts.append(f"if [ -d '{src}/{folder}' ]; then echo '### Copying {folder}'; mkdir -p '{dest}' && "
                         f"cp -rnv --no-preserve=mode,ownership '{src}/{folder}/.' '{dest}/' 2>&1 | tail -n 3; fi")
        RunDialog(self, "Copy my files from Windows", "bash", ["-c", "; ".join(parts) + "; echo '### Done'"]).exec()


# ---------------------------------------------------------------------------- Accessibility
class AccessibilityPage(Page):
    def __init__(self, win):
        super().__init__(T("Accessibility"), "Make Devium easier to see, hear and use.")
        self.opts = []
        dpi = kread("kcmfonts", "General", "forceFontDPI", "0") if KDE else \
            run(["xfconf-query", "-c", "xsettings", "-p", "/Xft/DPI"]).strip()
        self.make(T("Larger text"), "Makes all text and icons about 25% bigger (log out and in to see it everywhere).",
                  dpi not in ("", "0", "96", "-1"), self.big_text)
        self.make(T("Screen reader"), "Orca reads out what's on the screen. Turn it on or off any time with "
                  "Meta+Alt+S.", kread("kaccessrc", "ScreenReader", "Enabled", "false") == "true", self.reader)
        if KDE:
            self.make(T("Zoom"), "Zoom in with Meta and + (plus), out with Meta and - (minus).",
                      kread("kwinrc", "Plugins", "zoomEnabled", "false") == "true", self.zoom)
            self.make(T("Sticky keys"), "Press shortcut keys one after another instead of together.",
                      kread("kaccessrc", "Keyboard", "StickyKeys", "false") == "true", self.sticky)
            self.make(T("Reduce motion"), "Turns off animations.",
                      kread("kdeglobals", "KDE", "AnimationDurationFactor", "1") == "0", self.motion)
        self.finish()

    def make(self, name, desc, state, fn):
        b = QCheckBox(name)
        b.setChecked(state)
        b.toggled.connect(fn)
        self.add(card(b, label(desc, "subtitle")))

    def big_text(self, on):
        if KDE:
            kwrite("kcmfonts", "General", "forceFontDPI", 120 if on else 0)
            kwrite("kdeglobals", "KScreen", "ScaleFactor", 1.25 if on else 1)
        else:
            subprocess.run(["xfconf-query", "-c", "xsettings", "-p", "/Xft/DPI", "-n", "-t", "int",
                            "-s", "120" if on else "96"])

    def reader(self, on):
        if on and not shutil.which("orca"):
            root(self, T("Screen reader"), "install", "orca", "espeak-ng")
        kwrite("kaccessrc", "ScreenReader", "Enabled", "true" if on else "false")
        if on and shutil.which("orca"):
            subprocess.Popen(["orca"], start_new_session=True)
        elif not on:
            subprocess.run(["pkill", "-x", "orca"])

    def zoom(self, on):
        kwrite("kwinrc", "Plugins", "zoomEnabled", "true" if on else "false")
        kwin_reconfigure()

    def sticky(self, on):
        kwrite("kaccessrc", "Keyboard", "StickyKeys", "true" if on else "false")
        subprocess.run("qdbus6 org.kde.kaccess /kaccess reloadConfig", shell=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def motion(self, on):
        kwrite("kdeglobals", "KDE", "AnimationDurationFactor", 0 if on else 1)


