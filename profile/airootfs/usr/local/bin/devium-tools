#!/usr/bin/env python3
"""Devium Tools: App Manager, updates, speed, battery, privacy, printers, developer tools,
help for people coming from Windows, accessibility, language and support - in one app.

  devium-tools            open on the Home page (Devium Hub)
  devium-tools <page>     open a page: apps, updates, speed, battery, privacy, printers,
                          developer, windows, accessibility, language, help, report
"""
import glob
