#!/usr/bin/env python3
"""snip - your little library of code you reuse. Also in Devium Spotlight: type "snip docker".

  snip                       list your snippets
  snip NAME                  print a snippet (and copy it to the clipboard)
  snip add NAME [TEXT]       save TEXT, or what you pipe in:  cat Dockerfile | snip add dockerfile
  snip edit NAME             edit a snippet in your editor
  snip rm NAME               delete a snippet
  snip find WORD             search names and contents
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile

FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "devium", "snippets.json")

STARTERS = {
    "gitignore-python": ".venv/\n__pycache__/\n*.pyc\n.env\n.pytest_cache/\n",
    "docker-postgres": "docker run -d --name pg -e POSTGRES_PASSWORD=devium -p 5432:5432 postgres:17",
    "python-main": 'def main() -> None:\n    ...\n\n\nif __name__ == "__main__":\n    main()\n',
    "html-page": '<!doctype html>\n<html lang="en">\n<head>\n  <meta charset="utf-8">\n'
                 '  <meta name="viewport" content="width=device-width, initial-scale=1">\n  <title>Page</title>\n'
                 '</head>\n<body>\n\n</body>\n</html>\n',
    "git-undo-last-commit": "git reset --soft HEAD~1",
    "find-big-files": "du -ah . | sort -rh | head -20",
}


def load():
    try:
        with open(FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return dict(STARTERS)


def save(data):
    os.makedirs(os.path.dirname(FILE), exist_ok=True)
    tmp = FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1, sort_keys=True)
    os.replace(tmp, FILE)


def copy(text):
    for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "-b", "-i"]):
        if shutil.which(cmd[0]) and (os.environ.get("WAYLAND_DISPLAY") or cmd[0] != "wl-copy"):
            try:
                subprocess.run(cmd, input=text, text=True, timeout=3)
                return True
            except Exception:
                pass
    return False


def edit(text):
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or next(
        (e for e in ("nano", "nvim", "vim", "micro") if shutil.which(e)), "nano")
    with tempfile.NamedTemporaryFile("w+", suffix=".txt", delete=False) as f:
        f.write(text)
        path = f.name
    subprocess.run([editor, path])
    with open(path) as f:
        out = f.read()
    os.unlink(path)
    return out


def main():
    a = sys.argv[1:]
    data = load()
    if not a:
        if not data:
            print("No snippets yet. Save one: snip add NAME 'text'")
        width = max((len(k) for k in data), default=0)
        for k in sorted(data):
            first = data[k].strip().splitlines()[0] if data[k].strip() else ""
            print(f"  \033[38;2;150;178;208m{k:<{width}}\033[0m  \033[2m{first[:70]}\033[0m")
        return 0
    if a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if a[0] == "add" and len(a) >= 2:
        text = " ".join(a[2:]) if len(a) > 2 else (sys.stdin.read() if not sys.stdin.isatty() else edit(""))
        if not text.strip():
            print("Nothing to save.")
            return 1
        data[a[1]] = text
        save(data)
        print(f"Saved '{a[1]}'.")
        return 0
    if a[0] == "edit" and len(a) == 2:
        data[a[1]] = edit(data.get(a[1], ""))
        save(data)
        return 0
    if a[0] in ("rm", "del", "delete") and len(a) == 2:
        if data.pop(a[1], None) is None:
            print(f"No snippet called '{a[1]}'.")
            return 1
        save(data)
        print(f"Deleted '{a[1]}'.")
        return 0
    if a[0] == "find" and len(a) >= 2:
        w = " ".join(a[1:]).lower()
        for k in sorted(data):
            if w in k.lower() or w in data[k].lower():
                print(f"  {k}")
        return 0
    if a[0] == "--json":   # for Devium Spotlight / Devium Tools
        print(json.dumps(data))
        return 0
    name = a[0]
    if name not in data:
        close = [k for k in data if name.lower() in k.lower()]
        if len(close) == 1:
            name = close[0]
        else:
            print(f"No snippet called '{name}'." + (f" Did you mean: {', '.join(close)}?" if close else ""))
            return 1
    text = data[name]
    sys.stdout.write(text if text.endswith("\n") else text + "\n")
    if sys.stdout.isatty() and copy(text):
        print("\033[2m(copied to the clipboard)\033[0m", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
