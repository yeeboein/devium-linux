#!/usr/bin/env python3
"""Devium Backup: back up your files and settings to a USB drive, and move Devium to a new PC.

  devium-backup drives                  list USB drives / other disks you can back up to
  devium-backup backup  DRIVE_FOLDER    copy your home folder and app list to DRIVE_FOLDER/DeviumBackup
  devium-backup restore DRIVE_FOLDER    copy them back (never deletes anything on this computer)
  devium-backup export  FILE            save your apps, Devium Configure choices and settings to one file
  devium-backup import  FILE            put the settings back and reinstall the apps (asks for your password)

Devium Tools > Backup and move does all of this with buttons.
"""
import datetime
import io
import json
import os
import shutil
import socket
import subprocess
import sys
import tarfile

HOME = os.path.expanduser("~")
CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")))
HELPER = "/usr/lib/devium/devium-helper"

# never backed up: caches, trash, things that are rebuilt by themselves, and other disks
EXCLUDE = [".cache/", ".local/share/Trash/", ".local/share/baloo/", ".local/share/flatpak/repo/",
           ".var/app/*/cache/", "**/node_modules/", "**/__pycache__/", "**/.venv/", "**/target/debug/",
           ".local/share/Steam/steamapps/", ".steam/", "Downloads/*.iso", ".mozilla/firefox/*/cache2/",
           ".config/*/Cache/", ".config/*/Code Cache/", ".config/*/GPUCache/", ".gvfs/", "snap/"]

# settings that move to a new PC (small, and safe to copy between computers)
MOVE_FILES = [
    ".config/devium/", ".config/kdeglobals", ".config/kwinrc", ".config/kglobalshortcutsrc",
    ".config/plasma-org.kde.plasma.desktop-appletsrc", ".config/plasmashellrc", ".config/konsolerc",
    ".local/share/konsole/", ".config/dolphinrc", ".config/katerc", ".config/hypr/", ".config/waybar/",
    ".config/kitty/", ".config/xfce4/", ".config/gtk-3.0/settings.ini", ".config/gtk-4.0/settings.ini",
    ".config/Code/User/settings.json", ".config/Code/User/keybindings.json",
    ".config/VSCodium/User/settings.json", ".config/VSCodium/User/keybindings.json",
    ".config/archpill/", ".config/fastfetch/", ".config/starship.toml",
    ".bashrc", ".zshrc", ".gitconfig", ".face.icon",
]


def say(*a):
    print(*a, flush=True)


def step(t):
    print(f"\n### {t}", flush=True)


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=60).stdout
    except Exception:
        return ""


def drives():
    """Mounted drives you can write to that aren't the system disk (USB sticks, external disks...)."""
    out = []
    try:
        data = json.loads(run(["lsblk", "-J", "-b", "-o", "NAME,LABEL,SIZE,FSAVAIL,MOUNTPOINT,RM,HOTPLUG,TRAN,TYPE"]))
    except ValueError:
        return out

    def walk(devs, removable=False):
        for d in devs or []:
            rm = removable or d.get("rm") in (True, "1") or d.get("hotplug") in (True, "1") or d.get("tran") == "usb"
            mp = d.get("mountpoint")
            if mp and mp not in ("/", "/boot", "/boot/efi", "/efi", "/home", "[SWAP]") and \
                    (rm or mp.startswith(("/run/media/", "/media/", "/mnt/"))) and os.access(mp, os.W_OK):
                out.append({"path": mp, "label": d.get("label") or d["name"], "size": int(d.get("size") or 0),
                            "free": int(d.get("fsavail") or 0)})
            walk(d.get("children"), rm)
    walk(data.get("blockdevices"))
    return out


def gather():
    """What's on this computer: apps, Devium Configure choices, look."""
    info = {"made": datetime.datetime.now().isoformat(timespec="seconds"), "from": socket.gethostname(),
            "devium": "", "edition": ""}
    try:
        for line in open("/etc/devium-release"):
            k, _, v = line.strip().partition("=")
            if k == "DEVIUM_VERSION":
                info["devium"] = v
            if k == "DEVIUM_EDITION":
                info["edition"] = v
    except OSError:
        pass
    native = set(run(["pacman", "-Qqen"]).split())
    foreign = set(run(["pacman", "-Qqem"]).split())
    # leave out Devium's own base packages: the new PC already has them
    base = set()
    for f in ("/usr/share/devium/base-packages.txt",):
        try:
            base |= set(open(f).read().split())
        except OSError:
            pass
    info["pacman"] = sorted(native - base - {"devium-desktop"})
    info["aur"] = sorted(foreign - {"devium-desktop"})
    info["flatpak"] = sorted(set(run(["flatpak", "list", "--app", "--columns=application"]).split()))
    for code in ("code", "codium"):
        if shutil.which(code):
            info[f"ext_{code}"] = sorted(set(run([code, "--list-extensions"]).split()))
    return info


def rsync(src, dst, delete=False):
    args = ["rsync", "-aH", "--info=progress2,stats1", "--no-inc-recursive"]
    if delete:
        args.append("--delete")
    for e in EXCLUDE:
        args += ["--exclude", e]
    p = subprocess.Popen(args + [src, dst], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    last = ""
    for line in p.stdout:
        line = line.rstrip()
        # progress2 rewrites one line with \r; show it now and then
        if "%" in line and "to-chk" not in line:
            pct = line.split("%")[0].split()[-1] if "%" in line else ""
            if pct != last:
                say(f"  {pct}% copied")
                last = pct
        elif line:
            say("  " + line)
    return p.wait()


def backup(target):
    if not os.path.isdir(target):
        say(f"{target} is not a folder.")
        return 1
    dest = os.path.join(target, "DeviumBackup")
    os.makedirs(dest, exist_ok=True)
    step("Saving your app list")
    with open(os.path.join(dest, "devium-move.json"), "w") as f:
        json.dump(gather(), f, indent=1)
    step("Copying your files and settings (only what changed since the last backup)")
    code = rsync(HOME + "/", os.path.join(dest, "home") + "/", delete=True)
    with open(os.path.join(dest, "README.txt"), "w") as f:
        f.write("Devium backup of %s, made %s.\nRestore it with Devium Tools > Backup and move > Restore,\n"
                "or in a terminal: devium-backup restore '%s'\n"
                % (socket.gethostname(), datetime.datetime.now().strftime("%d %B %Y %H:%M"), target))
    subprocess.run(["sync"])
    if code in (0, 23, 24):   # 23/24: a few files vanished or couldn't be read (sockets, locked files)
        step("Backup finished. You can unplug the drive once it says it's safe.")
        return 0
    step(f"The backup stopped with an error (rsync code {code}).")
    return code


def restore(target):
    src = os.path.join(target, "DeviumBackup") if os.path.isdir(os.path.join(target, "DeviumBackup")) else target
    if not os.path.isdir(os.path.join(src, "home")):
        say("No Devium backup found there (looking for a DeviumBackup folder).")
        return 1
    step("Copying your files back (nothing on this computer is deleted)")
    code = rsync(os.path.join(src, "home") + "/", HOME + "/")
    move = os.path.join(src, "devium-move.json")
    if os.path.exists(move):
        step("Reinstalling your apps")
        install_apps(json.load(open(move)))
    step("Restore finished. Log out and back in to see your settings.")
    return 0 if code in (0, 23, 24) else code


def export(path):
    if not path.endswith((".devium", ".tar.gz")):
        path += ".devium"
    step("Collecting your apps and Devium Configure choices")
    info = gather()
    say(f"  {len(info['pacman'])} apps, {len(info['aur'])} from the AUR, {len(info['flatpak'])} Flatpaks")
    step("Collecting your settings")
    with tarfile.open(path, "w:gz") as tar:
        data = json.dumps(info, indent=1).encode()
        ti = tarfile.TarInfo("devium-move.json")
        ti.size = len(data)
        ti.mtime = int(datetime.datetime.now().timestamp())
        tar.addfile(ti, io.BytesIO(data))
        for rel in MOVE_FILES:
            full = os.path.join(HOME, rel.rstrip("/"))
            if os.path.exists(full):
                tar.add(full, arcname="home/" + rel.rstrip("/"))
                say("  " + rel)
    step(f"Saved to {path}. Copy it to the new PC and open Devium Tools > Backup and move > Import.")
    return 0


def install_apps(info):
    tmp = os.path.join("/tmp", f"devium-move-{os.getuid()}.json")
    with open(tmp, "w") as f:
        json.dump({"pacman": info.get("pacman", []), "flatpak": info.get("flatpak", [])}, f)
    try:
        code = subprocess.run(["pkexec", HELPER, "move-install", tmp]).returncode
    except OSError as e:
        say(f"  Couldn't install the apps ({e}).")
        code = 1
    for code_cmd in ("code", "codium"):
        exts = info.get(f"ext_{code_cmd}") or info.get("ext_code") or info.get("ext_codium") or []
        if shutil.which(code_cmd) and exts:
            step(f"Adding your {'VS Code' if code_cmd == 'code' else 'VSCodium'} extensions")
            for e in exts:
                subprocess.run([code_cmd, "--install-extension", e], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
    aur = info.get("aur", [])
    if aur:
        if shutil.which("yay"):
            step("Installing AUR apps with yay")
            subprocess.run(["yay", "-S", "--needed", "--noconfirm", "--answerclean", "None", "--answerdiff",
                            "None", *aur])
        else:
            say("  These came from the AUR; install yay in Devium Configure, then: yay -S " + " ".join(aur))
    return code


def import_(path):
    if not os.path.isfile(path):
        say(f"{path} not found.")
        return 1
    step("Opening the file")
    with tarfile.open(path, "r:gz") as tar:
        members = [m for m in tar.getmembers()
                   if (m.name == "devium-move.json" or m.name.startswith("home/")) and ".." not in m.name.split("/")
                   and not m.issym() and not m.islnk() and not m.isdev()]
        info = json.load(tar.extractfile("devium-move.json"))
        say(f"  From {info.get('from', '?')} (Devium {info.get('devium', '?')}), made {info.get('made', '?')}")
        step("Putting your settings back")
        snap = os.path.join(CFG, "devium", "before-import-" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S"))
        for m in members:
            if not m.name.startswith("home/") or not m.isfile():
                continue
            rel = m.name[5:]
            dst = os.path.join(HOME, rel)
            if os.path.exists(dst):   # keep a copy of what was there
                os.makedirs(os.path.dirname(os.path.join(snap, rel)), exist_ok=True)
                shutil.copy2(dst, os.path.join(snap, rel))
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with tar.extractfile(m) as src, open(dst, "wb") as out:
                shutil.copyfileobj(src, out)
            os.chmod(dst, m.mode & 0o777)
        say(f"  Your old settings were saved in {snap.replace(HOME, '~')}")
    step("Installing your apps")
    install_apps(info)
    step("All done. Log out and back in to see everything.")
    return 0


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if a[0] == "drives":
        for d in drives():
            print(f"{d['path']}\t{d['label']}\t{d['free']}\t{d['size']}")
        return 0
    if len(a) < 2:
        print(__doc__)
        return 1
    return {"backup": backup, "restore": restore, "export": export, "import": import_}.get(
        a[0], lambda _x: (print(__doc__), 1)[1])(os.path.expanduser(a[1]))


if __name__ == "__main__":
    sys.exit(main())
