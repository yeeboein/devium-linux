#!/usr/bin/env python3
"""Devium Welcome: the friendly front door to Devium."""
import os
import re
import shutil
import subprocess
import sys

sys.path.insert(0, "/usr/lib/devium")

from PyQt6.QtCore import QProcess, QSize, Qt
from PyQt6.QtGui import QIcon
from PyQt6.QtWidgets import (QApplication, QButtonGroup, QCheckBox, QGridLayout, QHBoxLayout,
                             QInputDialog, QLabel, QListWidget, QListWidgetItem, QMessageBox,
                             QPushButton, QRadioButton, QScrollArea, QStackedWidget,
                             QVBoxLayout, QWidget)

import devium_ui as ui

CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "devium")


# --------------------------------------------------------------------------- helpers
def h2(text):
    l = QLabel(text)
    l.setObjectName("h2")
    return l


def para(text):
    l = QLabel(text)
    l.setWordWrap(True)
    l.setTextFormat(Qt.TextFormat.RichText)
    l.linkActivated.connect(lambda url: ui.open_link(url, l.window()))
    return l


def tile(title, desc, on_click, icon=""):
    b = QPushButton(f"{title}\n{desc}")
    if icon:
        b.setIcon(QIcon.fromTheme(icon))
        b.setIconSize(QSize(32, 32))
    b.setObjectName("tile")
    b.setMinimumHeight(64)
    b.setCursor(Qt.CursorShape.PointingHandCursor)
    b.clicked.connect(on_click)
    return b


def tiles(items, cols=2):
    w = QWidget()
    g = QGridLayout(w)
    g.setContentsMargins(0, 4, 0, 4)
    g.setSpacing(10)
    for i, t in enumerate(items):
        g.addWidget(t, i // cols, i % cols)
    return w


def page(*widgets):
    inner = QWidget()
    lay = QVBoxLayout(inner)
    lay.setContentsMargins(24, 20, 24, 20)
    lay.setSpacing(8)
    for w in widgets:
        lay.addWidget(w)
    lay.addStretch(1)
    scroll = QScrollArea()
    scroll.setWidgetResizable(True)
    scroll.setFrameShape(QScrollArea.Shape.NoFrame)
    scroll.setWidget(inner)
    return scroll


def run_helper(parent, *args, done=None):
    """Run devium-helper as root (pkexec asks for the password) without blocking the UI."""
    p = QProcess(parent)
    p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
    p.finished.connect(lambda code, _s: done and done(code, bytes(p.readAll()).decode(errors="replace")))
    p.start("pkexec", ["/usr/lib/devium/devium-helper", *args])
    return p


def missing(parent, what):
    QMessageBox.information(parent, "Not installed", f"{what} is not installed.")


# --------------------------------------------------------------------------- driver detection
def detect_drivers():
    """Return a list of (title, description, [packages]) suggestions for this hardware."""
    try:
        pci = subprocess.run(["lspci", "-nn"], capture_output=True, text=True).stdout.lower()
    except FileNotFoundError:
        pci = ""
    out = []

    def installed(pkg):
        return subprocess.run(["pacman", "-Q", pkg], capture_output=True).returncode == 0

    if "nvidia" in pci and re.search(r"(vga|3d|display).*nvidia", pci):
        out.append(("NVIDIA graphics",
                    "Official NVIDIA driver (open kernel modules, for GTX 16xx / RTX and newer). "
                    "Older cards work with the built-in driver.",
                    ["nvidia-open", "nvidia-utils", "nvidia-settings"]))
    if re.search(r"network.*broadcom|broadcom.*(wireless|802\.11|bcm43)", pci):
        out.append(("Broadcom Wi-Fi", "Driver for many older Broadcom wireless cards.",
                    ["broadcom-wl"]))
    if re.search(r"(vga|display).*intel", pci) and not installed("intel-media-driver"):
        out.append(("Intel video acceleration", "Smoother, cooler video playback on Intel graphics.",
                    ["intel-media-driver"]))
    if re.search(r"(vga|display).*(amd|ati)", pci) and not installed("vulkan-radeon"):
        out.append(("AMD graphics (Vulkan)", "Vulkan support for AMD graphics, used by games.",
                    ["vulkan-radeon"]))
    out.append(("Printer drivers", "Drivers for most HP, Epson, Brother and Canon printers.",
                ["gutenprint", "hplip", "foomatic-db-engine", "foomatic-db-ppds"]))
    out.append(("Fingerprint reader", "Log in with your fingerprint (if your laptop has a reader).",
                ["fprintd"]))
    return out


# --------------------------------------------------------------------------- main window
class Welcome(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Welcome to Devium")
        self.setWindowIcon(ui.app_icon())
        self.resize(920, 620)
        self.procs = []

        root = QHBoxLayout(self)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)

        side = QWidget()
        side.setFixedWidth(210)
        sl = QVBoxLayout(side)
        sl.setContentsMargins(10, 16, 6, 12)
        sl.addWidget(ui.header("Devium", "", size=40))
        self.nav = QListWidget()
        self.nav.setObjectName("nav")
        sl.addWidget(self.nav, 1)
        self.startup = QCheckBox("Show at login")
        self.startup.setChecked(not os.path.exists(os.path.join(CONFIG, "welcome-hide")))
        self.startup.toggled.connect(self.toggle_startup)
        sl.addWidget(self.startup)
        root.addWidget(side)

        self.stack = QStackedWidget()
        root.addWidget(self.stack, 1)

        pages = [("Home", "go-home", self.home_page()),
                 ("Setup wizard", "tools-wizard", self.wizard_page()),
                 ("Coding", "applications-development", self.coding_page()),
                 ("Packages", "plasmadiscover", self.apps_page()),
                 ("Drivers", "hwinfo", self.drivers_page()),
                 ("System", "preferences-system", self.system_page()),
                 ("Shortcuts", "input-keyboard", self.shortcuts_page()),
                 ("Developers", "user-identity", page(ui.developers_widget()))]
        self.nav.setIconSize(QSize(22, 22))
        for name, icon, w in pages:
            QListWidgetItem(QIcon.fromTheme(icon), name, self.nav)
            self.stack.addWidget(w)
        self.nav.currentRowChanged.connect(self.stack.setCurrentIndex)
        self.nav.setCurrentRow(0)

    def toggle_startup(self, on):
        os.makedirs(CONFIG, exist_ok=True)
        marker = os.path.join(CONFIG, "welcome-hide")
        if on and os.path.exists(marker):
            os.remove(marker)
        elif not on:
            open(marker, "w").close()

    def go(self, *cmd, name=None):
        if not ui.launch(*cmd):
            missing(self, name or cmd[0])

    # ---------------------------------------------------------------- pages
    def home_page(self):
        items = []
        if ui.is_live():
            items.append(tile("Install Devium", "Put Devium on this computer's disk",
                              lambda: self.go("devium-install"), "drive-optical"))
        items += [
            tile("Update Manager", "Get the latest updates (Meta+U)",
                 lambda: self.go("devium-update-manager"), "system-software-update"),
            tile("Devium Tools", "App Manager, speed, battery, privacy and help (Meta+T)",
                 lambda: self.go("devium-tools", name="Devium Tools"), "preferences-system"),
            tile("Discover", "Find and install apps",
                 lambda: self.go("plasma-discover", name="Discover"), "plasmadiscover"),
            tile("New Python project", "Folder, venv, git and VS Code in one click",
                 self.new_project, "text-x-python"),
            tile("Snip", "Screenshot an area: Meta+Shift+S",
                 lambda: self.go("spectacle", "--region", name="Snip"), "spectacle"),
            tile("ArchPill settings", "Customise the pill at the top of the screen",
                 self.archpill_settings, "preferences-desktop-theme"),
            tile("Devium Discord", "Help, news and new betas: chat with the community",
                 lambda: ui.open_link(ui.DISCORD, self), "internet-chat"),
            tile("System Settings", "Wi-Fi, display, sound, look and more",
                 lambda: self.go("systemsettings"), "preferences-system"),
        ]
        live = ("<p>You are running the <b>live</b> version. Nothing is saved after a restart "
                "until you install Devium. The live password is <b>devium</b>.</p>") if ui.is_live() else ""
        return page(ui.header("Welcome to Devium",
                              "A light, fast Arch Linux desktop made for coding."),
                    para(live + "<p>Start here. Everything is a click away, and you can come "
                         "back any time from the app menu (or press <b>Meta+F1</b>).</p>"),
                    tiles(items))

    def wizard_page(self):
        return page(h2("Devium Setup"),
                    para("Pick your browser, code editor, languages, tools and apps. "
                         "Devium only installs what you choose, so it stays light. "
                         "You can run it again any time to add or remove things."),
                    tile("Open Devium Setup", "Choose what to install",
                         lambda: self.go("devium-setup-wizard", name="Devium Setup"), "tools-wizard"))

    def coding_page(self):
        libs = ("numpy, pandas, matplotlib, requests, flask, beautifulsoup4, pytest, black, ruff, "
                "pillow, pyyaml, rich, ipython, pip, pipx, virtualenv")
        return page(
            h2("Start coding"),
            tiles([
                tile("New Python project", "Creates ~/Projects/<name> and opens VS Code",
                     self.new_project, "text-x-python"),
                tile("VS Code", "Python extension and formatter ready",
                     lambda: self.go("code", name="VS Code"), "code-oss"),
                tile("Terminal", "Konsole (F12 in Dolphin opens one too)",
                     lambda: self.go("konsole"), "utilities-terminal"),
                tile("Kate", "Light, fast text editor",
                     lambda: self.go("kate"), "kate"),
                tile("Python shell", "IPython, a friendlier Python prompt",
                     lambda: self.go("konsole", "-e", "ipython", name="IPython"), "text-x-python"),
                tile("Projects folder", "Open ~/Projects in Dolphin",
                     lambda: self.go("dolphin", os.path.expanduser("~/Projects")), "folder-development"),
            ]),
            h2("What's installed"),
            para(f"<b>Python libraries:</b> {libs}<br>"
                 "<b>Tools:</b> git, GitHub CLI (gh), Node.js + npm, gcc/make (base-devel), "
                 "neovim, btop, ripgrep, fd, jq<br><br>"
                 "Need more? In a project run <code>pip install &lt;name&gt;</code>. "
                 "For command-line tools use <code>pipx install &lt;name&gt;</code>."))

    def apps_page(self):
        def store(app_id):
            return lambda: self.go("plasma-discover", f"appstream://{app_id}", name="Discover")

        popular = [("Discord", "Chat and voice", "com.discordapp.Discord", "internet-chat"),
                   ("Spotify", "Music", "com.spotify.Client", "audio-x-generic"),
                   ("Steam", "Games", "com.valvesoftware.Steam", "input-gaming"),
                   ("LibreOffice", "Documents, sheets, slides", "org.libreoffice.LibreOffice", "x-office-document"),
                   ("GIMP", "Photo editing", "org.gimp.GIMP", "applications-graphics"),
                   ("OBS Studio", "Record and stream", "com.obsproject.Studio", "camera-video"),
                   ("Thunderbird", "Email", "org.mozilla.Thunderbird", "internet-mail"),
                   ("VLC", "Plays every video", "org.videolan.VLC", "media-playback-start")]
        return page(
            h2("Get apps"),
            para("Discover is Devium's app store. Apps come from Flathub and run in a sandbox, "
                 "so they can't break your system. Click one to open it in Discover."),
            tile("Open Discover", "Browse thousands of apps",
                 lambda: self.go("plasma-discover", name="Discover"), "plasmadiscover"),
            h2("Popular"),
            tiles([tile(n, d, store(i), e) for n, d, i, e in popular]))

    def drivers_page(self):
        w = QWidget()
        lay = QVBoxLayout(w)
        lay.setContentsMargins(0, 0, 0, 0)
        for title, desc, pkgs in detect_drivers():
            row = QHBoxLayout()
            text = para(f"<b>{title}</b><br>{desc}<br><small>{' '.join(pkgs)}</small>")
            btn = QPushButton("Install")
            btn.setFixedWidth(110)
            btn.clicked.connect(lambda _c=False, p=pkgs, b=btn: self.install(p, b))
            row.addWidget(text, 1)
            row.addWidget(btn)
            lay.addLayout(row)
        return page(h2("Drivers"),
                    para("Devium already includes drivers for most hardware. "
                         "These are extra drivers that may help on this computer."),
                    w)

    def install(self, pkgs, btn):
        btn.setEnabled(False)
        btn.setText("Installing…")

        def done(code, out):
            btn.setText("✓ Installed" if code == 0 else "Install")
            btn.setEnabled(code != 0)
            if code not in (0, 126, 127):
                QMessageBox.warning(self, "Install failed", out[-1500:])
            elif code == 0 and any(p.startswith("nvidia") for p in pkgs):
                QMessageBox.information(self, "Restart needed", "Restart to start using the new driver.")

        self.procs.append(run_helper(self, "install", *pkgs, done=done))

    def system_page(self):
        def firewall(on):
            run_helper(self, "firewall", "on" if on else "off",
                       done=lambda c, o: QMessageBox.information(
                           self, "Firewall", ("Firewall is now " + ("on" if on else "off"))
                           if c == 0 else "Nothing changed."))

        def theme(dark):
            ui.launch("plasma-apply-colorscheme", "Devium" if dark else "DeviumLight")
            ui.launch("plasma-apply-desktoptheme", "breeze-dark" if dark else "breeze-light")

        return page(
            h2("System"),
            tiles([
                tile("Update Manager", "Updates, plus free up disk space",
                     lambda: self.go("devium-update-manager"), "system-software-update"),
                tile("Devium Updater", "New Devium versions and ISOs",
                     lambda: self.go("devium-updater"), "devium"),
                tile("Restore points", "Set up Timeshift: undo a bad update in two clicks",
                     lambda: self.go("timeshift-launcher", name="Timeshift"), "timeshift"),
                tile("Firewall on", "Block incoming connections (recommended)",
                     lambda: firewall(True), "security-high"),
                tile("Firewall off", "Allow everything in",
                     lambda: firewall(False), "security-low"),
                tile("Dark theme", "Easy on the eyes", lambda: theme(True), "weather-clear-night"),
                tile("Light theme", "Bright and clean", lambda: theme(False), "weather-clear"),
                tile("KDE Lite", "Use less RAM: switch off KDE extras (log out to apply)",
                     lambda: self.go("bash", "/opt/kdelite/kdelite", "apply", name="KDElite"), "speedometer"),
                tile("Full KDE", "Turn KDE's extras back on (log out to apply)",
                     lambda: self.go("bash", "/opt/kdelite/kdelite", "revert", name="KDElite"), "kde"),
                tile("Devium Dark", "Deeper, darker blue-grey",
                     lambda: ui.launch("plasma-apply-colorscheme", "DeviumDark"), "weather-clear-night"),
                tile("Printers", "Add or manage printers",
                     lambda: self.go("systemsettings", "kcm_printer_manager"), "printer"),
                tile("System Monitor", "See what's using CPU and memory",
                     lambda: self.go("plasma-systemmonitor"), "utilities-system-monitor"),
                tile("Wi-Fi & network", "Connect to a network",
                     lambda: self.go("systemsettings", "kcm_networkmanagement"), "network-wireless"),
                tile("Battery & power", "Battery saver is on (TLP)",
                     lambda: self.go("systemsettings", "kcm_powerdevilprofilesconfig"), "battery-good"),
            ]))

    def shortcuts_page(self):
        rows = [("Meta", "Open the app menu"),
                ("Meta+Shift+S", "Snip an area of the screen (copied automatically)"),
                ("Print", "Open Snip"),
                ("Meta+Print", "Snip the current window"),
                ("Meta+Shift+R", "Record an area of the screen"),
                ("Meta+V", "Clipboard history"),
                ("Meta+.", "Emoji picker"),
                ("Meta+U", "Update Manager"),
                ("Meta+F1", "Devium Welcome"),
                ("Meta+E", "Files (Dolphin)"),
                ("Meta+L", "Lock the screen"),
                ("Meta+D", "Show the desktop"),
                ("Meta+Arrow keys", "Snap windows to the sides / corners"),
                ("Meta+W", "Overview of all windows"),
                ("Alt+Tab", "Switch windows"),
                ("Alt+Space", "KRunner: search apps, files, do maths"),
                ("Ctrl+Alt+T", "Terminal"),
                ("Ctrl+Esc", "System monitor (kill frozen apps)"),
                ("Dolphin: F4 / F3 / Ctrl+H", "Terminal panel / split view / hidden files")]
        html = "<table cellpadding='4'>" + "".join(
            f"<tr><td><b><code>{k}</code></b></td><td>{v}</td></tr>" for k, v in rows) + "</table>"
        return page(h2("Handy shortcuts"), para("Meta is the Windows key."), para(html))

    # ---------------------------------------------------------------- actions
    def new_project(self):
        name, ok = QInputDialog.getText(self, "New Python project",
                                        "Project name (letters, numbers, - and _):")
        if not ok or not name.strip():
            return
        r = subprocess.run(["devium-new-project", name.strip()], capture_output=True, text=True)
        if r.returncode == 0:
            QMessageBox.information(self, "Project created", r.stdout.strip() +
                                    "\n\nVS Code is opening it now.")
        else:
            QMessageBox.warning(self, "Could not create project", (r.stdout + r.stderr).strip())

    def archpill_settings(self):
        qs = shutil.which("qs") or shutil.which("quickshell")
        if not qs:
            r = QMessageBox.question(self, "Install ArchPill?",
                                     "ArchPill needs Quickshell, which isn't installed yet. Install it now? "
                                     "(about 60 MB)")
            if r != QMessageBox.StandardButton.Yes:
                return
            setup = ("pkexec /usr/lib/devium/devium-helper archpill-deps && "
                     "{ [ -d ~/archpill ] || cp -r /opt/archpill ~/archpill; } && "
                     "cd ~/archpill && ./install.sh --no-packages; "
                     "pgrep -f 'qs -c archpill' >/dev/null || QS_APP_ID=archpill qs -c archpill -n -d")
            os.makedirs(CONFIG, exist_ok=True)
            open(os.path.join(CONFIG, "archpill-wanted"), "w").close()
            subprocess.Popen(["sh", "-c", setup], start_new_session=True)
            return
        subprocess.Popen(["sh", "-c",
                          f"{qs} -c archpill ipc call archpill openSettings || "
                          f"(QS_APP_ID=archpill {qs} -c archpill -n -d; sleep 2; "
                          f"{qs} -c archpill ipc call archpill openSettings)"],
                         start_new_session=True)


def main():
    if "--autostart" in sys.argv:
        if ui.is_live():
            return   # the live preview shows About Devium instead
        if os.path.exists(os.path.join(CONFIG, "welcome-hide")):
            return
        # On a fresh install, Devium Setup opens first; Welcome waits until next login.
        if not ui.is_live() and not (os.path.exists(os.path.join(CONFIG, "setup-done")) or
                                     os.path.exists(os.path.join(CONFIG, "setup-seen"))):
            return
    app = QApplication(sys.argv)
    app.setApplicationName("Devium Welcome")
    app.setDesktopFileName("devium-welcome")
    ui.style_app(app)
    w = Welcome()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
