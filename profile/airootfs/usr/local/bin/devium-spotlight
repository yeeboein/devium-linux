#!/usr/bin/env python3
"""Devium Spotlight (Meta+Space): one search box for apps, settings, files, maths, unit
conversions and terminal commands.

  type an app name        open it
  type a setting          "wifi", "battery", "printer", "dark mode"...
  type a file name        files in your home folder
  2+2*3, sqrt(16), 15%    quick maths (Enter copies the answer)
  10 km in miles          unit conversions (length, weight, temperature, data, time)
  > htop                  run a command in the terminal
  snip docker             your snippets (Enter copies one)
  anything                "Search the web for..." in your browser; yt / g / wiki / gh / aur / arch + words
                          search those sites; github.com opens the address
  docs python:split       search the offline docs (Zeal) or DevDocs
"""
