#!/usr/bin/env python3
"""album-cover - the cover of the song that's playing right now, drawn in the terminal.

  album-cover            the cover in colour, as big as the window allows
  album-cover --ascii    classic ASCII art: letters and symbols, in colour
  album-cover --mono     ASCII art without colour
  album-cover --size N   N characters wide

Works with Spotify, Firefox, Brave, VLC, Elisa and other players that share their cover art.
"""
import hashlib
import io
import os
import shutil
import sys
import urllib.parse
import urllib.request

sys.path.insert(0, "/usr/lib/devium")
import nowplaying  # noqa: E402

CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "devium", "covers")
RAMP = " .'`^\",:;Il!i><~+_-?][}{1)(|/tfjrxnuvczXYUJCLQ0OZmwqpdbkhao*#MW&8%B@$"
B, D, N = "\033[1m", "\033[2m", "\033[0m"
TITLE, SOFT = "\033[38;2;180;184;224m", "\033[38;2;196;204;214m"


def load_cover(url):
    from PIL import Image
    if url.startswith("file://"):
        return Image.open(urllib.parse.unquote(url[7:]))
    if url.startswith("/"):
        return Image.open(url)
    if not url.startswith(("http://", "https://")):
        return None
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, hashlib.sha1(url.encode()).hexdigest())
    if not os.path.exists(path):
        req = urllib.request.Request(url, headers={"User-Agent": "Devium album-cover"})
        with urllib.request.urlopen(req, timeout=10) as r:
            data = r.read()
        with open(path, "wb") as f:
            f.write(data)
    return Image.open(path)


def blocks(img, width):
    """Two pixels per character (upper half block), full colour: looks like the real cover."""
    h = max(2, int(width * img.height / img.width))
    h += h % 2
    px = img.convert("RGB").resize((width, h)).load()
    out = []
    for y in range(0, h, 2):
        row = []
        for x in range(width):
            r1, g1, b1 = px[x, y]
            r2, g2, b2 = px[x, y + 1]
            row.append(f"\033[38;2;{r1};{g1};{b1}m\033[48;2;{r2};{g2};{b2}m▀")
        out.append("".join(row) + N)
    return out


def ascii_art(img, width, colour):
    # characters are about twice as tall as wide
    h = max(1, int(width * img.height / img.width / 2))
    small = img.convert("RGB").resize((width, h))
    px, grey = small.load(), small.convert("L").load()
    out = []
    for y in range(h):
        row = []
        for x in range(width):
            ch = RAMP[grey[x, y] * (len(RAMP) - 1) // 255]
            if colour:
                r, g, b = px[x, y]
                row.append(f"\033[38;2;{r};{g};{b}m{ch}")
            else:
                row.append(ch)
        out.append("".join(row) + (N if colour else ""))
    return out


def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return 0
    mode = "ascii" if "--ascii" in args else "mono" if "--mono" in args else "blocks"
    cols, rows = shutil.get_terminal_size((80, 24))
    width = None
    if "--size" in args:
        try:
            width = int(args[args.index("--size") + 1])
        except (IndexError, ValueError):
            print("album-cover: --size needs a number, e.g. --size 40")
            return 1
    color_ok = sys.stdout.isatty() or mode != "mono"
    title_c, soft_c = (TITLE, SOFT) if sys.stdout.isatty() else ("", "")

    song = nowplaying.current()
    if not song:
        print("Nothing is playing. Start a song in Spotify, your browser or any music app.")
        return 1
    if not song["art"]:
        print(f"{song['title']} has no album cover (this player doesn't share one).")
        return 1
    try:
        img = load_cover(song["art"])
    except Exception:
        img = None
    if img is None:
        print("Couldn't get the album cover. Check your internet.")
        return 1

    room_rows = max(4, rows - 4)
    if width is None:
        width = min(cols - 2, room_rows * 2 if mode == "blocks" else room_rows * 2, 72)
    width = max(8, min(width, cols))
    if mode == "blocks":
        lines = blocks(img, width)
    else:
        lines = ascii_art(img, width, colour=(mode == "ascii" and color_ok))
    print("\n".join(lines))
    who = f" — {song['artist']}" if song["artist"] else ""
    album = f"  ·  {song['album']}" if song["album"] else ""
    print(f"{B if title_c else ''}{title_c}♪ {song['title']}{N if title_c else ''}{soft_c}{who}{album}{N if soft_c else ''}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
