#!/usr/bin/env python3
"""Devium updates: checks GitHub for new Devium releases, updates Devium's own files
(apps, look, settings) without reinstalling, and downloads new ISOs. It is a page of Devium Tools
(Devium updates); this file also runs on its own. (System packages are updated on the Update Arch page.)"""
import json
import os
import re
import sys
import urllib.request

sys.path.insert(0, "/usr/lib/devium")

from PyQt6.QtCore import QProcess, Qt, QThread, pyqtSignal
from PyQt6.QtWidgets import (QApplication, QCheckBox, QHBoxLayout, QLabel, QPlainTextEdit, QProgressBar,
                             QPushButton, QTextBrowser, QVBoxLayout, QWidget)

import devium_ui as ui


def release_info():
    info = {"DEVIUM_VERSION": "unknown", "DEVIUM_REPO": "https://github.com/yeeboein/devium-linux"}
    try:
        for line in open("/etc/devium-release"):
            k, _, v = line.strip().partition("=")
            if k:
                info[k] = v
    except OSError:
        pass
    return info


def api_url(repo):
    m = re.match(r"https://github\.com/([^/]+/[^/]+?)(?:\.git)?/?$", repo)
    # every release, not /releases/latest: GitHub leaves pre-releases (all Devium betas) out of "latest"
    return f"https://api.github.com/repos/{m.group(1) if m else 'yeeboein/devium-linux'}/releases?per_page=30"


def next_name(v):
    """beta15 -> beta16, 2026.11.15 -> the next release (shown as "the next version")."""
    m = re.match(r"^(.*?)(\d+)(?:\.\d+)?$", v or "")        # beta18 and beta18.5 are both followed by beta19
    return f"{m.group(1)}{int(m.group(2)) + 1}" if m and not re.match(r"^\d{4}\.", v) else "the next version"


def raw_url(repo, path):
    m = re.match(r"https://github\.com/([^/]+/[^/]+?)(?:\.git)?/?$", repo)
    return f"https://raw.githubusercontent.com/{m.group(1) if m else 'yeeboein/devium-linux'}/main/{path}"


class FetchText(QThread):
    """The "coming next" notes (docs/releases/next.md on GitHub), so they can change without a new ISO."""
    done = pyqtSignal(str)

    def __init__(self, url):
        super().__init__()
        self.url = url

    def run(self):
        try:
            req = urllib.request.Request(self.url, headers={"User-Agent": "devium-updater"})
            with urllib.request.urlopen(req, timeout=15) as r:
                self.done.emit(r.read().decode("utf-8", "replace"))
        except Exception:
            self.done.emit("")


def version_key(v):
    """Comparable version: beta1..beta99 (before 1.0) < v1.0-beta1 < v1.0-rc1 < v1.0 < v1.0.1 < v1.1 ..."""
    v = (v or "").strip().lower()
    v = v[1:] if v.startswith("v") else v
    m = re.match(r"^(\d+(?:\.\d+)*)?[-_.]?(alpha|beta|rc)?(\d+(?:\.\d+)*)?", v)
    nums = [int(x) for x in (m.group(1) or "0").split(".")] if m else [0]
    nums = (nums + [0, 0, 0])[:3]
    stage = {"alpha": 0, "beta": 1, "rc": 2}.get(m.group(2) if m else None, 3)
    if (m and not m.group(1) and not m.group(2)) or nums[0] >= 2000:   # test builds (dated, e.g. 2026.11.15): oldest
        return [0, 0, 0, 0, 0]
    # the number after the stage can have a dot too: beta18 < beta18.5 < beta19
    sub = [int(x) for x in (m.group(3) or "0").split(".")] if m else [0]
    return nums + [stage] + (sub + [0, 0])[:2]


CHANNEL_FILE = os.path.expanduser("~/.config/devium/update-channel")


def channel():
    """"stable" (normal) or "beta" (testers: betas too)."""
    try:
        return "beta" if open(CHANNEL_FILE).read().strip() == "beta" else "stable"
    except OSError:
        return "stable"


class Fetch(QThread):
    done = pyqtSignal(object, str)

    def __init__(self, url):
        super().__init__()
        self.url = url

    def run(self):
        try:
            req = urllib.request.Request(self.url, headers={"Accept": "application/vnd.github+json",
                                                            "User-Agent": "devium-updater"})
            with urllib.request.urlopen(req, timeout=15) as r:
                data = json.load(r)
            if isinstance(data, list):   # pick the newest published release for your channel
                data = [rel for rel in data if not rel.get("draft") and rel.get("tag_name")]
                stable = [rel for rel in data if not rel.get("prerelease")]
                # stable channel: only full releases; until the first one exists, the betas are all there is
                if channel() == "stable" and stable:
                    data = stable
                data = max(data, key=lambda rel: version_key(rel["tag_name"])) if data else None
                if data is None:
                    self.done.emit(None, "No Devium releases published yet.")
                    return
            self.done.emit(data, "")
        except urllib.error.HTTPError as e:
            self.done.emit(None, "No Devium releases published yet." if e.code == 404 else str(e))
        except Exception as e:  # offline etc.
            self.done.emit(None, f"Could not reach GitHub ({e.__class__.__name__}). Check your internet.")


class Updater(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Devium updates")
        self.setWindowIcon(ui.app_icon())
        self.resize(720, 560)
        self.info = release_info()
        self.release = None

        lay = QVBoxLayout(self)
        lay.setContentsMargins(20, 18, 20, 18)
        lay.addWidget(ui.header("Devium updates",
                                "New Devium versions: new apps, looks and features. "
                                "(Use Update Arch in Devium Tools for normal software updates.)"))
        self.status = QLabel(f"You have Devium {self.info['DEVIUM_VERSION']}. Checking for a newer version…")
        self.status.setObjectName("h2")
        self.status.setWordWrap(True)
        lay.addWidget(self.status)
        self.next_label = QLabel()
        self.next_label.setTextFormat(Qt.TextFormat.RichText)
        self.next_label.setStyleSheet(f"font-size: 13pt; padding: 6px 12px; border-radius: 10px; "
                                      f"background: rgba(143,180,216,0.16); color: {ui.ACCENT};")
        lay.addWidget(self.next_label)

        self.notes = QTextBrowser()
        self.notes.setOpenLinks(False)
        self.notes.anchorClicked.connect(lambda u: ui.open_link(u.toString(), self))
        lay.addWidget(self.notes, 1)

        self.progress = QProgressBar()
        self.progress.setRange(0, 0)
        self.progress.setVisible(False)
        lay.addWidget(self.progress)
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setVisible(False)
        self.log.setMaximumHeight(160)
        lay.addWidget(self.log)

        self.beta_box = QCheckBox("Get beta versions too (for testers: newest features, more bugs)")
        self.beta_box.setChecked(channel() == "beta")
        self.beta_box.toggled.connect(self.set_channel)
        lay.addWidget(self.beta_box)

        row = QHBoxLayout()
        self.check_btn = QPushButton("Check again")
        self.check_btn.clicked.connect(self.check)
        self.iso_btn = QPushButton("Download the new ISO")
        self.iso_btn.setToolTip("For a USB stick or a fresh install")
        self.iso_btn.setEnabled(False)
        self.iso_btn.clicked.connect(self.download_iso)
        self.update_btn = QPushButton("Update Devium")
        self.update_btn.setObjectName("primary")
        self.update_btn.setEnabled(False)
        self.update_btn.clicked.connect(self.update)
        row.addWidget(self.check_btn)
        row.addStretch(1)
        row.addWidget(self.iso_btn)
        row.addWidget(self.update_btn)
        lay.addLayout(row)
        self.check()

    def set_channel(self, beta):
        os.makedirs(os.path.dirname(CHANNEL_FILE), exist_ok=True)
        with open(CHANNEL_FILE, "w") as f:
            f.write("beta\n" if beta else "stable\n")
        self.check()

    def check(self):
        self.status.setText(f"You have Devium {self.info['DEVIUM_VERSION']}. Checking for a newer version…")
        self.fetch = Fetch(api_url(self.info["DEVIUM_REPO"]))
        self.fetch.done.connect(self.got)
        self.fetch.start()

    def show_next(self, name, ready):
        self.next_label.setText(f"<b>Next update: {name}</b>" + ("  ·  ready to install" if ready else "  ·  coming soon"))

    def coming_next(self):
        """No newer release yet: show what's planned for the next one."""
        name = next_name(self.info["DEVIUM_VERSION"])
        self.show_next(name, False)
        self.notes.setMarkdown(f"## Coming in {name}\n\nLoading…")
        self.next_fetch = FetchText(raw_url(self.info["DEVIUM_REPO"], "docs/releases/next.md"))

        def got(text):
            if not text.strip():
                self.notes.setMarkdown(f"## Coming in {name}\n\nThe plan for {name} isn't online yet. "
                                       "Check the Devium Discord for news.")
                return
            text = re.sub(r"<!--.*?-->", "", text, flags=re.S)   # notes for the Devium team aren't shown
            lines = text.strip().splitlines()
            if lines and lines[0].startswith("# "):
                title = lines[0][2:].strip()
                m = re.search(r"\b(beta\d+(?:\.\d+)?|\d+\.\d+(?:\.\d+)?)\b", title)
                if m:
                    self.show_next(m.group(1), False)
                lines = lines[1:]
            self.notes.setMarkdown(f"## Coming in {name}\n\n" + "\n".join(lines) +
                                   "\n\n*This is the plan, so things may still change before it's released.*")
        self.next_fetch.done.connect(got)
        self.next_fetch.start()

    def got(self, rel, err):
        if not rel:
            self.status.setText(err)
            self.coming_next()
            return
        self.release = rel
        tag = rel.get("tag_name", "")
        newer = version_key(tag) > version_key(self.info["DEVIUM_VERSION"])
        self.notes.setMarkdown(f"## {rel.get('name') or tag}\n\n{rel.get('body') or 'No release notes.'}")
        self.iso_btn.setEnabled(any(a["name"].endswith((".iso", ".zip", ".001")) or ".iso." in a["name"]
                                    for a in rel.get("assets", [])))
        if newer:
            self.status.setText(f"Devium {tag.lstrip('v')} is available! You have {self.info['DEVIUM_VERSION']}.")
            self.show_next(tag.lstrip("v"), True)
            self.notes.setMarkdown(f"## Everything new in {rel.get('name') or tag}\n\n{rel.get('body') or 'No release notes.'}")
            self.update_btn.setEnabled(not ui.is_live())
        else:
            self.status.setText(f"You have the latest Devium ({self.info['DEVIUM_VERSION']}).")
            self.update_btn.setEnabled(False)
            self.coming_next()

    def download_iso(self):
        url = (self.release or {}).get("html_url") or self.info["DEVIUM_REPO"] + "/releases"
        ui.open_link(url, self)

    def update(self):
        tag = self.release["tag_name"]
        self.update_btn.setEnabled(False)
        self.progress.setVisible(True)
        self.log.setVisible(True)
        self.status.setText(f"Updating to Devium {tag.lstrip('v')}… (you may be asked for your password)")
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(
            lambda: self.log.appendPlainText(bytes(self.proc.readAllStandardOutput()).decode(errors="replace").rstrip()))
        self.proc.finished.connect(self.updated)
        self.proc.start("pkexec", ["/usr/lib/devium/devium-helper", "refresh", tag])

    def updated(self, code, _s):
        self.progress.setVisible(False)
        if code == 0:
            self.info = release_info()
            self.status.setText(f"Devium is updated to {self.info['DEVIUM_VERSION']}. "
                                "Restart to see everything new.")
            # restart by itself after a countdown you can cancel; "What's new" then shows at the next login
            if not ui.restart_after_update(self, f"Devium is updated to {self.info['DEVIUM_VERSION']}."):
                ui.launch("devium-whats-new")   # you stayed: show what changed in this version now
        elif code in (126, 127):
            self.status.setText("Update cancelled.")
            self.update_btn.setEnabled(True)
        else:
            self.status.setText("The update failed. See the details below.")
            self.update_btn.setEnabled(True)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Devium Updater")
    app.setDesktopFileName("devium-updater")
    ui.style_app(app)
    w = Updater()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
