#!/usr/bin/env bash
# Devium's fastfetch: the DEVIUM logo on the left with your info next to it, always.
# Your own ~/.config/fastfetch/config.jsonc, or any options you pass, are used as they are.
real=/usr/bin/fastfetch
[[ -x $real ]] || { echo "fastfetch is not installed"; exit 1; }

# fastfetchnorev sets this: always use Devium's layouts without personal details (even with your own config)
suffix=""
[[ -n ${DEVIUM_FASTFETCH_NOREV:-} ]] && suffix="-norev"

own="${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/config.jsonc"
if [[ -z $suffix ]] && { (( $# )) || [[ -f $own || -f ${own%c} ]] || [[ ! -t 1 ]]; }; then
    exec "$real" "$@"
fi

dir=/etc/xdg/fastfetch
# Always the same layout: the Devium logo on the left with your info right next to it, whatever the window size.
# In a narrow window the config with short CPU / GPU / Memory / Disk / Packages lines is used (it is just another
# config file: fastfetch no longer accepts per-module command-line options). Lines still longer than the window are
# cut (colours kept) so they never wrap back under the logo. If anything in that goes wrong, plain fastfetch runs.
cfg="$dir/config$suffix.jsonc"
if [[ -t 1 ]] && command -v python3 >/dev/null; then
    cols=$(tput cols 2>/dev/null || echo 0)
    if (( cols >= 20 )); then
        (( cols < 92 )) && [[ -f $dir/config-narrow$suffix.jsonc ]] && cfg="$dir/config-narrow$suffix.jsonc"
        out=$(mktemp) || out=""
        if [[ -n $out ]] && "$real" --pipe false -c "$cfg" "$@" > "$out" 2>/dev/null && [[ -s $out ]]; then
            python3 -c '
import re, sys
cols = int(sys.argv[1])
esc = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
for line in open(sys.argv[2], encoding="utf-8", errors="replace"):
    line = line.rstrip("\n")
    res, vis, i = [], 0, 0
    while i < len(line):
        m = esc.match(line, i)
        if m:
            res.append(m.group()); i = m.end(); continue
        if vis >= cols - 1:
            break
        res.append(line[i]); vis += 1; i += 1
    sys.stdout.write("".join(res) + ("\x1b[0m" if "\x1b" in line else "") + "\n")
' "$cols" "$out"
            rm -f "$out"
            exit 0
        fi
        [[ -n $out ]] && rm -f "$out"
    fi
fi
exec "$real" -c "$dir/config$suffix.jsonc" "$@"
