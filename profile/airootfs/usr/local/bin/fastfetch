#!/usr/bin/env bash
# Devium's fastfetch: picks a layout that fits the terminal window, so nothing wraps.
#   wide window    DEVIUM logo on the left, full info beside it
#   narrow window  the same logo on top, short info underneath
# Your own ~/.config/fastfetch/config.jsonc, or any options you pass, are used as they are.
real=/usr/bin/fastfetch
[[ -x $real ]] || { echo "fastfetch is not installed"; exit 1; }

# fastfetchnorev sets this: always use Devium's layouts without personal details (even with your own config)
suffix=""
[[ -n ${DEVIUM_FASTFETCH_NOREV:-} ]] && suffix="-norev"

own="${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/config.jsonc"
if [[ -z $suffix ]] && { (( $# )) || [[ -f $own || -f ${own%c} ]] || [[ ! -t 1 ]]; }; then
    exec "$real" "$@"
fi

read -r rows cols < <(stty size </dev/tty 2>/dev/null)
cols=${cols:-$(tput cols 2>/dev/null || echo 120)}
rows=${rows:-$(tput lines 2>/dev/null || echo 40)}

dir=/etc/xdg/fastfetch
# One logo, never shrunk. Wide window: logo on the left, info beside it.
# Narrow window: the same logo on top and the info underneath, so they can't run into each other.
if (( cols >= 110 )); then
    exec "$real" -c "$dir/config$suffix.jsonc" "$@"
else
    exec "$real" -c "$dir/stacked$suffix.jsonc" "$@"
fi
