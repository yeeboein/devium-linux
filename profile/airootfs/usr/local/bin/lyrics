#!/usr/bin/env python3
"""lyrics - the words to the song that's playing right now, following along as it plays.

  lyrics          live: the current line lights up as the song plays, and it moves on to the next song by itself
  lyrics --once   print the whole lyrics once and exit

Works with Spotify, Firefox, Brave, VLC, Elisa and other players. Lyrics come from LRCLIB (lrclib.net, free, no
account): only the song's title, artist, album and length are sent. Press Ctrl+C to stop.
"""
import os
import shutil
import signal
import sys
import time

sys.path.insert(0, "/usr/lib/devium")
import lyricslib  # noqa: E402
import nowplaying  # noqa: E402

B, D, N = "\033[1m", "\033[2m", "\033[0m"
ACCENT, SOFT, TITLE = "\033[38;2;143;180;216m", "\033[38;2;196;204;214m", "\033[38;2;180;184;224m"
if not sys.stdout.isatty():
    B = D = N = ACCENT = SOFT = TITLE = ""


def fetch(song):
    return lyricslib.fetch(song)


def parse_lrc(text):
    return lyricslib.parse_lrc(text)


def header(song):
    who = f" — {song['artist']}" if song["artist"] else ""
    paused = "  (paused)" if song["status"] == "Paused" else ""
    return f"{B}{TITLE}♪ {song['title']}{N}{SOFT}{who}{N}{D}{paused}{N}"


def no_song():
    return f"{SOFT}Nothing is playing. Start a song in Spotify, your browser or any music app.{N}"


def once():
    song = nowplaying.current()
    if not song:
        print(no_song())
        return 1
    print(header(song))
    print()
    lyr = fetch(song)
    if lyr is None:
        print(f"{SOFT}Couldn't reach the lyrics site. Check your internet.{N}")
        return 1
    if lyr["instrumental"]:
        print(f"{SOFT}(Instrumental: no words){N}")
    elif lyr["plain"] or lyr["synced"]:
        print(lyr["plain"] or "\n".join(w for _t, w in lyr["synced"]))
    else:
        print(f"{SOFT}No lyrics found for this song.{N}")
    return 0


def live():
    sys.stdout.write("\033[?1049h\033[?25l")      # own screen, hide the cursor
    sys.stdout.flush()

    def restore(*_):
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()
        sys.exit(0)
    signal.signal(signal.SIGINT, restore)
    signal.signal(signal.SIGTERM, restore)

    song_id, lyr, last_draw = None, None, None
    pos_at, pos_time = 0.0, time.monotonic()
    next_poll = 0.0
    song = None
    while True:
        now = time.monotonic()
        if now >= next_poll:
            song = nowplaying.current()
            next_poll = now + 1.0
            if song:
                pos_at, pos_time = song["position"], now
                if song["id"] != song_id:
                    song_id = song["id"]
                    draw([header(song), "", f"{SOFT}Looking up the lyrics…{N}"])
                    lyr = fetch(song)
                    last_draw = None
        # between polls, move the position on smoothly
        pos = pos_at + (time.monotonic() - pos_time if song and song["status"] == "Playing" else 0)
        frame = build(song, lyr, pos)
        if frame != last_draw:
            draw(frame)
            last_draw = frame
        time.sleep(0.15)


def build(song, lyr, pos):
    if not song:
        return [no_song(), "", f"{D}Waiting for a song…  (Ctrl+C to stop){N}"]
    cols, rows = shutil.get_terminal_size((80, 24))
    top = [header(song), ""]
    if lyr is None:
        return top + [f"{SOFT}Couldn't reach the lyrics site. Check your internet.{N}"]
    if lyr["instrumental"]:
        return top + [f"{SOFT}(Instrumental: no words){N}"]
    if not lyr["synced"]:
        if lyr["plain"]:
            body = lyr["plain"].splitlines()[: max(1, rows - 4)]
            return top + body + ["", f"{D}(These lyrics don't have timing, so they don't follow along){N}"]
        return top + [f"{SOFT}No lyrics found for this song.{N}"]
    lines = lyr["synced"]
    cur = -1
    for i, (t, _w) in enumerate(lines):
        if t <= pos + 0.25:
            cur = i
    room = max(3, rows - len(top) - 1)
    start = max(0, min(cur - room // 3, len(lines) - room))
    out = list(top)
    for i in range(start, min(len(lines), start + room)):
        words = lines[i][1] or "♪"
        words = words[: cols - 2]
        if i == cur:
            out.append(f"{B}{ACCENT}{words}{N}")
        elif i < cur:
            out.append(f"{D}{words}{N}")
        else:
            out.append(f"{SOFT}{words}{N}")
    return out


def draw(lines):
    sys.stdout.write("\033[H\033[2J" + "\n".join(lines))
    sys.stdout.flush()


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if args and args[0] == "--prefetch":      # used by the Now playing widget: look up and keep, print nothing
        song = nowplaying.current()
        if song:
            lyricslib.fetch(song)
        return 0
    if (args and args[0] == "--once") or not sys.stdout.isatty():
        return once()
    live()


if __name__ == "__main__":
    sys.exit(main())
