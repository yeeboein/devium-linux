#!/usr/bin/env python3
"""Devium loading screen: covers the desktop right after you log in, until the desktop and your
startup apps have loaded, then fades away smoothly. It looks like the login screen, so going from
login to desktop feels like one smooth step.

Started first thing at login (KDE autostart phase 0, Xfce autostart, Hyprland exec-once).
It never stays longer than 20 seconds, and a click or Esc closes it straight away.
  devium-loading            run it
  devium-loading --test     show it for 4 seconds (to see how it looks)
"""
import math
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/devium")

from PyQt6.QtCore import QEasingCurve, QPointF, QPropertyAnimation, QRectF, Qt, QTimer, pyqtProperty
from PyQt6.QtGui import QColor, QFont, QGuiApplication, QLinearGradient, QPainter, QPen, QPixmap
from PyQt6.QtWidgets import QApplication, QWidget

BG = "/usr/share/sddm/themes/devium/background.jpg"
LOGO = "/usr/share/devium/logo-white.png"
MIN_SECONDS = 1.6       # always show it at least this long (no flash)
MAX_SECONDS = 20        # never longer than this
ACCENT = "#8fb4d8"
try:
    _a = open(os.path.expanduser("~/.config/devium/accent")).read().split()
    if _a and _a[0].startswith("#") and len(_a[0]) == 7:
        ACCENT = _a[0]
except OSError:
    pass


def running(name):
    return subprocess.run(["pgrep", "-x", "-u", str(os.getuid()), name], stdout=subprocess.DEVNULL).returncode == 0


def desktop_up():
    """Is the desktop itself there yet?"""
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return running("waybar") or running("hyprpaper")
    if shutil.which("plasmashell"):
        if not running("plasmashell"):
            return False
        q = shutil.which("qdbus6") or shutil.which("qdbus")
        if not q:
            return True
        return subprocess.run([q, "org.kde.plasmashell", "/PlasmaShell"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=2).returncode == 0
    if shutil.which("xfce4-panel"):
        return running("xfce4-panel") and (running("xfdesktop") or not shutil.which("xfdesktop"))
    return True


def cpu_sample():
    f = [int(x) for x in open("/proc/stat").readline().split()[1:]]
    return sum(f), f[3] + (f[4] if len(f) > 4 else 0)


def first_name():
    try:
        gecos = subprocess.run(["getent", "passwd", str(os.getuid())], capture_output=True, text=True).stdout.split(":")[4]
        full = gecos.split(",")[0].strip()
        return (full.split()[0] if full else os.environ.get("USER", "")).capitalize()
    except Exception:
        return os.environ.get("USER", "").capitalize()


class Loading(QWidget):
    def __init__(self, test=False):
        super().__init__()
        self.test = test
        self._fade = 1.0          # 1 = fully shown, 0 = gone
        self.spin = 0.0
        self.started = time.time()
        self.calm = 0             # how many checks in a row the computer has been calm
        self.last_cpu = cpu_sample()
        self.name = first_name()
        self.setWindowTitle("Devium")
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint
                            | Qt.WindowType.Tool)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setCursor(Qt.CursorShape.BusyCursor)
        self.bg = QPixmap(BG)
        self.logo = QPixmap(LOGO)
        self.tick = QTimer(self)
        self.tick.timeout.connect(self.animate)
        self.tick.start(16)                     # ~60 fps spinner
        self.check = QTimer(self)
        self.check.timeout.connect(self.ready_yet)
        self.check.start(400)
        self.anim = None

    # ---- fade property (animated) ---------------------------------------------------------
    def get_fade(self):
        return self._fade

    def set_fade(self, v):
        self._fade = v
        self.update()

    fade = pyqtProperty(float, get_fade, set_fade)

    def animate(self):
        self.spin = (self.spin + 4.5) % 360
        self.update()

    def ready_yet(self):
        age = time.time() - self.started
        if self.anim:
            return
        if age > MAX_SECONDS or (self.test and age > 4):
            return self.finish()
        if age < MIN_SECONDS or not desktop_up():
            self.last_cpu = cpu_sample()
            return
        # the desktop is up: wait until the startup rush (apps opening, files indexing) calms down
        t, i = cpu_sample()
        t0, i0 = self.last_cpu
        self.last_cpu = (t, i)
        busy = 0 if t == t0 else 1 - (i - i0) / (t - t0)
        self.calm = self.calm + 1 if busy < 0.45 else 0
        if self.calm >= 3:
            self.finish()

    def finish(self):
        self.check.stop()
        self.setCursor(Qt.CursorShape.ArrowCursor)
        self.anim = QPropertyAnimation(self, b"fade", self)
        self.anim.setDuration(750)
        self.anim.setStartValue(self._fade)
        self.anim.setEndValue(0.0)
        self.anim.setEasingCurve(QEasingCurve.Type.InOutCubic)
        self.anim.finished.connect(QApplication.instance().quit)
        self.anim.start()

    def mousePressEvent(self, _e):
        self.finish()

    def keyPressEvent(self, e):
        if e.key() in (Qt.Key.Key_Escape, Qt.Key.Key_Space, Qt.Key.Key_Return):
            self.finish()

    # ---- drawing ----------------------------------------------------------------------------
    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.SmoothPixmapTransform)
        a = self._fade
        w, h = self.width(), self.height()
        # the background fades out a bit faster than the logo, so the desktop shows through first
        bg_a = max(0.0, min(1.0, a * 1.15))
        p.setOpacity(bg_a)
        if not self.bg.isNull():
            s = self.bg.scaled(w, h, Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                               Qt.TransformationMode.SmoothTransformation)
            p.drawPixmap((w - s.width()) // 2, (h - s.height()) // 2, s)
        else:
            p.fillRect(self.rect(), QColor("#2b323b"))
        g = QLinearGradient(0, 0, 0, h)
        g.setColorAt(0, QColor(20, 26, 34, 150))
        g.setColorAt(1, QColor(20, 26, 34, 215))
        p.fillRect(self.rect(), g)

        # logo: grows a little and fades as the screen goes away
        p.setOpacity(a)
        grow = 1 + (1 - a) * 0.25
        size = int(min(w, h) * 0.11 * grow)
        cx, cy = w / 2, h * 0.44
        if not self.logo.isNull():
            lg = self.logo.scaled(size, size, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
            p.drawPixmap(int(cx - lg.width() / 2), int(cy - lg.height() / 2), lg)
        # spinner: an accent arc going round the logo
        r = size * 0.95
        rect = QRectF(cx - r, cy - r, 2 * r, 2 * r)
        pen = QPen(QColor(255, 255, 255, 40), max(3, size * 0.035))
        pen.setCapStyle(Qt.PenCapStyle.RoundCap)
        p.setPen(pen)
        p.drawEllipse(rect)
        pen.setColor(QColor(ACCENT))
        p.setPen(pen)
        span = 70 + 50 * math.sin(math.radians(self.spin * 2))
        p.drawArc(rect, int(-self.spin * 16), int(span * 16))
        # text
        p.setPen(QColor("#eef2f7"))
        f = QFont("Noto Sans")
        f.setPixelSize(max(18, int(h * 0.028)))
        f.setWeight(QFont.Weight.DemiBold)
        p.setFont(f)
        hello = f"Welcome, {self.name}" if self.name else "Welcome"
        p.drawText(QRectF(0, cy + r + h * 0.04, w, h * 0.05), Qt.AlignmentFlag.AlignHCenter, hello)
        f.setPixelSize(max(13, int(h * 0.017)))
        f.setWeight(QFont.Weight.Normal)
        p.setFont(f)
        p.setPen(QColor("#c4ccd6"))
        dots = "." * (1 + int(time.time() * 2) % 3)
        p.drawText(QRectF(0, cy + r + h * 0.09, w, h * 0.04), Qt.AlignmentFlag.AlignHCenter,
                   "Getting your desktop ready" + dots)
        p.end()


def main():
    test = "--test" in sys.argv
    if not test and (os.path.isdir("/run/archiso") or
                     os.path.exists(os.path.expanduser("~/.config/devium/no-loading-screen"))):
        return 0
    app = QApplication(sys.argv)
    app.setApplicationName("Devium")
    app.setDesktopFileName("devium-loading")
    w = Loading(test)
    w.setGeometry(QGuiApplication.primaryScreen().geometry())
    w.showFullScreen()
    w.raise_()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
