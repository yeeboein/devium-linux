#!/usr/bin/env bash
# Switch between Devium's Beginner and Pro modes for the current user.
#   devium-mode beginner | pro | status
set -uo pipefail
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$CFG/devium"
current="$(cat "$CFG/devium/mode" 2>/dev/null || echo beginner)"
kw() { kwriteconfig6 "$@" 2>/dev/null || kwriteconfig5 "$@" 2>/dev/null || true; }

panel_height() {
    local js="panels().forEach(function(p){ if (p.location=='bottom') p.height=$1; });"
    for q in qdbus6 qdbus; do
        command -v $q >/dev/null && $q org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$js" >/dev/null 2>&1 && return
    done
}

case "${1:-status}" in
    pro)
        echo pro > "$CFG/devium/mode"
        # Dolphin: split view, terminal panel, hidden files, details view
        kw --file dolphinrc --group General --key SplitView true
        kw --file dolphinrc --group General --key GlobalViewProps true
        kw --file dolphinrc --group IconsMode --key IconSize 32
        mkdir -p ~/.local/share/dolphin/view_properties/global
        kw --file ~/.local/share/dolphin/view_properties/global/.directory --group Dolphin --key HiddenFilesShown true
        kw --file ~/.local/share/dolphin/view_properties/global/.directory --group Dolphin --key ViewMode 1
        # Windows: tiling shortcuts are built in (Meta+arrows); add quick tile on drag
        kw --file kwinrc --group Windows --key ElectricBorderTiling true
        # Quiet: no update pop-ups (run "update" or the Update Manager yourself)
        touch "$CFG/devium/no-update-notify"
        panel_height 44
        echo "Pro mode on. Open a new terminal for the Starship prompt and git aliases."
        ;;
    beginner)
        echo beginner > "$CFG/devium/mode"
        kw --file dolphinrc --group General --key SplitView false
        kw --file dolphinrc --group General --key GlobalViewProps true
        kw --file dolphinrc --group IconsMode --key IconSize 64
        mkdir -p ~/.local/share/dolphin/view_properties/global
        kw --file ~/.local/share/dolphin/view_properties/global/.directory --group Dolphin --key HiddenFilesShown false
        kw --file ~/.local/share/dolphin/view_properties/global/.directory --group Dolphin --key ViewMode 0
        rm -f "$CFG/devium/no-update-notify"
        panel_height 64
        echo "Beginner mode on."
        ;;
    status)
        echo "$current"
        ;;
    *)
        echo "usage: devium-mode beginner|pro|status"; exit 1 ;;
esac
