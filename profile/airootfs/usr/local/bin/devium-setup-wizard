#!/usr/bin/env python3
"""Devium Setup: pick your browser, editor, languages, tools and apps.
Only what you choose gets installed, so Devium stays light."""
import getpass
import json
import os
import re
import time
import shutil
import subprocess
import sys

sys.path.insert(0, "/usr/lib/devium")

from PyQt6.QtCore import QTimer, QProcess, QSize, Qt
from PyQt6.QtGui import QIcon, QPixmap
from PyQt6.QtWidgets import (QApplication, QButtonGroup, QCheckBox, QFrame, QHBoxLayout, QLabel,
                             QDialog, QListWidget, QListWidgetItem, QMessageBox, QPlainTextEdit,
                             QProgressBar, QPushButton, QRadioButton, QScrollArea, QStackedWidget,
                             QVBoxLayout, QWidget)

import devium_ui as ui
import setup_catalog as cat

CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "devium")
DONE_MARKER = os.path.join(CONFIG, "setup-done")
KDELITE = "/opt/kdelite/kdelite"
XFCE = ui.edition() == "xfce"
if XFCE:
    # Thunar and the Xfce terminal come with the Xfce edition; Dolphin/Konsole become optional.
    for page in cat.PAGES:
        if page["id"] == "filemanager":
            for it in page["items"]:
                if it["id"] == "dolphin":
                    it.update(pacman=["dolphin"], mb=80, default=False, desc="Powerful KDE file manager")
                if it["id"] == "thunar":
                    it.update(pacman=[], mb=0, default=True, desc="Light and simple")
        if page["id"] == "terminal":
            for it in page["items"]:
                if it["id"] == "konsole":
                    it.update(pacman=["konsole"], mb=40, default=False, desc="KDE's full-featured terminal")
            page["items"].insert(0, {"id": "xfceterm", "name": "Xfce Terminal", "desc": "Simple and light",
                                     "mb": 0, "exec": "xfce4-terminal", "desktop": "xfce4-terminal.desktop",
                                     "default": True})


# --------------------------------------------------------------------------- helpers
def fmt_mb(mb):
    if mb <= 0:
        return "included"
    return f"about {mb / 1024:.1f} GB" if mb >= 1000 else f"about {mb} MB"


def free_mb():
    return shutil.disk_usage("/").free // (1024 * 1024)


_INSTALLED = None


def installed(pkg):
    global _INSTALLED
    if _INSTALLED is None:
        try:
            r = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True)
            _INSTALLED = set(r.stdout.split())
        except FileNotFoundError:
            _INSTALLED = set()
    return pkg in _INSTALLED


def available_packages(names):
    """Return the subset of package names that exist in the repos (one pacman call)."""
    if not names:
        return set()
    try:
        r = subprocess.run(["pacman", "-Si", *sorted(names)], capture_output=True, text=True)
    except FileNotFoundError:
        return set()
    return set(re.findall(r"^Name\s*:\s*(\S+)", r.stdout, re.M))


def current_scheme():
    import configparser
    c = configparser.ConfigParser(strict=False, interpolation=None)
    c.read([os.path.expanduser("~/.config/kdeglobals")])
    return c.get("General", "ColorScheme", fallback="")


def ram_gb():
    try:
        for line in open("/proc/meminfo"):
            if line.startswith("MemTotal:"):
                return int(line.split()[1]) / 1024 / 1024
    except OSError:
        pass
    return 8


_FLATPAKS = None


def flatpak_installed(app):
    global _FLATPAKS
    if _FLATPAKS is None:
        try:
            out = subprocess.run(["flatpak", "list", "--app", "--columns=application"],
                                 capture_output=True, text=True, timeout=10).stdout
            _FLATPAKS = set(out.split())
        except Exception:
            _FLATPAKS = set()
    return app in _FLATPAKS


def base_packages():
    """Packages every Devium install has: never removed by Devium Setup."""
    try:
        return {l.strip() for l in open("/usr/share/devium/install-packages.txt") if l.strip()}
    except OSError:
        return set()


def label(text, obj=None, wrap=True):
    l = QLabel(text)
    l.setWordWrap(wrap)
    if obj:
        l.setObjectName(obj)
    return l


def scroll(inner):
    s = QScrollArea()
    s.setWidgetResizable(True)
    s.setFrameShape(QFrame.Shape.NoFrame)
    s.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
    s.setWidget(inner)
    return s


# --------------------------------------------------------------------------- wizard
class Wizard(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Devium Setup")
        self.setWindowIcon(ui.app_icon())
        self.resize(960, 720)
        # Opened again on an installed Devium: "Let's configure your Devium", ticks what's there
        self.reconfig = os.path.exists(DONE_MARKER) and not ui.is_live()
        self.inputs = {}       # item id -> QCheckBox / QRadioButton
        self.was_installed = set()   # items already installed when Devium Setup opened
        self.items = {}        # item id -> item dict
        self.queue = []

        # Hide items whose repo packages don't exist (e.g. renamed upstream).
        all_pkgs = {p for page in cat.PAGES for it in page["items"] for p in it.get("pacman", [])}
        self.avail = available_packages(all_pkgs) or all_pkgs   # offline: show everything

        root = QHBoxLayout(self)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)

        # left: list of steps
        side = QWidget()
        side.setFixedWidth(250)
        sl = QVBoxLayout(side)
        sl.setContentsMargins(12, 16, 6, 12)
        sl.addWidget(ui.header("Setup", "", size=36))
        self.steps = QListWidget()
        self.steps.setObjectName("nav")
        self.steps.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.steps.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.steps.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAsNeeded)
        self.steps.setStyleSheet("QListWidget#nav::item { padding: 6px 12px; margin: 0px 4px; }"
                                 "QScrollBar:vertical { background: transparent; width: 8px; }"
                                 "QScrollBar::handle:vertical { background: #3b4450; border-radius: 4px; }"
                                 "QScrollBar::add-line, QScrollBar::sub-line { height: 0px; }")
        self.steps.setSelectionMode(QListWidget.SelectionMode.SingleSelection)
        self.steps.itemClicked.connect(self.step_clicked)
        sl.addWidget(self.steps, 1)
        root.addWidget(side)

        # right: pages + bottom bar
        right = QVBoxLayout()
        right.setContentsMargins(24, 18, 24, 16)
        self.stack = QStackedWidget()
        right.addWidget(self.stack, 1)

        bar = QHBoxLayout()
        self.total = QLabel()
        self.total.setObjectName("subtitle")
        self.back_btn = QPushButton("Back")
        self.skip_btn = QPushButton("Skip")
        self.next_btn = QPushButton("Next")
        self.next_btn.setObjectName("primary")
        self.back_btn.clicked.connect(lambda: self.go(self.stack.currentIndex() - 1))
        self.skip_btn.clicked.connect(self.skip)
        self.next_btn.clicked.connect(self.next)
        bar.addWidget(self.total, 1)
        bar.addWidget(self.back_btn)
        bar.addWidget(self.skip_btn)
        bar.addWidget(self.next_btn)
        right.addLayout(bar)
        root.addLayout(right, 1)

        # pages
        self.add_page("Welcome", self.welcome_page())
        for page in cat.PAGES:
            self.add_page(page["title"].split(" and ")[0].replace("Programming languages", "Languages"),
                          self.choice_page(page), page)
        self.add_page("Look and feel", self.look_page())
        self.add_page("Summary", self.summary_page())
        self.add_page("Installing", self.install_page())
        self.add_page("Done", self.done_page())
        self.go(0)

    # ------------------------------------------------------------------ layout
    def add_page(self, name, widget, page=None):
        widget.setProperty("catalog", page["id"] if page else "")
        self.stack.addWidget(widget)
        QListWidgetItem(name, self.steps)

    def go(self, i):
        i = max(0, min(i, self.stack.count() - 1))
        installing = self.stack.currentWidget() is self.install_w and self.queue
        if installing:
            return
        # skip the Python libraries page when Python isn't ticked
        w = self.stack.widget(i)
        if w.property("catalog") == "pylibs" and not self.checked("python"):
            i += 1 if i >= self.stack.currentIndex() else -1
        self.stack.setCurrentIndex(i)
        self.steps.setCurrentRow(i)
        w = self.stack.currentWidget()
        last_steps = w in (self.install_w, self.done_w)
        self.back_btn.setVisible(i > 0 and not last_steps)
        self.skip_btn.setVisible(0 < i < self.stack.count() - 3)
        self.next_btn.setVisible(not last_steps)
        self.next_btn.setText(("Update my Devium" if self.reconfig else "Install my picks") if w is self.summary_w else
                              "Let's go" if i == 0 else "Next")
        self.next_btn.setEnabled(True)
        if w is self.summary_w:
            self.fill_summary()
        self.update_total()

    def step_clicked(self, item):
        row = self.steps.row(item)
        if row <= self.stack.indexOf(self.summary_w) and self.stack.currentIndex() <= self.stack.indexOf(self.summary_w):
            self.go(row)
        else:
            self.steps.setCurrentRow(self.stack.currentIndex())

    def not_enough_space(self, needed_mb=None):
        """Tell the user there isn't enough space and send them back to the start of the wizard."""
        free = free_mb()
        need = f"about {fmt_mb(needed_mb)[6:]}" if needed_mb else "more space than is free"
        QMessageBox.warning(
            self, "Not enough space",
            f"Your picks need {need}, but only {free / 1024:.1f} GB is free on this disk "
            "(Devium keeps 1 GB spare).\n\n"
            "Pick fewer or smaller things - games and Flathub apps are the biggest - "
            "or free up space with Update Manager first.")
        self.queue = []
        self.go(0)

    def next(self):
        if self.stack.currentWidget() is self.summary_w:
            needed = self.plan()["mb"]
            if needed > free_mb() - 1024:
                return self.not_enough_space(needed)
            self.start_install()
        else:
            self.go(self.stack.currentIndex() + 1)

    def skip(self):
        """Skip = clear this page's choices (single-choice pages keep their default)."""
        page_id = self.stack.currentWidget().property("catalog")
        page = next((p for p in cat.PAGES if p["id"] == page_id), None)
        if page and not page["single"]:
            for it in page["items"]:
                if it["id"] in self.inputs:
                    self.inputs[it["id"]].setChecked(False)
        self.go(self.stack.currentIndex() + 1)

    # ------------------------------------------------------------------ pages
    def welcome_page(self):
        w = QWidget()
        l = QVBoxLayout(w)
        logo = QLabel()
        logo.setPixmap(QPixmap(ui.LOGO).scaled(120, 120, Qt.AspectRatioMode.KeepAspectRatio,
                                              Qt.TransformationMode.SmoothTransformation))
        logo.setAlignment(Qt.AlignmentFlag.AlignCenter)
        l.addStretch(1)
        l.addWidget(logo)
        t = label("Let's configure your Devium" if self.reconfig else "Welcome to Devium", "title")
        t.setAlignment(Qt.AlignmentFlag.AlignCenter)
        l.addWidget(t)
        if self.reconfig:
            intro = ("Everything you already have is ticked. Tick things to add them, untick things to remove them,\n"
                     "or change the look. Only the changes are made.\n\n")
        else:
            intro = ("Let's set up your computer. On the next pages, pick the apps and tools you want.\n"
                     "Devium only installs what you choose, so it stays fast and light.\n\n"
                     "Not sure? Just keep clicking Next: good choices are already selected.\n"
                     "You can change everything later from Devium Welcome.\n\n")
        txt = label(intro + f"Free disk space: {free_mb() / 1024:.1f} GB")
        txt.setAlignment(Qt.AlignmentFlag.AlignCenter)
        l.addWidget(txt)
        if ui.is_live():
            live = label("You're using the live version: anything installed here is gone after a restart. "
                         "Install Devium first, then run Devium Setup.")
            live.setStyleSheet("color: #f59e0b;")
            live.setAlignment(Qt.AlignmentFlag.AlignCenter)
            l.addWidget(live)
        if not shutil.which("pacman") or subprocess.run(
                ["sh", "-c", "curl -fsI -m 6 https://archlinux.org >/dev/null"]).returncode != 0:
            warn = label("No internet connection. Connect to Wi-Fi (network icon in the dock) "
                         "before installing your picks.")
            warn.setStyleSheet("color: #f59e0b;")
            warn.setAlignment(Qt.AlignmentFlag.AlignCenter)
            l.addWidget(warn)
        l.addStretch(2)
        return w

    def choice_page(self, page):
        inner = QWidget()
        l = QVBoxLayout(inner)
        l.setSpacing(6)
        l.addWidget(label(page["title"], "h2"))
        l.addWidget(label(page["intro"], "subtitle"))
        group = QButtonGroup(self) if page["single"] else None
        ram = ram_gb()
        fits = [it for it in page["items"] if it.get("min_ram") and it["min_ram"] <= ram + 0.5]
        best = max(fits, key=lambda it: it["min_ram"])["id"] if fits else None
        for it in page["items"]:
            if it.get("pacman") and not set(it["pacman"]) <= self.avail:
                continue   # not in the repos (anymore)
            if it.get("min_ram") and it["min_ram"] > ram + 0.5:
                continue   # AI model too big for this computer's memory
            self.items[it["id"]] = it
            # name and size on the button, the description on its own wrapped line underneath,
            # so long descriptions are never cut off
            box = (QRadioButton if page["single"] else QCheckBox)(f"{it['name']}   ({fmt_mb(it.get('mb', 0))})")
            already = (not page["single"] and (it.get("pacman") or it.get("flatpak"))
                       and all(installed(x) for x in it.get("pacman", []))
                       and all(flatpak_installed(x) for x in it.get("flatpak", [])))
            if already:
                # Running Devium Setup again: installed things start ticked; untick to remove them
                self.was_installed.add(it["id"])
                box.setText(box.text() + "   ✓ installed")
            box.setChecked(bool(it.get("default")) or bool(already))
            if it["id"] == best:
                box.setText(box.text() + "   ★ best fit for your RAM")
            box.setStyleSheet("padding: 4px 4px 0px 4px; font-weight: 600;")
            box.toggled.connect(self.update_total)
            if group:
                group.addButton(box)
            self.inputs[it["id"]] = box
            l.addWidget(box)
            desc = label(it["desc"], "subtitle")
            desc.setContentsMargins(30, 0, 0, 6)
            l.addWidget(desc)
        l.addStretch(1)
        return scroll(inner)

    def look_page(self):
        inner = QWidget()
        l = QVBoxLayout(inner)
        l.setSpacing(6)
        l.addWidget(label("Look and feel", "h2"))
        l.addWidget(label("Make Devium feel like yours. All of this can be changed later.", "subtitle"))

        def radios(title, options, default):
            l.addWidget(label(title, "h2"))
            g = QButtonGroup(self)
            for oid, text in options:
                r = QRadioButton(text)
                r.setChecked(oid == default)
                r.setStyleSheet("padding: 5px;")
                g.addButton(r)
                self.inputs[oid] = r
                l.addWidget(r)

        if os.path.exists(KDELITE) and not XFCE:
            # Enough memory (8 GB+): Full KDE. Less: KDE Lite. Running again: keep what they have.
            ram = ram_gb()
            lite_now = os.path.isdir(os.path.expanduser("~/.local/share/kdelite"))
            pick = ("kde-lite" if lite_now else "kde-full") if self.reconfig else \
                ("kde-full" if ram >= 7.5 else "kde-lite")
            rec = f"   (recommended for your {ram:.0f} GB of RAM)"
            radios("Desktop", [("kde-full", "Full KDE   —   everything KDE normally runs" +
                                (rec if pick == "kde-full" and not self.reconfig else "")),
                               ("kde-lite", "KDE Lite   —   switches off KDE extras you don't need, uses less RAM" +
                                (rec if pick == "kde-lite" and not self.reconfig else ""))], pick)
        scheme = current_scheme()
        radios("Brightness", [("theme-dark", "Dark"), ("theme-light", "Light")],
               "theme-light" if self.reconfig and "light" in scheme.lower() else "theme-dark")
        shell_now = os.path.basename(os.environ.get("SHELL", "zsh"))
        radios("Terminal shell", [(f"shell-{s['id']}", f"{s['name']}   —   {s['desc']}") for s in cat.SHELLS],
               f"shell-{shell_now}" if self.reconfig and any(x["id"] == shell_now for x in cat.SHELLS) else "shell-zsh")

        l.addWidget(label("Extras", "h2"))
        ap = QCheckBox(f"ArchPill   —   pill with time, music, battery; dock shows just apps "
                       f"({fmt_mb(cat.ARCHPILL['mb'])})")
        has_archpill = (os.path.exists(os.path.join(CONFIG, "archpill-wanted")) or
                        os.path.isdir(os.path.expanduser("~/archpill")))
        ap.setChecked(has_archpill if self.reconfig else True)
        ap.toggled.connect(self.update_total)
        self.inputs["archpill"] = ap
        ap.setToolTip("With ArchPill, the dock shows only the start button and your apps: "
                      "the pill shows the time, battery, sound and network instead.")
        qsbox = QCheckBox(f"Quickshell   ({fmt_mb(0 if installed('quickshell') else cat.ARCHPILL['mb'])})")
        qsbox.setToolTip("The toolkit ArchPill runs on. Ticked automatically when ArchPill is ticked.")
        qsbox.setChecked(True)
        qsbox.toggled.connect(self.update_total)
        self.inputs["quickshell"] = qsbox

        def archpill_toggled(on):
            if on:
                qsbox.setChecked(True)
            qsbox.setEnabled(not on)    # ArchPill needs it, so it can't be unticked while ArchPill is on
        ap.toggled.connect(archpill_toggled)
        archpill_toggled(ap.isChecked())
        mag = QCheckBox(f"Magnify dock   ({fmt_mb(cat.MAGNIFY['mb'])})")
        mag.setToolTip("Linux Magnify: a dock that works like the macOS dock. Icons grow smoothly under your mouse, "
                       "a dot shows open apps, icons bounce when apps start. It replaces the Devium dock while "
                       "it runs (and copies its pinned apps), and has its own settings app.")
        mag.setChecked(self.reconfig and os.path.exists(os.path.expanduser("~/.local/bin/linux-magnify")))
        mag.toggled.connect(self.update_total)
        self.inputs["magnify"] = mag
        dock = QCheckBox("Hide the dock when a window covers it")
        dock.setChecked(True)
        self.inputs["dock-hide"] = dock
        for b in (ap, qsbox, mag, dock):
            b.setStyleSheet("padding: 5px;")
            l.addWidget(b)
            if b is qsbox:
                hint = label("Needed for ArchPill (ticked automatically when ArchPill is on)", "subtitle")
                hint.setContentsMargins(30, 0, 0, 4)
                l.addWidget(hint)
            if b is mag:
                hint = label("Like the macOS dock: icons grow under your mouse.\n"
                             "Replaces the Devium dock and keeps your pinned apps.", "subtitle")
                hint.setContentsMargins(30, 0, 0, 4)
                l.addWidget(hint)

        radios("Theme", [("style-devium", "Devium   —   blue-grey, floating dock, pastel window buttons, Devium icons"),
                         ("style-deviumdark", "Devium Dark   —   the same, in a deeper, darker blue-grey"),
                         ("style-kde", "Base KDE   —   KDE's standard look and panel "
                                       "(best if you want to customise)")],
               ("style-deviumdark" if scheme == "DeviumDark" else
                "style-devium" if scheme.startswith("Devium") else "style-kde") if self.reconfig else "style-devium")
        l.addWidget(label("The Devium fastfetch logo looks the same with every theme.", "subtitle"))
        l.addWidget(self.theme_previews())
        l.addStretch(1)
        return scroll(inner)

    def theme_previews(self):
        """Clickable previews: Devium (dark), Devium (light), Devium Dark, Base KDE."""
        from PyQt6.QtWidgets import QGridLayout
        cards = [("devium", "Devium", ("style-devium", "theme-dark")),
                 ("devium-light", "Devium (light)", ("style-devium", "theme-light")),
                 ("devium-dark", "Devium Dark", ("style-deviumdark", "theme-dark")),
                 ("base-kde", "Base KDE", ("style-kde", None))]
        box = QWidget()
        grid = QGridLayout(box)
        grid.setContentsMargins(0, 8, 0, 0)
        self.preview_cards = []
        for i, (img, name, pick) in enumerate(cards):
            card = QLabel()
            pix = QPixmap(f"/usr/share/devium/previews/{img}.png")
            if not pix.isNull():
                small = pix.scaledToWidth(220, Qt.TransformationMode.SmoothTransformation)
                card.setPixmap(small)
                card.setFixedSize(small.width() + 10, small.height() + 10)   # outline hugs the picture
            card.setCursor(Qt.CursorShape.PointingHandCursor)
            card.setToolTip(f"Use {name}")
            cap = label(name, None)
            cap.setAlignment(Qt.AlignmentFlag.AlignCenter)

            def clicked(_e, pick=pick):
                self.inputs[pick[0]].setChecked(True)
                if pick[1]:
                    self.inputs[pick[1]].setChecked(True)
                self.update_previews()
            card.mousePressEvent = clicked
            grid.addWidget(card, (i // 2) * 2, i % 2)
            grid.addWidget(cap, (i // 2) * 2 + 1, i % 2)
            self.preview_cards.append((card, pick))
        for key in ("style-devium", "style-deviumdark", "style-kde", "theme-dark", "theme-light"):
            if key in self.inputs:
                self.inputs[key].toggled.connect(lambda _on: self.update_previews())
        self.update_previews()
        return box

    def update_previews(self):
        for card, (style, bright) in getattr(self, "preview_cards", []):
            on = self.checked(style) and (bright is None or self.checked(bright))
            card.setStyleSheet(f"border: 3px solid {ui.ACCENT if on else 'transparent'}; border-radius: 14px; padding: 2px;")

    def summary_page(self):
        self.summary_w = QWidget()
        l = QVBoxLayout(self.summary_w)
        l.addWidget(label("Ready to install", "h2"))
        l.addWidget(label("Here's everything you picked. Click Back to change anything.", "subtitle"))
        self.summary_text = QLabel()
        self.summary_text.setWordWrap(True)
        self.summary_text.setTextFormat(Qt.TextFormat.RichText)
        l.addWidget(scroll(self.summary_text), 1)
        return self.summary_w

    def install_page(self):
        self.install_w = QWidget()
        l = QVBoxLayout(self.install_w)
        l.addWidget(label("Updating your Devium" if self.reconfig else "Installing your picks", "h2"))
        self.install_status = label("Starting…")
        l.addWidget(self.install_status)
        self.progress = QProgressBar()
        self.progress.setRange(0, 1000)
        self.progress.setFormat("%p%")
        l.addWidget(self.progress)
        # keep the bar moving gently while a step is busy but quiet (e.g. a big download)
        self.creep = QTimer(self)
        self.creep.setInterval(400)
        self.creep.timeout.connect(self.creep_tick)
        tip = label("Tip: this can take a while on slow internet. You can keep using your computer.",
                    "subtitle")
        l.addWidget(tip)
        row = QHBoxLayout()
        self.details_btn = QPushButton("Show details")
        self.details_btn.setCheckable(True)
        self.details_btn.setFixedWidth(140)
        row.addWidget(self.details_btn)
        row.addStretch(1)
        self.cancel_btn = QPushButton("Cancel install")
        self.cancel_btn.clicked.connect(self.cancel_install)
        row.addWidget(self.cancel_btn)
        l.addLayout(row)
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setVisible(False)
        self.log.setStyleSheet("font-family: 'JetBrains Mono', monospace; font-size: 9pt;")
        self.details_btn.toggled.connect(self.log.setVisible)
        l.addWidget(self.log, 1)
        l.addStretch(0)
        return self.install_w

    def done_page(self):
        self.done_w = QWidget()
        l = QVBoxLayout(self.done_w)
        l.addStretch(1)
        t = label("Your Devium is updated!" if self.reconfig else "Devium is ready!", "title")
        t.setAlignment(Qt.AlignmentFlag.AlignCenter)
        l.addWidget(t)
        self.done_text = label("")
        self.done_text.setAlignment(Qt.AlignmentFlag.AlignCenter)
        l.addWidget(self.done_text)
        row = QHBoxLayout()
        row.addStretch(1)
        for text, icon, cmd in [("Devium Welcome", "devium", ["devium-welcome"]),
                                ("Get more apps", "plasmadiscover", ["plasma-discover"]),
                                ("Updates", "system-software-update", ["devium-update-manager"])]:
            b = QPushButton(QIcon.fromTheme(icon), text)
            b.setIconSize(QSize(22, 22))
            b.clicked.connect(lambda _c=False, c=cmd: ui.launch(*c))
            row.addWidget(b)
        close = QPushButton("Finish")
        close.setObjectName("primary")
        close.clicked.connect(self.close)
        row.addWidget(close)
        row.addStretch(1)
        l.addLayout(row)
        l.addStretch(2)
        return self.done_w

    # ------------------------------------------------------------------ choices
    def checked(self, iid):
        b = self.inputs.get(iid)
        return bool(b and b.isChecked())

    def picked_items(self):
        out = []
        for page in cat.PAGES:
            if page["id"] == "pylibs" and not self.checked("python"):
                continue
            out += [it for it in page["items"] if self.checked(it["id"])]
        return out

    def plan(self):
        items = self.picked_items()
        pac, fl, aur, svcs, groups, ext = [], [], [], [], [], []
        mb = 0
        for it in items:
            already = (it["id"] in self.was_installed or
                       (all(installed(p) for p in it.get("pacman", []))
                        and not it.get("flatpak") and not it.get("aur") and not it.get("helper")))
            if not already:
                mb += it.get("mb", 0)
            pac += [p for p in it.get("pacman", []) if p in self.avail]
            fl += it.get("flatpak", [])
            aur += it.get("aur", [])
            svcs += it.get("services", [])
            groups += [it["group"]] if it.get("group") else []
            ext += it.get("ext", [])
        shell = next((s for s in cat.SHELLS if self.checked(f"shell-{s['id']}")), cat.SHELLS[0])
        pac += shell["pacman"]
        if shell["pacman"] and not installed(shell["pacman"][0]):
            mb += shell["mb"]
        if (self.checked("quickshell") or self.checked("archpill")) and not installed("quickshell"):
            pac += cat.ARCHPILL["pacman"]
            mb += cat.ARCHPILL["mb"]
        ai = next((it for it in items if it.get("model")), None)
        if ai:
            pac += cat.AI_EXTRAS["pacman"]
            fl += cat.AI_EXTRAS["flatpak"]
            svcs += cat.AI_EXTRAS["services"]
            mb += cat.AI_EXTRAS["mb"]
        if self.checked("magnify") and not installed("gtk4-layer-shell"):
            pac += cat.MAGNIFY["pacman"]
            mb += cat.MAGNIFY["mb"]
        # Unticked things that were installed: remove them (never Devium's base packages,
        # never packages another ticked item still needs)
        keep = base_packages() | {x for it in items for x in it.get("pacman", [])}
        rm_pac, rm_fl, freed = [], [], 0
        for iid in self.was_installed:
            if not self.checked(iid):
                it = self.items[iid]
                rm_pac += [x for x in it.get("pacman", []) if x not in keep]
                rm_fl += it.get("flatpak", [])
                freed += it.get("mb", 0)
        if aur:
            pac += ["base-devel", "git"]
        dedupe = lambda xs: list(dict.fromkeys(xs))
        return {"items": items, "pacman": dedupe(pac), "flatpak": dedupe(fl), "aur": dedupe(aur),
                "remove": dedupe(rm_pac), "remove_flatpak": dedupe(rm_fl), "freed": freed,
                "removed_items": [self.items[i]["name"] for i in self.was_installed if not self.checked(i)],
                "ai": ai,
                "services": dedupe(svcs), "groups": dedupe(groups), "ext": dedupe(ext),
                "shell": shell, "mb": mb}

    def update_total(self):
        p = self.plan()
        free = free_mb()
        txt = f"Your picks: {fmt_mb(p['mb']) if p['mb'] else 'nothing extra'}   ·   Free space: {free / 1024:.1f} GB"
        if p["mb"] > free * 0.9:
            txt += "   ·   Not enough space!"
        self.total.setText(txt)

    def fill_summary(self):
        p = self.plan()
        free = free_mb()
        rows = "".join(f"<tr><td>{it['name']}</td><td align='right'>{fmt_mb(it.get('mb', 0))}</td></tr>"
                       for it in p["items"])
        if p["removed_items"]:
            rows += "".join(f"<tr><td style='color:#e89ca0'>Remove: {n}</td><td align='right'>frees space</td></tr>"
                            for n in p["removed_items"])
        look = (["KDE Lite" if self.checked("kde-lite") else "Full KDE"]
                if os.path.exists(KDELITE) and not XFCE else []) + [("Devium Dark theme" if self.checked("style-deviumdark") else
                 ("Devium" if self.checked("style-devium") else "Base KDE") + " theme, " +
                 ("dark" if self.checked("theme-dark") else "light")),
                f"{p['shell']['name']} shell",
                "ArchPill on" if self.checked("archpill") else "ArchPill off",
                "Quickshell" if self.checked("quickshell") else "no Quickshell"]
        left = free - p["mb"]
        warn = ""
        if p["mb"] > free - 1024:
            warn = ("<p style='color:#e89ca0'><b>Not enough space.</b> Your picks need about "
                    f"{fmt_mb(p['mb'])}, but only {free / 1024:.1f} GB is free (Devium keeps 1 GB spare). "
                    "Click <b>Back</b> and untick some of the bigger items, like games or Flathub apps.</p>")
        elif left < free * 0.1 or left < 2048:
            warn = ("<p style='color:#f59e0b'><b>Warning:</b> this would leave very little free space. "
                    "Consider unticking some of the bigger items.</p>")
        self.summary_text.setText(
            f"<table cellpadding='4' width='100%'>{rows or '<tr><td>Nothing extra</td></tr>'}</table>"
            f"<p><b>Look:</b> {', '.join(look)}</p>"
            f"<p><b>Total: {fmt_mb(p['mb']) if p['mb'] else 'nothing to download'}</b>, "
            f"leaving about {max(left, 0) / 1024:.1f} GB free.</p>{warn}"
            f"<p>Click <b>{'Update my Devium' if self.reconfig else 'Install my picks'}</b>. "
            "You'll be asked for your password once.</p>")

    # ------------------------------------------------------------------ install
    def start_install(self):
        p = self.plan()
        os.makedirs(CONFIG, exist_ok=True)
        plan_file = os.path.join("/tmp", f"devium-setup-{os.getuid()}.json")
        with open(plan_file, "w") as f:
            json.dump({"user": getpass.getuser(), "pacman": p["pacman"], "flatpak": p["flatpak"],
                       "remove": p["remove"], "remove_flatpak": p["remove_flatpak"],
                       "services": p["services"], "groups": p["groups"], "shell": p["shell"]["path"]}, f)
        self.p = p
        # Each step gets a share of the bar that matches how much it downloads (MB), so the bar moves
        # at a steady speed instead of jumping from step to step.
        items = p["items"]
        model_mb = p["ai"]["mb"] if p.get("ai") else 0
        helper_mb = sum(it.get("mb", 0) for it in items if it.get("helper"))
        aur_mb = sum(it.get("mb", 0) for it in items if it.get("aur"))
        fl_mb = sum(it.get("mb", 0) for it in items if it.get("flatpak"))
        setup_mb = max(p["mb"] - model_mb - helper_mb - aur_mb, 0)
        self.pac_share = max(setup_mb - fl_mb, 1) / max(setup_mb, 1) if p["flatpak"] else 1.0
        self.n_apps = len(p["flatpak"])
        steps = []
        steps.append(("Updating packages and apps…" if self.reconfig else "Installing packages and apps…", "pkexec",
                      ["/usr/lib/devium/devium-helper", "setup", plan_file], max(setup_mb, 40), "setup"))
        for it in items:
            if it.get("helper"):
                steps.append((f"Installing {it['name']}…", "pkexec",
                              ["/usr/lib/devium/devium-helper", it["helper"]], max(it.get("mb", 0), 30), "pacman"))
        for pkg in p["aur"]:
            mb = next((it.get("mb", 50) for it in items if pkg in it.get("aur", [])), 50)
            steps.append((f"Building {pkg} from the AUR…", "bash", ["-c", self.aur_script(pkg)], mb, "build"))
            steps.append((f"Installing {pkg}…", "bash", ["-c",
                          f"pkexec /usr/lib/devium/devium-helper install-local /tmp/devium-aur/{pkg}/*.pkg.tar.zst"],
                          max(mb // 4, 10), "pacman"))
        steps.append(("Updating your settings…" if self.reconfig else "Setting up your choices…", "bash",
                      ["-c", self.user_script(p)],
                      max(model_mb, 20), "user"))
        self.total_weight = sum(st[3] for st in steps)
        self.weight_done = 0
        self.queue = steps
        self.total_steps = len(steps)
        self.go(self.stack.indexOf(self.install_w))
        self.queue = steps   # go() doesn't run while installing; keep the queue
        self.run_next()

    def aur_script(self, pkg):
        return (f"set -e; rm -rf /tmp/devium-aur/{pkg}; mkdir -p /tmp/devium-aur; cd /tmp/devium-aur; "
                f"git clone --depth 1 https://aur.archlinux.org/{pkg}.git; cd {pkg}; "
                f"makepkg --noconfirm --needed -c 2>&1 | tail -n 40")

    def user_script(self, p):
        """Everything that runs as the user (no password needed)."""
        q = lambda s: "'" + s.replace("'", "'\\''") + "'"
        lines = ["set +e"]
        chosen = {it["id"]: it for it in p["items"]}
        # default browser / file manager / terminal
        for it in p["items"]:
            if it["id"] in [x["id"] for x in cat.PAGES[0]["items"]] and it.get("desktop"):
                if it["desktop"].startswith("auto:"):   # find the desktop file the package installed
                    key = it["desktop"][5:]
                    lines.append(f"d=$(ls /usr/share/applications | grep -i {q(key)} | head -n1); "
                                 "[ -n \"$d\" ] && xdg-settings set default-web-browser \"$d\"")
                else:
                    lines.append(f"xdg-settings set default-web-browser {q(it['desktop'])}")
            if it["id"] in [x["id"] for x in cat.PAGES[1]["items"]] and it.get("desktop"):
                lines.append(f"xdg-mime default {q(it['desktop'])} inode/directory")
            if it["id"] in [x["id"] for x in cat.PAGES[2]["items"]] and it.get("exec"):
                lines.append(f"kwriteconfig6 --file kdeglobals --group General --key TerminalApplication {q(it['exec'])} 2>/dev/null")
                lines.append(f"mkdir -p ~/.config/xfce4 && printf 'TerminalEmulator=%s\\n' {q(it['exec'])} > ~/.config/xfce4/helpers.rc")
                lines.append(f"kwriteconfig6 --file kdeglobals --group General --key TerminalService {q(it['desktop'])}")
        # editor extensions for the chosen languages
        for ed in ("vscodium", "vscode"):
            if ed in chosen:
                cli = chosen[ed]["cli"]
                if ed == "vscodium":
                    lines.append("mkdir -p ~/.config/VSCodium/User && "
                                 "[ -f ~/.config/VSCodium/User/settings.json ] || "
                                 "cp /usr/share/devium/vscode-settings.json ~/.config/VSCodium/User/settings.json")
                for e in p["ext"]:
                    lines.append(f"command -v {cli} >/dev/null && {cli} --install-extension {q(e)} --force")
        if p.get("ai"):
            model = p["ai"]["model"]
            lines.append("for i in $(seq 1 30); do curl -fs http://127.0.0.1:11434 >/dev/null && break; sleep 1; done")
            lines.append(f"command -v ollama >/dev/null && ollama pull {q(model)}")
        if "rust" in chosen:
            lines.append("command -v rustup >/dev/null && rustup default stable")
        # dock: swap Konsole / Dolphin launchers for the chosen apps, add the editor, dock auto-hide
        launchers = ["preferred://filemanager", "preferred://browser"]
        term = next((it for it in p["items"] if it["id"] in [x["id"] for x in cat.PAGES[2]["items"]]), None)
        launchers.append(f"applications:{term['desktop'] if term else 'org.kde.konsole.desktop'}")
        for ed in ("vscodium", "vscode"):
            if ed in chosen:
                launchers.append(f"applications:{chosen[ed]['desktop']}")
        launchers += ["applications:org.kde.kate.desktop", "applications:devium-snip.desktop",
                      "applications:org.kde.discover.desktop", "applications:devium-welcome.desktop"]
        hiding = "dodgewindows" if self.checked("dock-hide") else "none"
        # Devium themes: a big floating dock in the middle that is exactly as wide as its icons.
        # Base KDE: KDE's normal full-width panel.
        if self.checked("style-kde"):
            dock_js = ("p.floating=false; p.alignment='left'; p.lengthMode='fill';"
                       "p.height=2*Math.ceil(gridUnit*2.2/2);")
        else:
            dock_js = ("p.floating=true; p.alignment='center'; p.lengthMode='fit';"
                       "p.height=2*Math.ceil(gridUnit*3.4/2);")
        # With ArchPill the pill shows time, battery, sound and network, so the dock keeps only
        # the start button and app icons. Without ArchPill the dock keeps its tray and clock.
        extras = ["org.kde.plasma.marginsseparator", "org.kde.plasma.systemtray", "org.kde.plasma.digitalclock"]
        if self.checked("archpill"):
            tray_js = ("p.widgets().forEach(function(w){ if (" +
                       " || ".join(f"w.type=='{t}'" for t in extras) + ") w.remove(); });")
        else:
            tray_js = "".join(f"if (p.widgets('{t}').length==0) p.addWidget('{t}');" for t in extras)
        js = ("panels().forEach(function(p){ if (p.location!='bottom') return; p.hiding='" + hiding + "';" + dock_js +
              "p.widgets('org.kde.plasma.panelspacer').forEach(function(w){ w.remove(); });"
              "p.widgets('org.kde.plasma.icontasks').forEach(function(w){ w.currentConfigGroup=['General'];"
              "w.writeConfig('launchers','" + ",".join(launchers) + "'); w.reloadConfig(); });"
              + tray_js + " });")
        lines.append(f"(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript {q(js)} "
                     f"|| qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript {q(js)}) >/dev/null 2>&1")
        # theme (the Devium themes come with the big floating dock; Base KDE gets KDE's normal panel)
        light = self.checked("theme-light")
        if self.checked("style-kde"):
            # KDE's stock Breeze: the easiest starting point for your own customising
            scheme = "BreezeLight" if light else "BreezeDark"
            lines.append("kwriteconfig6 --file konsolerc --group 'Desktop Entry' --key DefaultProfile ''")
            lines.append("kwriteconfig6 --file kdeglobals --group General --key AccentColor 61,174,233")
        elif self.checked("style-deviumdark"):
            light = False
            scheme = "DeviumDark"
            lines.append("kwriteconfig6 --file konsolerc --group 'Desktop Entry' --key DefaultProfile DeviumDark.profile")
        else:
            scheme = "DeviumLight" if light else "Devium"
            lines.append("kwriteconfig6 --file konsolerc --group 'Desktop Entry' --key DefaultProfile Devium.profile")
        # fastfetch keeps its own colours (/etc/xdg/fastfetch), so it looks the same with every theme
        if XFCE:
            gtk = "Adwaita" if (self.checked("style-kde") or light) else "Adwaita-dark"
            icons = "Adwaita" if self.checked("style-kde") else ("Papirus-Light" if light else "Papirus-Dark")
            lines.append(f"xfconf-query -c xsettings -p /Net/ThemeName -s {gtk}; "
                         f"xfconf-query -c xsettings -p /Net/IconThemeName -s {icons}; "
                         "xfconf-query -c xfwm4 -p /general/theme -s Default")
        lines.append(f"plasma-apply-colorscheme {scheme}; "
                     f"plasma-apply-desktoptheme {'breeze-light' if light else 'breeze-dark'}")
        # Icons: the Devium themes get the Devium icon pack (gradient rounded squares, white logos);
        # Base KDE gets KDE's own Breeze icons.
        if self.checked("style-kde"):
            icon_theme = "breeze" if light else "breeze-dark"
        else:
            icon_theme = "Devium" if light else "Devium-Dark"
        # Window buttons: Devium themes get pastel macOS-style round buttons on the left
        # (close, minimise, maximise); Base KDE keeps KDE's Breeze buttons on the right.
        if not XFCE:
            kw = "kwriteconfig6 --file kwinrc --group org.kde.kdecoration2"
            if self.checked("style-kde"):
                lines.append(f"{kw} --key library org.kde.breeze; {kw} --key theme Breeze; "
                             f"{kw} --key ButtonsOnLeft M; {kw} --key ButtonsOnRight IAX")
            else:
                deco = "Devium-Light" if light else "Devium"
                lines.append(f"{kw} --key library org.kde.kwin.aurorae; {kw} --key theme __aurorae__svg__{deco}; "
                             f"{kw} --key ButtonsOnLeft XIA; {kw} --key ButtonsOnRight ''")
            lines.append("qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1")
        if XFCE:
            lines.append(f"xfconf-query -c xsettings -p /Net/IconThemeName -s {icon_theme if not self.checked('style-kde') else ('Adwaita')}")
        else:
            lines.append(f"/usr/lib/plasma-changeicons {icon_theme} 2>/dev/null || "
                         f"kwriteconfig6 --notify --file kdeglobals --group Icons --key Theme {icon_theme}")
        # KDE Lite / Full KDE (KDElite only changes your own settings and can be undone)
        if self.checked("kde-lite"):
            lines.append(f"bash {KDELITE} apply")
        elif self.checked("kde-full"):
            lines.append(f"[ -d ~/.local/share/kdelite ] && bash {KDELITE} revert")
        lines.append(f"mkdir -p {q(CONFIG)} && touch {q(os.path.join(CONFIG, 'shell-chosen'))}")
        # ArchPill
        if self.checked("archpill"):
            lines.append(f"touch {q(os.path.join(CONFIG, 'archpill-wanted'))}")
            lines.append("command -v qs >/dev/null || pkexec /usr/lib/devium/devium-helper archpill-deps")
            lines.append("if command -v qs >/dev/null && [ -d /opt/archpill ]; then "
                         "[ -d ~/archpill ] || cp -r /opt/archpill ~/archpill; "
                         "(cd ~/archpill && ./install.sh --no-packages); fi")
            # ArchPill shows notifications and the volume bar, so Plasma's own popups are switched off
            # (with ArchPill the dock has no system tray, so Plasma lets go of notifications)
            lines.append("kwriteconfig6 --notify --file plasmaparc --group General --key VolumeOsd false")
            lines.append("kwriteconfig6 --notify --file plasmaparc --group General --key MuteOsd false")
            lines.append("mkdir -p ~/.config/archpill && touch ~/.config/archpill/.plasma-notifications-off")
            # Devium shows its own ArchPill tour, so skip ArchPill's built-in one (only on a fresh config)
            lines.append("[ -f ~/.config/archpill/config.json ] || "
                         "echo '{\"setup\": {\"done\": true}}' > ~/.config/archpill/config.json")
        else:
            lines.append(f"rm -f {q(os.path.join(CONFIG, 'archpill-wanted'))}")
            lines.append("[ -x ~/archpill/uninstall.sh ] && ~/archpill/uninstall.sh")
            lines.append("kwriteconfig6 --notify --file plasmaparc --group General --key VolumeOsd true")
            lines.append("kwriteconfig6 --notify --file plasmaparc --group General --key MuteOsd true")
        # Linux Magnify last, so it copies the finished dock (pinned apps, start icon, hide setting)
        if self.checked("magnify"):
            lines.append("if [ -d /opt/linux-magnify ]; then rm -rf ~/.cache/linux-magnify-src && "
                         "cp -r /opt/linux-magnify ~/.cache/linux-magnify-src && "
                         "(cd ~/.cache/linux-magnify-src && yes | ./install.sh); fi")
            lines.append("pgrep -f linux-magnify >/dev/null || "
                         "(PATH=$HOME/.local/bin:$PATH setsid linux-magnify >/dev/null 2>&1 &)")
        elif self.reconfig and os.path.exists(os.path.expanduser("~/.local/bin/linux-magnify")):
            # unticked: stop it and give the dock back
            lines.append("pkill -f linux-magnify; ~/.local/bin/linux-magnify --restore-panels >/dev/null 2>&1; "
                         "rm -f ~/.config/autostart/linux-magnify.desktop")
        lines.append(f"mkdir -p {q(CONFIG)} && touch {q(DONE_MARKER)}")
        return "\n".join(lines)

    def cancel_install(self):
        r = QMessageBox.question(
            self, "Cancel install?",
            "Stop installing your picks?\n\nAnything already installed stays on your computer - "
            "you can remove it later by running Devium Setup again.")
        if r != QMessageBox.StandardButton.Yes:
            return
        self.cancelled = True
        self.queue = []
        self.cancel_btn.setEnabled(False)
        self.install_status.setText("Cancelling…")
        proc = getattr(self, "proc", None)
        if proc and proc.state() != QProcess.ProcessState.NotRunning:
            if proc.program() == "pkexec":
                # pacman/flatpak run as root: ask the helper to stop them cleanly (no password needed
                # again right after the first prompt)
                QProcess.startDetached("pkexec", ["/usr/lib/devium/devium-helper", "cancel"])
            else:
                proc.terminate()

    def run_next(self):
        if getattr(self, "cancelled", False):
            return self.after_cancel()
        if not self.queue:
            return self.finished()
        lbl, prog, args, weight, kind = self.queue.pop(0)
        done = self.total_steps - len(self.queue) - 1
        self.cur = {"weight": weight, "kind": kind, "sub": 0.0, "seg": None, "pkgs": 0, "dl": 0,
                    "chk": 0.0, "inst": 0.0, "app": 0, "pct": 0.0, "last": time.monotonic()}
        self.show_progress()
        self.creep.start()
        self.install_status.setText(f"{lbl}   (step {done + 1} of {self.total_steps})")
        self.log.appendPlainText(f"\n$ {prog} {' '.join(args)[:200]}")
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.read_out)
        self.proc.finished.connect(self.step_done)
        self.proc.start(prog, args)

    def read_out(self):
        text = bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        self.log.insertPlainText(text)
        self.log.ensureCursorVisible()
        m = re.findall(r"\((\d+)/(\d+)\) (?:installing|upgrading|reinstalling)", text)
        if m:
            self.install_status.setText(self.install_status.text().split("   (")[0] +
                                        f"   (package {m[-1][0]} of {m[-1][1]})")
        self.parse_progress(text)

    # ------------------------------------------------------------------ progress bar
    def parse_progress(self, text):
        """Work out how far the current step is from what pacman, flatpak and ollama print."""
        c = getattr(self, "cur", None)
        if not c:
            return
        for line in text.splitlines():
            if line.startswith("### Installing") and "packages" in line:
                c["seg"] = "pacman"
            elif line.startswith("### Installing") and "Flathub" in line:
                c["seg"] = "flatpak"
            elif line.startswith("### App "):
                mm = re.match(r"### App (\d+) of (\d+)", line)
                if mm:
                    c["app"], c["pct"] = int(mm.group(1)) - 1, 0.0
            mm = re.search(r"Packages \((\d+)\)", line)
            if mm:
                c["pkgs"] = int(mm.group(1))
            if "downloading..." in line:
                c["dl"] += 1
            mm = re.search(r"\((\d+)/(\d+)\) (checking|loading)", line)
            if mm:
                c["chk"] = int(mm.group(1)) / max(int(mm.group(2)), 1)
            mm = re.search(r"\((\d+)/(\d+)\) (?:installing|upgrading|reinstalling)", line)
            if mm:
                c["inst"] = int(mm.group(1)) / max(int(mm.group(2)), 1)
                c["chk"] = 1.0
            for pct in re.findall(r"(\d{1,3})%", line):
                c["pct"] = max(c["pct"], min(int(pct), 100) / 100)
        dl = min(c["dl"] / c["pkgs"], 1.0) if c["pkgs"] else 0.0
        pac = 0.5 * dl + 0.1 * c["chk"] + 0.4 * c["inst"]
        if c["kind"] == "setup":
            if c["seg"] == "flatpak" and self.n_apps:
                apps = (c["app"] + c["pct"]) / self.n_apps
                frac = self.pac_share + (1 - self.pac_share) * apps
            else:
                frac = self.pac_share * pac
        elif c["kind"] == "pacman":
            frac = pac
        elif c["kind"] == "user":
            frac = c["pct"]   # ollama pull prints percentages
        else:
            frac = 0.0
        if frac > c["sub"]:
            c["sub"] = min(frac, 0.99)
            c["last"] = time.monotonic()
            self.show_progress()

    def creep_tick(self):
        c = getattr(self, "cur", None)
        if c and time.monotonic() - c["last"] > 2 and c["sub"] < 0.95:
            c["sub"] += (0.95 - c["sub"]) * 0.006
            self.show_progress()

    def show_progress(self):
        c = getattr(self, "cur", None)
        done = self.weight_done + (c["sub"] * c["weight"] if c else 0)
        self.progress.setValue(int(1000 * done / max(self.total_weight, 1)))

    def after_cancel(self):
        self.cancelled = False
        self.cancel_btn.setEnabled(True)
        QMessageBox.information(self, "Install cancelled",
                                "Installing was cancelled. You're back at the start of Devium Setup: "
                                "pick again whenever you like.")
        self.go(0)

    def step_done(self, code, _status):
        if getattr(self, "cur", None):
            self.weight_done += self.cur["weight"]
            self.cur = None
        self.creep.stop()
        if getattr(self, "cancelled", False):
            return self.after_cancel()
        # pacman ran out of disk space part-way: say so and start over
        recent = self.log.toPlainText()[-4000:]
        if code != 0 and ("not enough free disk space" in recent or "No space left on device" in recent):
            self.cancelled = False
            return self.not_enough_space()
        if code in (126, 127) and self.proc.program() == "pkexec":
            self.queue = []
            QMessageBox.information(self, "Cancelled", "Nothing was installed. You can run Devium Setup "
                                    "again any time from Devium Welcome.")
            self.go(self.stack.indexOf(self.summary_w))
            return
        if code != 0:
            self.failed = getattr(self, "failed", 0) + 1
            self.log.appendPlainText(f"\n(step finished with code {code}, continuing)")
        self.run_next()

    def finished(self):
        self.creep.stop()
        self.progress.setValue(1000)
        ui.style_app(QApplication.instance())   # follow the theme the user just picked (dark/light)
        msg = "Everything you picked is installed."
        if getattr(self, "failed", 0):
            msg = ("Most things are installed, but some steps had problems.\n"
                   "Click Show details on the previous page, or try again later from Devium Welcome.")
        if self.p["groups"] or self.p["shell"]["id"] != "zsh":
            msg += "\n\nLog out and back in to finish (for your new shell / Docker access)."
        self.done_text.setText(msg)
        self.go(self.stack.indexOf(self.done_w))
        QTimer.singleShot(400, self.after_finish)

    def after_finish(self):
        if self.checked("archpill") and shutil.which("qs"):
            if not os.path.exists(os.path.join(CONFIG, "archpill-tour-done")):
                ArchPillTour(self).exec()
                open(os.path.join(CONFIG, "archpill-tour-done"), "w").close()
            subprocess.Popen(["sh", "-c", "pgrep -f 'qs -c archpill' >/dev/null || "
                              "QS_APP_ID=archpill setsid qs -c archpill -n -d >/dev/null 2>&1"],
                             start_new_session=True)
        box = QMessageBox(self)
        box.setWindowTitle("Restart recommended")
        box.setIcon(QMessageBox.Icon.Information)
        box.setText("<b>We recommend a restart to get everything moving!</b>")
        box.setInformativeText("New apps, your shell, the dock and ArchPill all start fresh after a restart.")
        restart = box.addButton("Restart now", QMessageBox.ButtonRole.AcceptRole)
        box.addButton("Ignore", QMessageBox.ButtonRole.RejectRole)
        box.exec()
        if box.clickedButton() is restart:
            subprocess.Popen(["systemctl", "reboot"])

    def closeEvent(self, ev):
        if self.queue or (getattr(self, "proc", None) and self.proc.state() != QProcess.ProcessState.NotRunning):
            ev.ignore()
            self.cancel_install()
            return
        # Closing early still counts as "seen", so it doesn't pop up at every login.
        os.makedirs(CONFIG, exist_ok=True)
        open(os.path.join(CONFIG, "setup-seen"), "w").close()
        ev.accept()


class ArchPillTour(QDialog):
    """A short, skippable showcase of ArchPill. ArchPill starts when it closes."""
    SHOTS = "/opt/archpill/docs/screenshots"
    PAGES = [
        ("pill.png", "Meet ArchPill",
         "The pill at the top of your screen shows the time, your music, volume and battery at a glance."),
        ("control-centre.png", "Click it for the control centre",
         "Like on a phone: Wi-Fi, Bluetooth, volume, brightness, night light and more, all in one place."),
        ("music.png", "Your music",
         "When something plays, the pill shows it. Hover to see the song; click for play, pause and skip."),
        ("volume.png", "Volume and notifications",
         "Change the volume and the pill shows a volume bar. Notifications appear in the pill too."),
        ("settings.png", "Make it yours",
         "Right-click the pill for ArchPill Settings: position, size, colours, what it shows and more."),
    ]

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("ArchPill tour")
        self.resize(640, 520)
        self.i = 0
        l = QVBoxLayout(self)
        self.img = QLabel()
        self.img.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.img.setMinimumHeight(300)
        self.title = label("", "title")
        self.title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.text = label("")
        self.text.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.count = label("", "subtitle")
        self.count.setAlignment(Qt.AlignmentFlag.AlignCenter)
        l.addWidget(self.img, 1)
        l.addWidget(self.title)
        l.addWidget(self.text)
        l.addWidget(self.count)
        row = QHBoxLayout()
        skip = QPushButton("Skip tour")
        skip.clicked.connect(self.accept)
        self.back = QPushButton("Back")
        self.back.clicked.connect(lambda: self.show_page(self.i - 1))
        self.nxt = QPushButton("Next")
        self.nxt.setObjectName("primary")
        self.nxt.clicked.connect(lambda: self.accept() if self.i == len(self.PAGES) - 1 else self.show_page(self.i + 1))
        row.addWidget(skip)
        row.addStretch(1)
        row.addWidget(self.back)
        row.addWidget(self.nxt)
        l.addLayout(row)
        self.show_page(0)

    def show_page(self, i):
        self.i = max(0, min(i, len(self.PAGES) - 1))
        shot, title, text = self.PAGES[self.i]
        pix = QPixmap(os.path.join(self.SHOTS, shot))
        if pix.isNull():
            pix = QPixmap(ui.LOGO)
        self.img.setPixmap(pix.scaled(600, 300, Qt.AspectRatioMode.KeepAspectRatio,
                                      Qt.TransformationMode.SmoothTransformation))
        self.title.setText(title)
        self.text.setText(text)
        self.count.setText(f"{self.i + 1} of {len(self.PAGES)}")
        self.back.setEnabled(self.i > 0)
        self.nxt.setText("Start ArchPill" if self.i == len(self.PAGES) - 1 else "Next")


def main():
    if "--first-run" in sys.argv:
        # Only on installed systems, only once.
        if ui.is_live() or os.path.exists(DONE_MARKER) or os.path.exists(os.path.join(CONFIG, "setup-seen")):
            return
    app = QApplication(sys.argv)
    app.setApplicationName("Devium Setup")
    app.setDesktopFileName("devium-setup-wizard")
    ui.style_app(app)
    w = Wizard()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
