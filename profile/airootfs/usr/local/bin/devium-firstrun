#!/usr/bin/env bash
# Runs at every Plasma login (from /etc/xdg/autostart) but only does work once per user.
#  - installs ArchPill for this user (from /opt/archpill)
#  - sets up VS Code (Python extension, theme, formatter)

set -uo pipefail

STATE="${XDG_CONFIG_HOME:-$HOME/.config}/devium"
mkdir -p "$STATE"
LOG="$STATE/firstrun.log"
exec >>"$LOG" 2>&1
echo "=== devium-firstrun $(date)"

# --- beta10 fix: its custom window buttons didn't show up, so windows couldn't be closed.
#     Put KDE's normal title bar back (once).
if grep -q "__aurorae__svg__Devium" "${XDG_CONFIG_HOME:-$HOME/.config}/kwinrc" 2>/dev/null; then
    kw="kwriteconfig6 --file kwinrc --group org.kde.kdecoration2"
    $kw --key library org.kde.breeze; $kw --key theme Breeze
    $kw --key ButtonsOnLeft M; $kw --key ButtonsOnRight IAX
    qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
fi

# --- Low-RAM mode (turned on by the installer on computers with 4 GB or less) --
if [[ -f /etc/devium/low-ram && ! -f $STATE/low-ram-applied ]]; then
    /usr/lib/devium/lowram-user on
fi

# --- Xfce edition: Devium wallpaper and shortcuts ----------------------------
if command -v xfconf-query >/dev/null && [[ ! -f $STATE/xfce-done ]]; then
    sleep 3   # let xfdesktop create its settings
    wp=/usr/share/wallpapers/Devium/contents/images/1920x1080.jpg
    for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'last-image$'); do
        xfconf-query -c xfce4-desktop -p "$prop" -s "$wp"
    done
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image -n -t string -s "$wp" 2>/dev/null
    sc() { xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$1" -n -t string -s "$2"; }
    sc "<Super><Shift>s" "xfce4-screenshooter -r -c"
    sc "<Super>u" "devium-update-manager"
    sc "<Super>t" "devium-tools"
    sc "<Super>F1" "devium-welcome"
    sc "<Super>e" "exo-open --launch FileManager"
    sc "<Primary><Alt>t" "exo-open --launch TerminalEmulator"
    touch "$STATE/xfce-done"
fi

# --- Live ISO: a simple preview with just "Install Devium" and "About Devium" ----
if [[ -d /run/archiso ]]; then
    if [[ ! -f $STATE/live-dock-done ]]; then
        sleep 4   # let Plasma finish drawing the dock
        js="panels().forEach(function(p){ if (p.location!='bottom') return;
              p.widgets().forEach(function(w){
                if (w.type=='org.kde.plasma.kickoff') w.remove();
                if (w.type=='org.kde.plasma.icontasks') { w.currentConfigGroup=['General'];
                  w.writeConfig('launchers','applications:devium-install.desktop,applications:devium-about.desktop');
                  w.reloadConfig(); } }); });"
        for q in qdbus6 qdbus; do
            command -v $q >/dev/null && $q org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$js" && break
        done
        touch "$STATE/live-dock-done"
    fi
    # Already installed? (the computer started from the ISO / USB again after installing)
    if /usr/lib/devium/devium-installed-check; then exit 0; fi
    devium-about &
    exit 0
fi

# --- ArchPill: install Quickshell automatically if ArchPill is wanted but it's missing ---
if ! command -v qs >/dev/null && [[ ! -d /run/archiso ]] && \
   [[ -f $STATE/archpill-wanted || -d ${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/archpill || -d $HOME/archpill ]]; then
    notify-send --app-name="Devium" --icon=devium "Setting up ArchPill" \
        "Installing Quickshell, which ArchPill needs. You may be asked for your password." 2>/dev/null
    if pkexec /usr/lib/devium/devium-helper archpill-deps; then
        rm -f "$STATE/archpill-done"   # so ArchPill gets set up below
    else
        notify-send --app-name="Devium" --icon=devium "ArchPill not set up" \
            "Quickshell couldn't be installed (no internet or not enough space?). Devium will try again at the next login." 2>/dev/null
    fi
fi

# --- ArchPill ---------------------------------------------------------------
# On installed systems ArchPill is optional: the Setup wizard installs it if picked.
if [[ ! -f $STATE/archpill-done ]] && command -v qs >/dev/null; then
    if [[ ! -d /opt/archpill ]] && command -v git >/dev/null; then
        echo "ArchPill not bundled; trying to download it"
        git clone --depth 1 https://github.com/yeeboein/archpill.git "$HOME/archpill" || true
    elif [[ ! -d $HOME/archpill ]]; then
        cp -r /opt/archpill "$HOME/archpill"
    fi
    if [[ -x $HOME/archpill/install.sh ]]; then
        # Packages are already part of Devium, so skip that step.
        (cd "$HOME/archpill" && ./install.sh --no-packages) && touch "$STATE/archpill-done"
        # start it now (install.sh starts it too when it can see the desktop)
        pgrep -f 'qs -c archpill' >/dev/null || (QS_APP_ID=archpill setsid qs -c archpill -n -d >/dev/null 2>&1 &)
    fi
fi

# --- VS Code ----------------------------------------------------------------
CODE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/Code - OSS/User"
if [[ ! -f $CODE_DIR/settings.json ]]; then
    mkdir -p "$CODE_DIR"
    cp /usr/share/devium/vscode-settings.json "$CODE_DIR/settings.json"
fi
if [[ ! -f $STATE/vscode-ext-done ]] && command -v code >/dev/null; then
    (
        ok=1
        for ext in ms-python.python charliermarsh.ruff ms-python.debugpy; do
            code --install-extension "$ext" --force || ok=0
        done
        [[ $ok == 1 ]] && touch "$STATE/vscode-ext-done"
    ) &
fi

wait
