#!/usr/bin/env bash
# Runs at every Plasma login (from /etc/xdg/autostart) but only does work once per user.
#  - installs ArchPill for this user (from /opt/archpill)
#  - sets up VS Code (Python extension, theme, formatter)

set -uo pipefail

STATE="${XDG_CONFIG_HOME:-$HOME/.config}/devium"
mkdir -p "$STATE"
LOG="$STATE/firstrun.log"
exec >>"$LOG" 2>&1
echo "=== devium-firstrun $(date)"

# --- Dock safety net: if the dock's pinned apps went missing (e.g. after a hard reboot), restore them
if [[ ! -d /run/archiso && -s $STATE/dock-launchers ]] && command -v qdbus6 >/dev/null; then
    (
        sleep 8
        launchers=$(head -1 "$STATE/dock-launchers")
        js="panels().forEach(function(p){ if (p.location!='bottom') return;
              p.widgets('org.kde.plasma.icontasks').forEach(function(w){ w.currentConfigGroup=['General'];
                if (String(w.readConfig('launchers','')).length==0) {
                  w.writeConfig('launchers','$launchers'); w.reloadConfig(); } }); });"
        qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$js" >/dev/null 2>&1
    ) &
fi

# --- Dock safety net 2: Devium themes keep the start button first, apps behind it
if [[ ! -d /run/archiso && -s $STATE/dock.js ]] && command -v qdbus6 >/dev/null; then
    (
        sleep 10
        fix=$(cat "$STATE/dock.js")
        js="var wrong=false; panels().forEach(function(p){ if (p.location!='bottom') return; var ws=p.widgets(), k=-1, t=-1;
              for (var i=0; i<ws.length; i++) { if (ws[i].type=='org.kde.plasma.kickoff') k=i;
                                                 if (ws[i].type=='org.kde.plasma.icontasks') t=i; }
              if (k>=0 && t>=0 && t<k) wrong=true; });
            if (wrong) { $fix }"
        qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$js" >/dev/null 2>&1
    ) &
fi

# --- beta10 fix: its custom window buttons didn't show up, so windows couldn't be closed.
#     Put KDE's normal title bar back (once).
if grep -q "__aurorae__svg__Devium" "${XDG_CONFIG_HOME:-$HOME/.config}/kwinrc" 2>/dev/null; then
    kw="kwriteconfig6 --file kwinrc --group org.kde.kdecoration2"
    $kw --key library org.kde.breeze; $kw --key theme Breeze
    $kw --key ButtonsOnLeft M; $kw --key ButtonsOnRight IAX
    qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
fi

# --- Low-RAM mode (turned on by the installer on computers with 4 GB or less) --
if [[ -f /etc/devium/low-ram && ! -f $STATE/low-ram-applied ]]; then
    /usr/lib/devium/lowram-user on
fi

# --- Xfce edition: Devium wallpaper and shortcuts ----------------------------
if command -v xfconf-query >/dev/null && [[ ! -f $STATE/xfce-done ]]; then
    sleep 3   # let xfdesktop create its settings
    wp=/usr/share/wallpapers/Devium/contents/images/1920x1080.jpg
    for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'last-image$'); do
        xfconf-query -c xfce4-desktop -p "$prop" -s "$wp"
    done
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image -n -t string -s "$wp" 2>/dev/null
    sc() { xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$1" -n -t string -s "$2"; }
    sc "<Super><Shift>s" "xfce4-screenshooter -r -c"
    sc "<Super>u" "devium-tools updates"
    sc "<Super>t" "devium-tools"
    sc "<Super>e" "exo-open --launch FileManager"
    sc "<Primary><Alt>t" "exo-open --launch TerminalEmulator"
    touch "$STATE/xfce-done"
fi
if command -v xfconf-query >/dev/null && [[ ! -f $STATE/xfce-spotlight ]]; then   # beta15
    xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Super>space" -n -t string -s devium-spotlight
    touch "$STATE/xfce-spotlight"
fi

# --- Live ISO: a simple preview with just "Install Devium" and "About Devium" ----
if [[ -d /run/archiso ]]; then
    if [[ ! -f $STATE/live-dock-done ]]; then
        sleep 4   # let Plasma finish drawing the dock
        js="panels().forEach(function(p){ if (p.location!='bottom') return;
              p.widgets().forEach(function(w){
                if (w.type=='org.kde.plasma.kickoff') w.remove();
                if (w.type=='org.kde.plasma.icontasks') { w.currentConfigGroup=['General'];
                  w.writeConfig('launchers','applications:devium-install.desktop,applications:devium-about.desktop');
                  w.reloadConfig(); } }); });"
        for q in qdbus6 qdbus; do
            command -v $q >/dev/null && $q org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$js" && break
        done
        touch "$STATE/live-dock-done"
    fi
    # Already installed? (the computer started from the ISO / USB again after installing)
    if /usr/lib/devium/devium-installed-check; then exit 0; fi
    # First: get online (Wi-Fi), then About Devium with the Install button
    devium-wifi --then devium-about &
    exit 0
fi

# --- Guest account: say that nothing is kept
if [[ -f $STATE/guest ]]; then
    (sleep 6; notify-send --app-name="Devium" --icon=system-users "Guest session" \
        "Use Devium as you like. Everything here is deleted when you log out." 2>/dev/null) &
    exit 0
fi

# --- beta15: Meta+Space opens Devium Spotlight (KDE; new users get it from /etc/skel)
if command -v plasmashell >/dev/null && command -v kwriteconfig6 >/dev/null && [[ ! -f $STATE/spotlight-key ]]; then
    if ! grep -q "devium-spotlight.desktop" "${XDG_CONFIG_HOME:-$HOME/.config}/kglobalshortcutsrc" 2>/dev/null; then
        kwriteconfig6 --file kglobalshortcutsrc --group services --group devium-spotlight.desktop \
            --key _launch "Meta+Space"
    fi
    touch "$STATE/spotlight-key"
fi

# --- beta15: with ArchPill, brightness shows only in the pill (Plasma's own brightness popup off), once
if [[ ! -f $STATE/archpill-osd ]] && command -v plasmashell >/dev/null && \
   [[ -f $STATE/archpill-wanted || -d ${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/archpill ]]; then
    kwriteconfig6 --notify --file plasmarc --group OSD --key Enabled false
    mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/archpill" && touch "${XDG_CONFIG_HOME:-$HOME/.config}/archpill/.plasma-osd-off"
    touch "$STATE/archpill-osd"
fi

# --- beta15: secret guard on by default (stops commits containing passwords/keys); not if you set your own hooks
if [[ ! -f $STATE/git-guard ]] && command -v git >/dev/null; then
    [[ -z $(git config --global core.hooksPath) ]] && git config --global core.hooksPath /usr/lib/devium/git-hooks
    touch "$STATE/git-guard"
fi

# --- beta15: shell extras (long-command notifications, mise, zoxide, fzf) for people who had Devium before
if [[ ! -f $STATE/shell-extras ]]; then
    grep -qs "devium/shell/devium.zsh" ~/.zshrc || { [[ -f ~/.zshrc ]] && printf '\n# Devium extras\n[[ -f /usr/share/devium/shell/devium.zsh ]] && source /usr/share/devium/shell/devium.zsh\n' >> ~/.zshrc; }
    grep -qs "devium/shell/devium.bash" ~/.bashrc || { [[ -f ~/.bashrc ]] && printf '\n# Devium extras\n[[ -f /usr/share/devium/shell/devium.bash ]] && source /usr/share/devium/shell/devium.bash\n' >> ~/.bashrc; }
    touch "$STATE/shell-extras"
fi

# --- beta15: "What's new" after Devium Updater moved you to a new version (once per version)
(sleep 12; devium-whats-new --login) &

# --- beta15: warn about a failing disk (the daily health check writes /var/lib/devium/health.json)
if [[ -s /var/lib/devium/health.json && $(cat "$STATE/health-warned" 2>/dev/null) != "$(date +%F)" ]]; then
    bad=$(python3 -c 'import json; d=json.load(open("/var/lib/devium/health.json"))
print(", ".join(x.get("model") or x["name"] for x in d.get("disks", []) if not x.get("ok", True)))' 2>/dev/null)
    if [[ -n $bad ]]; then
        (sleep 20
         act=$(notify-send --app-name="Devium" --icon=dialog-warning --urgency=critical \
                 --action=open="Open Health check" "A disk may be failing" \
                 "$bad is showing signs of wear. Back up your files soon (Devium Tools > Backup and move)." 2>/dev/null)
         [[ $act == open ]] && devium-tools health) &
        date +%F > "$STATE/health-warned"
    fi
fi

# --- ArchPill: install Quickshell automatically if ArchPill is wanted but it's missing ---
if ! command -v qs >/dev/null && [[ ! -d /run/archiso ]] && \
   [[ -f $STATE/archpill-wanted || -d ${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/archpill || -d $HOME/archpill ]]; then
    notify-send --app-name="Devium" --icon=devium "Setting up ArchPill" \
        "Installing Quickshell, which ArchPill needs. You may be asked for your password." 2>/dev/null
    if pkexec /usr/lib/devium/devium-helper archpill-deps; then
        rm -f "$STATE/archpill-done"   # so ArchPill gets set up below
    else
        notify-send --app-name="Devium" --icon=devium "ArchPill not set up" \
            "Quickshell couldn't be installed (no internet or not enough space?). Devium will try again at the next login." 2>/dev/null
    fi
fi

# --- ArchPill ---------------------------------------------------------------
# On installed systems ArchPill is optional: the Setup wizard installs it if picked.
if [[ ! -f $STATE/archpill-done ]] && command -v qs >/dev/null; then
    if [[ ! -d /opt/archpill ]] && command -v git >/dev/null; then
        echo "ArchPill not bundled; trying to download it"
        git clone --depth 1 https://github.com/yeeboein/archpill.git "$HOME/archpill" || true
    elif [[ ! -d $HOME/archpill ]]; then
        cp -r /opt/archpill "$HOME/archpill"
    fi
    if [[ -x $HOME/archpill/install.sh ]]; then
        # Packages are already part of Devium, so skip that step.
        (cd "$HOME/archpill" && ./install.sh --no-packages) && touch "$STATE/archpill-done"
        # start it now (install.sh starts it too when it can see the desktop)
        pgrep -f 'qs -c archpill' >/dev/null || (QS_APP_ID=archpill setsid qs -c archpill -n -d >/dev/null 2>&1 &)
    fi
fi

# --- VS Code ----------------------------------------------------------------
CODE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/Code - OSS/User"
if [[ ! -f $CODE_DIR/settings.json ]]; then
    mkdir -p "$CODE_DIR"
    cp /usr/share/devium/vscode-settings.json "$CODE_DIR/settings.json"
fi
if [[ ! -f $STATE/vscode-ext-done ]] && command -v code >/dev/null; then
    (
        ok=1
        for ext in ms-python.python charliermarsh.ruff ms-python.debugpy; do
            code --install-extension "$ext" --force || ok=0
        done
        [[ $ok == 1 ]] && touch "$STATE/vscode-ext-done"
    ) &
fi

wait
