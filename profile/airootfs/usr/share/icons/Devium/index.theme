[Icon Theme]
Name=Devium
Comment=Devium app icons: the Devium gradient with each app's logo in white
Inherits=breeze,Papirus,Adwaita,hicolor
Example=devium
Directories=scalable/apps,scalable/places,scalable/mimetypes

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes
