// Devium boot screen: the logo breathes on a dark gradient, with three bouncing dots.
Window.SetBackgroundTopColor(0.17, 0.20, 0.23);
Window.SetBackgroundBottomColor(0.12, 0.14, 0.17);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetPosition(logo.x, logo.y, 1);

dot.image = Image("dot.png");
for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot.image);
    dots[i].SetPosition(Window.GetX() + Window.GetWidth() / 2 - 25 + i * 20,
                        logo.y + logo.image.GetHeight() + 50, 1);
}

t = 0;
fun refresh_callback() {
    t++;
    logo.sprite.SetOpacity(0.65 + 0.35 * Math.Sin(t / 25));
    for (i = 0; i < 3; i++) {
        dots[i].SetOpacity(0.3 + 0.7 * Math.Abs(Math.Sin(t / 12 - i * 0.6)));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// Password prompt (for encrypted disks)
fun display_password_callback(text, bullets) {
    s = "";
    for (i = 0; i < bullets; i++) s += "*";
    prompt.image = Image.Text(text + "  " + s, 1, 1, 1);
    prompt.sprite = Sprite(prompt.image);
    prompt.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - prompt.image.GetWidth() / 2,
                              logo.y + logo.image.GetHeight() + 90, 2);
}
fun display_normal_callback() {
    if (prompt) prompt.sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
