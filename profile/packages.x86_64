# Devium package list. One package per line; lines starting with # are ignored.
# build.sh skips (with a warning) any package that no longer exists in the repos.
#
# Installed systems don't get them: users pick them in the Devium Setup wizard.

# --- Base system & live ISO ---
base
linux
linux-firmware
sof-firmware
amd-ucode
intel-ucode
mkinitcpio
