# Devium package list. One package per line; lines starting with # are ignored.
# build.sh skips (with a warning) any package that no longer exists in the repos.
#
# Packages marked "#live" are only on the live ISO (so people can try them).
# Installed systems don't get them: users pick them in the Devium Setup wizard.

# --- Base system & live ISO ---
base
linux
linux-firmware
sof-firmware
amd-ucode
intel-ucode
mkinitcpio
mkinitcpio-archiso
syslinux
memtest86+
memtest86+-efi
edk2-shell
efibootmgr
arch-install-scripts
archinstall
sudo
nano
less
man-db
bash-completion
dosfstools
e2fsprogs
btrfs-progs
ntfs-3g
exfatprogs
cryptsetup
lvm2
usbutils
pciutils
zram-generator
pacman-contrib
reflector
pv
plymouth

