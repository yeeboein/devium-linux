edk2-shell
efibootmgr
grub
os-prober
arch-install-scripts
squashfs-tools
rsync
archinstall
sudo
nano
less
man-db #install
bash-completion
dosfstools
e2fsprogs
btrfs-progs
ntfs-3g
exfatprogs
cryptsetup
lvm2
usbutils
pciutils
zram-generator
pacman-contrib #install
reflector
pv
plymouth

